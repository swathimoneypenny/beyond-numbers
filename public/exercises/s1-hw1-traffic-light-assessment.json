  },
  "embed": {
    "format": "html",
    "selfContained": true,
    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Traffic Light Service Assessment</title>\n<style>\n/* Layout: brand gradient field; tabbed work panel left, sticky live-summary rail right */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69;\n  --green:#2F855A; --greenBg:#E8F6EE; --yellow:#D69E2E; --yellowBg:#FEF6DC; --red:#C53030; --redBg:#FDECEC;\n  --op:#718096; --opBg:#EDF2F7; --st:#3182CE; --stBg:#EBF4FF; --ca:#DD6B20; --caBg:#FEF0E3; --sg:#764BA2; --sgBg:#F3EDFA;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1360px;margin:0 auto;padding-block:20px 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:64ch;opacity:.92}\n.sample{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:10px 14px;color:var(--white);font-size:13.5px}\n.sample b{color:var(--gold)}\n.btn{border:none;border-radius:999px;padding:8px 16px;font:inherit;font-weight:700;font-size:13.5px;cursor:pointer}\n.btn:focus-visible,.tab:focus-visible,select:focus-visible,input:focus-visible,.lt:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.light{background:var(--white);color:var(--deep)}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.7)}\n.btn.primary{background:var(--purple);color:var(--white)}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.teal{background:var(--teal);color:#0E4A45}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;padding:10px;border-bottom:1px solid var(--line)}\n.tab{border:none;background:transparent;border-radius:10px;padding:8px 12px;font:inherit;font-weight:700;color:var(--mute);font-size:14px;display:flex;gap:8px;align-items:center;cursor:pointer}\n.tab .n{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--card);color:var(--deep);font-size:12px}\n.tab[aria-selected=\"true\"]{background:var(--card);color:var(--deep)}\n.tab[aria-selected=\"true\"] .n{background:var(--purple);color:var(--white)}\n.step{padding:20px 22px 24px;display:flex;flex-direction:column;gap:16px}\nh2{margin:0;font-size:21px;color:var(--purple)}\n.lead{margin:-8px 0 0;color:var(--mute);font-style:italic;max-width:72ch}\n.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:13px}\n.legend span{display:flex;align-items:center;gap:6px}\n.legend i{width:14px;height:14px;border-radius:50%;display:inline-block}\n.qgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.qbox{border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:6px;min-width:0}\n.qbox h3{margin:0;font-size:14px;letter-spacing:.08em;display:flex;justify-content:space-between;gap:8px}\n.qbox h3 small{font-weight:400;letter-spacing:0;color:var(--mute);font-size:12px}\n.qbox .sub{font-size:12px;color:var(--mute);margin-top:-4px}\n.q-operator{background:var(--opBg)}.q-operator h3{color:var(--op)}\n.q-steward{background:var(--stBg)}.q-steward h3{color:var(--st)}\n.q-catalyst{background:var(--caBg)}.q-catalyst h3{color:var(--ca)}\n.q-strategist{background:var(--sgBg)}.q-strategist h3{color:var(--sg)}\n.svc{display:flex;align-items:center;gap:8px;background:var(--white);border-radius:9px;padding:5px 8px;font-size:13.5px}\n.svc input[type=checkbox]{width:17px;height:17px;accent-color:var(--purple);flex:none}\n.svc label{flex:1;min-width:0;cursor:pointer}\n.lights{display:flex;gap:4px;flex:none}\n.lt{width:22px;height:22px;border-radius:50%;border:2px solid var(--line);cursor:pointer;padding:0}\n.lt.g{background:#C6F0D8}.lt.y{background:#FCEBB6}.lt.r{background:#F9CDCD}\n.lt.g.on{background:var(--green);border-color:var(--ink)}.lt.y.on{background:var(--yellow);border-color:var(--ink)}.lt.r.on{background:var(--red);border-color:var(--ink)}\n.lt:disabled{opacity:.35;cursor:not-allowed}\n.addrow{display:flex;gap:6px}\n.addrow input{flex:1;min-width:0;font:inherit;font-size:13px;border:1.5px dashed var(--line);border-radius:8px;padding:5px 8px;background:var(--white)}\n.addrow button{font-size:12.5px;padding:5px 10px}\n.svclist{display:flex;flex-direction:column;gap:4px;max-height:330px;overflow:auto}\n.scroll{overflow-x:auto;border:1.5px solid var(--line);border-radius:12px}\ntable{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}\nth{background:var(--deep);color:var(--white);text-align:left;font-size:12px;letter-spacing:.04em;padding:8px;white-space:nowrap}\ntd{border-bottom:1px solid var(--line);padding:4px 6px;vertical-align:middle}\ntd select,td input{font:inherit;font-size:13.5px;border:1.5px solid var(--line);border-radius:7px;padding:4px 6px;background:var(--white);color:var(--ink);min-width:0}\ntd input.num{width:70px;text-align:right}\n.chip{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.08em;border-radius:999px;padding:2px 9px;text-transform:uppercase}\n.c-operator{background:var(--opBg);color:var(--op)}.c-steward{background:var(--stBg);color:var(--st)}.c-catalyst{background:var(--caBg);color:var(--ca)}.c-strategist{background:var(--sgBg);color:var(--sg)}\n.dot{display:inline-block;width:14px;height:14px;border-radius:50%;vertical-align:-2px}\n.dot.green{background:var(--green)}.dot.yellow{background:var(--yellow)}.dot.red{background:var(--red)}.dot.none{background:var(--line)}\n.del{border:none;background:transparent;color:var(--red);font-weight:800;cursor:pointer;font-size:16px}\n.totalbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;font-size:13.5px;background:var(--card);border-radius:10px;padding:8px 12px}\n.totalbar b{font-variant-numeric:tabular-nums}\n.warn{color:var(--red)}\n.inline{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:13.5px}\n.inline input{width:80px;font:inherit;font-weight:800;color:var(--deep);border:1.5px solid var(--line);border-radius:8px;padding:5px 8px;text-align:right}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}\n.card{border-radius:12px;padding:12px;background:var(--card)}\n.card b{display:block;font-size:26px;line-height:1.1;font-variant-numeric:tabular-nums;color:var(--deep)}\n.card span{font-size:12px;color:var(--mute)}\n.bars{display:flex;flex-direction:column;gap:8px}\n.bar{display:grid;grid-template-columns:110px minmax(0,1fr) 120px;gap:10px;align-items:center;font-size:13px}\n.bar .track{height:12px;border-radius:999px;background:var(--card);overflow:hidden}\n.bar .track i{display:block;height:100%;border-radius:999px}\n.bar em{font-style:normal;text-align:right;font-variant-numeric:tabular-nums}\n.sec{display:flex;flex-direction:column;gap:10px}\n.sec h3{margin:0;font-size:15px;color:var(--deep)}\n.ins{display:flex;flex-direction:column;gap:8px}\n.ins div{border-radius:10px;padding:10px 12px;font-size:14px;background:var(--card)}\n.ins div.w{background:var(--redBg);color:#822727}\n.ins div.g{background:var(--greenBg);color:#22543D}\n.roi{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n.plan{display:flex;flex-direction:column;gap:8px}\n.plan .pi{display:grid;grid-template-columns:90px minmax(0,1fr);gap:10px;align-items:center;border:1.5px solid var(--line);border-radius:10px;padding:8px 12px;font-size:14px}\n.plan .pi b{color:var(--purple);font-size:13px}\n.nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:18px;display:flex;flex-direction:column;gap:12px;background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.rail .lbl{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:700;text-transform:uppercase}\n.big{font-size:40px;font-weight:800;line-height:1;color:var(--gold);font-variant-numeric:tabular-nums}\n.rsub{font-size:13px;opacity:.9}\n.rk{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.rk div{background:rgba(255,255,255,.08);border-radius:10px;padding:8px 10px}\n.rk b{display:block;font-size:19px;font-variant-numeric:tabular-nums}\n.rk span{font-size:11.5px;opacity:.85}\n.stack{display:flex;height:14px;border-radius:999px;overflow:hidden;background:rgba(255,255,255,.12)}\n.stack i{display:block;height:100%}\n.slegend{display:flex;flex-wrap:wrap;gap:8px 12px;font-size:11.5px;opacity:.9}\n.slegend span::before{content:\"\";display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:-1px;background:var(--c)}\n.tip{background:rgba(230,180,80,.16);border-radius:12px;padding:10px 12px;font-size:13px}\n.tip .t{font-weight:700;color:var(--gold);margin-bottom:3px}\n.rail .btn{width:100%}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\ntextarea.copybox{position:absolute;left:-9999px;top:0;width:1px;height:1px}\n@media (max-width:1060px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:720px){.qgrid,.roi{grid-template-columns:minmax(0,1fr)}.step{padding:16px}.tab .lbltxt{display:none}.bar{grid-template-columns:90px minmax(0,1fr) 100px}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">From Scorekeeper to Strategist · Session 1 · Homework 1</div>\n      <h1>The Traffic Light Revolution</h1>\n      <p>Check every service you provide, mark how it feels, and estimate how much of your week it takes. The tool shows where your time goes across the four quadrants and how many hours your RED work is costing you.</p>\n    </div>\n    <div class=\"sample\">\n      <span id=\"sampleMsg\"></span>\n      <button class=\"btn light\" type=\"button\" id=\"startOwn\">Start my own</button>\n      <button class=\"btn ghost\" type=\"button\" id=\"loadSample\">Load sample</button>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel\">\n      <div class=\"tabs\" role=\"tablist\" id=\"tabs\"></div>\n\n      <section class=\"step\" data-step=\"0\" role=\"tabpanel\">\n        <h2>Select your services and mark each one</h2>\n        <p class=\"lead\">Tick every service you provide. Then click a light: green if you love it, yellow if it's okay, red if you want it to stop. Add anything that's missing.</p>\n        <div class=\"legend\"><span><i style=\"background:var(--green)\"></i>GREEN · I love this, more please</span><span><i style=\"background:var(--yellow)\"></i>YELLOW · It's okay, maybe someone else</span><span><i style=\"background:var(--red)\"></i>RED · Please make it stop</span></div>\n        <div class=\"qgrid\" id=\"qgrid\"></div>\n        <div class=\"nav\"><span></span><button class=\"btn primary\" type=\"button\" data-go=\"1\">Next: assess time →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"1\" role=\"tabpanel\" hidden>\n        <h2>Assess time and decide</h2>\n        <p class=\"lead\">Estimate the share of your working week each service takes, first instinct only. Then choose what happens to it.</p>\n        <div class=\"inline\"><label for=\"weekHrs\">My working hours per week</label><input type=\"number\" id=\"weekHrs\" min=\"1\" max=\"100\"><span>hours</span></div>\n        <div class=\"scroll\"><table>\n          <thead><tr><th>Service</th><th>Quadrant</th><th>Light</th><th>% of week</th><th>Hours/wk</th><th>Action</th><th>Priority</th><th></th></tr></thead>\n          <tbody id=\"arows\"></tbody></table></div>\n        <div class=\"totalbar\" id=\"totalbar\"></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"0\">← Back</button><button class=\"btn primary\" type=\"button\" data-go=\"2\">Next: analytics →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"2\" role=\"tabpanel\" hidden>\n        <h2>Analytics</h2>\n        <div class=\"cards\" id=\"sumCards\"></div>\n        <div class=\"sec\"><h3>Where your time goes, by quadrant</h3><div class=\"bars\" id=\"qBars\"></div></div>\n        <div class=\"sec\"><h3>Where your time goes, by traffic light</h3><div class=\"bars\" id=\"lBars\"></div></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"1\">← Back</button><button class=\"btn primary\" type=\"button\" data-go=\"3\">Next: insights →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"3\" role=\"tabpanel\" hidden>\n        <h2>Insights</h2>\n        <div class=\"ins\" id=\"ins\"></div>\n        <div class=\"sec\"><h3>What your RED work is worth</h3>\n          <div class=\"inline\"><label for=\"rate\">Value of your time on advisory work</label><input type=\"number\" id=\"rate\" min=\"0\" step=\"25\"><span>$ / hour</span></div>\n          <div class=\"roi\" id=\"roi\"></div>\n          <div class=\"rsub\" style=\"color:var(--mute);font-size:12.5px\">Hours are your RED share of the week. Annual value assumes 48 working weeks, with those hours redeployed to advisory work at the rate above.</div>\n        </div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"2\">← Back</button><button class=\"btn primary\" type=\"button\" data-go=\"4\">Next: action plan →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"4\" role=\"tabpanel\" hidden>\n        <h2>Your 90-day action plan</h2>\n        <div class=\"sec\"><h3>Next 30 days: your top RED items</h3><div class=\"plan\" id=\"p30\"></div></div>\n        <div class=\"sec\"><h3>90-day transformation</h3><div class=\"plan\" id=\"p90\"></div></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"3\">← Back</button>\n          <span style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"btn teal\" type=\"button\" id=\"copyRep\">Copy my report</button><button class=\"btn soft\" type=\"button\" id=\"copyCsv\">Copy as spreadsheet rows</button><button class=\"btn soft\" type=\"button\" onclick=\"(function(){var b=new Blob([window.bnTLcsv()],{type:'text/csv'});var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='traffic_light_assessment.csv';document.body.appendChild(a);a.click();a.remove();})()\">Download CSV</button>\n<button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button></span></div>\n      </section>\n    </main>\n\n    <aside class=\"panel rail\" aria-label=\"Summary\">\n      <div><div class=\"lbl\">RED share of your week</div><div class=\"big\" id=\"redPct\">0%</div><div class=\"rsub\" id=\"redSub\"></div></div>\n      <div class=\"rk\">\n        <div><b id=\"nSel\">0</b><span>services selected</span></div>\n        <div><b id=\"nRated\">0</b><span>with a light</span></div>\n        <div><b id=\"redHrs\">0</b><span>RED hours / week</span></div>\n        <div><b id=\"alloc\">0%</b><span>of week allocated</span></div>\n      </div>\n      <div class=\"lbl\">Time by quadrant</div>\n      <div class=\"stack\" id=\"stack\"></div>\n      <div class=\"slegend\"><span style=\"--c:var(--op)\">Operator</span><span style=\"--c:var(--st)\">Steward</span><span style=\"--c:var(--ca)\">Catalyst</span><span style=\"--c:var(--sg)\">Strategist</span></div>\n      <div class=\"tip\"><div class=\"t\">Next best move</div><div id=\"tip\"></div></div>\n      <div class=\"tip\" style=\"background:rgba(78,205,196,.14)\"><div class=\"t\" style=\"color:var(--teal)\">Feeds Homework 2</div><div>Your RED, YELLOW and GREEN items fill the $100K Question boxes when you open it in this browser.</div></div>\n      <div class=\"toast\" id=\"toast\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n  <div class=\"foot\">From Scorekeeper to Strategist · Session 1: Your Vision, Your Team · Beyond Numbers · Operator = do the work · Steward = protect assets · Catalyst = transform · Strategist = plan and advise</div>\n</div>\n<textarea class=\"copybox\" id=\"copybox\" aria-hidden=\"true\" tabindex=\"-1\"></textarea>\n\n<script>\n(function(){\nconst QUADS=[[\"operator\",\"OPERATOR\",\"Do the work · most replaceable by automation\",\"var(--op)\"],[\"steward\",\"STEWARD\",\"Protect assets · necessary, commoditizing\",\"var(--st)\"],[\"catalyst\",\"CATALYST\",\"Transform · project-based, premium\",\"var(--ca)\"],[\"strategist\",\"STRATEGIST\",\"Plan & advise · retainer-based\",\"var(--sg)\"]];\nconst LIB={\n operator:[\"Manual transaction entry\",\"Bank reconciliations\",\"Credit card reconciliations\",\"Accounts payable data entry\",\"Receipt scanning\",\"Expense report processing\",\"Check printing\",\"Sales tax filing (simple)\",\"1099 preparation\",\"W-2 processing\",\"Simple payroll processing\",\"Invoice generation\",\"Monthly P&L statements\"],\n steward:[\"Tax return prep (1040)\",\"Tax return prep (1120)\",\"Tax return prep (1065)\",\"Tax extension filing\",\"Estimated tax calculations\",\"IRS correspondence\",\"Financial statement prep\",\"Audit support\",\"Month-end closing\",\"Year-end closing\",\"Payroll review\",\"Sales tax review\",\"Depreciation calculations\"],\n catalyst:[\"Workflow automation design\",\"Software implementation\",\"Process reengineering\",\"Digital transformation\",\"Cloud migration\",\"Efficiency analysis\",\"Cost reduction initiatives\",\"Pricing strategy\",\"Business expansion planning\",\"ERP selection\",\"CRM implementation\",\"Dashboard creation\"],\n strategist:[\"CFO services (fractional)\",\"Strategic planning\",\"Business model consulting\",\"Cash flow forecasting\",\"Financial modeling\",\"Budget development\",\"Business plan writing\",\"Investor pitch prep\",\"Valuation services\",\"Exit strategy planning\",\"CEO advisory\",\"Executive coaching\",\"Crisis management\"]\n};\nconst LIGHTS={green:\"GREEN\",yellow:\"YELLOW\",red:\"RED\"};\nconst ACTIONS=[\"Keep\",\"Grow\",\"Outsource\",\"Automate\",\"Delegate\",\"Eliminate\"];\nconst defAction=l=>l===\"red\"?\"Eliminate\":l===\"yellow\"?\"Outsource\":l===\"green\"?\"Keep\":\"Keep\";\nconst KEY=\"bn-traffic-light-v1\", OUT=\"bn-traffic-light\";\nconst S_=(id,light,pct,action)=>({id,light,pct,action:action||null,priority:light===\"red\"?\"High\":\"Medium\"});\nconst SAMPLE={sample:true,weekHrs:50,rate:250,custom:{operator:[],steward:[],catalyst:[],strategist:[]},sel:[\n S_(\"operator|Bank reconciliations\",\"red\",12),S_(\"operator|Accounts payable data entry\",\"red\",10),S_(\"operator|Simple payroll processing\",\"yellow\",8,\"Outsource\"),\n S_(\"operator|Receipt scanning\",\"red\",4,\"Automate\"),S_(\"operator|Monthly P&L statements\",\"yellow\",6,\"Automate\"),S_(\"steward|Tax return prep (1120)\",\"yellow\",14,\"Delegate\"),\n S_(\"steward|Tax return prep (1040)\",\"red\",10,\"Outsource\"),S_(\"steward|IRS correspondence\",\"red\",4),S_(\"steward|Month-end closing\",\"yellow\",8,\"Delegate\"),\n S_(\"catalyst|Software implementation\",\"green\",6,\"Grow\"),S_(\"catalyst|Dashboard creation\",\"green\",4,\"Grow\"),S_(\"strategist|Cash flow forecasting\",\"green\",8,\"Grow\"),S_(\"strategist|CFO services (fractional)\",\"green\",6,\"Grow\")]};\nconst BLANK={sample:false,weekHrs:45,rate:250,custom:{operator:[],steward:[],catalyst:[],strategist:[]},sel:[]};\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??\"\").replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst money=n=>\"$\"+Math.round(n).toLocaleString(\"en-US\");\nconst clone=o=>JSON.parse(JSON.stringify(o));\nconst qOf=id=>id.split(\"|\")[0], nameOf=id=>id.split(\"|\").slice(1).join(\"|\");\nlet S, cur=0;\nfunction load(){try{const r=localStorage.getItem(KEY);if(r)return JSON.parse(r);}catch(e){}return clone(SAMPLE);}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}\nfunction mine(){if(S.sample){S.sample=false;sampleMsg();}}\nfunction sampleMsg(){$(\"sampleMsg\").innerHTML=S.sample?\"<b>Sample practice loaded.</b> Explore it, then start your own.\":\"<b>Your assessment</b> saves in this browser as you go.\";}\nconst find=id=>S.sel.find(x=>x.id===id);\nconst actionOf=x=>x.action||defAction(x.light);\n\nconst STEPS=[\"Select\",\"Assess\",\"Analytics\",\"Insights\",\"Action plan\"];\nfunction renderTabs(){$(\"tabs\").innerHTML=STEPS.map((t,i)=>`<button class=\"tab\" role=\"tab\" type=\"button\" aria-selected=\"${i===cur}\" data-tab=\"${i}\"><span class=\"n\">${i+1}</span><span class=\"lbltxt\">${t}</span></button>`).join(\"\");}\nfunction go(i){cur=i;document.querySelectorAll(\".step\").forEach(s=>s.hidden=+s.dataset.step!==i);renderTabs();\n  if(i===1)renderAssess(); const p=document.querySelector(\"main.panel\");if(p.getBoundingClientRect().top<0)p.scrollIntoView({behavior:\"smooth\"});}\ndocument.addEventListener(\"click\",e=>{const t=e.target.closest(\"[data-tab],[data-go]\");if(t)go(+(t.dataset.tab??t.dataset.go));});\n\nfunction renderSelect(){\n  $(\"qgrid\").innerHTML=QUADS.map(([k,label,sub])=>{\n    const names=[...LIB[k],...(S.custom[k]||[])];\n    const n=S.sel.filter(x=>qOf(x.id)===k).length;\n    return `<div class=\"qbox q-${k}\"><h3>${label}<small>${n} selected</small></h3><div class=\"sub\">${sub}</div>\n      <div class=\"svclist\">${names.map((nm,i)=>{const id=k+\"|\"+nm,x=find(id),cid=`c_${k}_${i}`;\n        return `<div class=\"svc\"><input type=\"checkbox\" id=\"${cid}\" data-id=\"${esc(id)}\"${x?\" checked\":\"\"}><label for=\"${cid}\">${esc(nm)}</label>\n        <span class=\"lights\">${[\"green\",\"yellow\",\"red\"].map(l=>`<button type=\"button\" class=\"lt ${l[0]}${x&&x.light===l?\" on\":\"\"}\" data-id=\"${esc(id)}\" data-l=\"${l}\" aria-label=\"${LIGHTS[l]} for ${esc(nm)}\" aria-pressed=\"${!!(x&&x.light===l)}\"${x?\"\":\" disabled\"}></button>`).join(\"\")}</span></div>`;}).join(\"\")}</div>\n      <div class=\"addrow\"><input type=\"text\" id=\"add_${k}\" placeholder=\"Add a service…\" aria-label=\"Add a ${label} service\"><button type=\"button\" class=\"btn soft\" data-add=\"${k}\">Add</button></div></div>`;}).join(\"\");\n  $(\"qgrid\").querySelectorAll(\"input[type=checkbox]\").forEach(cb=>cb.onchange=()=>{const id=cb.dataset.id;\n    if(cb.checked){if(!find(id))S.sel.push(S_(id,null,0));}else S.sel=S.sel.filter(x=>x.id!==id);\n    mine();renderSelect();calc();});\n  $(\"qgrid\").querySelectorAll(\".lt\").forEach(b=>b.onclick=()=>{const x=find(b.dataset.id);if(!x)return;x.light=x.light===b.dataset.l?null:b.dataset.l;x.priority=x.light===\"red\"?\"High\":x.priority;mine();renderSelect();calc();});\n  $(\"qgrid\").querySelectorAll(\"[data-add]\").forEach(b=>b.onclick=()=>addCustom(b.dataset.add));\n  $(\"qgrid\").querySelectorAll(\".addrow input\").forEach(inp=>inp.onkeydown=e=>{if(e.key===\"Enter\"){e.preventDefault();addCustom(inp.id.slice(4));}});\n}\nfunction addCustom(k){const inp=$(\"add_\"+k),v=inp.value.trim();if(!v)return;\n  if(![...LIB[k],...S.custom[k]].includes(v))S.custom[k].push(v);\n  const id=k+\"|\"+v;if(!find(id))S.sel.push(S_(id,null,0));mine();renderSelect();calc();setTimeout(()=>{const n=$(\"add_\"+k);if(n)n.focus();},0);}\n\nfunction renderAssess(){\n  $(\"weekHrs\").value=S.weekHrs;\n  if(!S.sel.length){$(\"arows\").innerHTML='<tr><td colspan=\"8\" style=\"padding:14px;color:var(--mute)\">Select services in step 1 first.</td></tr>';calc();return;}\n  $(\"arows\").innerHTML=S.sel.map((x,i)=>{const q=qOf(x.id);return `<tr>\n    <td>${esc(nameOf(x.id))}</td><td><span class=\"chip c-${q}\">${q}</span></td>\n    <td><select id=\"al${i}\" data-i=\"${i}\" data-f=\"light\" aria-label=\"Traffic light\"><option value=\"\">–</option>${[\"green\",\"yellow\",\"red\"].map(l=>`<option value=\"${l}\"${x.light===l?\" selected\":\"\"}>${LIGHTS[l]}</option>`).join(\"\")}</select></td>\n    <td><input class=\"num\" type=\"number\" id=\"ap${i}\" data-i=\"${i}\" data-f=\"pct\" value=\"${x.pct||\"\"}\" min=\"0\" max=\"100\" step=\"1\" placeholder=\"0\" aria-label=\"Percent of week\"></td>\n    <td class=\"hrs\" id=\"ah${i}\">0</td>\n    <td><select id=\"aa${i}\" data-i=\"${i}\" data-f=\"action\" aria-label=\"Action\">${ACTIONS.map(a=>`<option${actionOf(x)===a?\" selected\":\"\"}>${a}</option>`).join(\"\")}</select></td>\n    <td><select id=\"apr${i}\" data-i=\"${i}\" data-f=\"priority\" aria-label=\"Priority\">${[\"High\",\"Medium\",\"Low\"].map(p=>`<option${x.priority===p?\" selected\":\"\"}>${p}</option>`).join(\"\")}</select></td>\n    <td><button type=\"button\" class=\"del\" data-del=\"${i}\" aria-label=\"Remove\">×</button></td></tr>`;}).join(\"\");\n  $(\"arows\").querySelectorAll(\"[data-f]\").forEach(el=>el.addEventListener(el.tagName===\"SELECT\"?\"change\":\"input\",()=>{const x=S.sel[+el.dataset.i],f=el.dataset.f;\n    if(f===\"pct\")x.pct=+el.value||0;else if(f===\"light\"){x.light=el.value||null;if(!x.action){$(\"aa\"+el.dataset.i).value=defAction(x.light);}}else x[f]=el.value;\n    mine();calc();if(f===\"light\")renderSelect();}));\n  $(\"arows\").querySelectorAll(\"[data-del]\").forEach(b=>b.onclick=()=>{S.sel.splice(+b.dataset.del,1);mine();renderAssess();renderSelect();calc();});\n  calc();\n}\n$(\"weekHrs\").oninput=()=>{S.weekHrs=+$(\"weekHrs\").value||0;mine();calc();};\n$(\"rate\").oninput=()=>{S.rate=+$(\"rate\").value||0;mine();calc();};\n\nfunction stats(){\n  const byQ={},byL={green:0,yellow:0,red:0,none:0},cntQ={},cntL={green:0,yellow:0,red:0};\n  QUADS.forEach(([k])=>{byQ[k]=0;cntQ[k]=0;});\n  let alloc=0;\n  S.sel.forEach(x=>{const q=qOf(x.id),p=+x.pct||0;byQ[q]+=p;cntQ[q]++;alloc+=p;byL[x.light||\"none\"]+=p;if(x.light)cntL[x.light]++;});\n  const hrs=p=>p/100*(+S.weekHrs||0);\n  return {byQ,byL,cntQ,cntL,alloc,hrs,redHrs:hrs(byL.red),rated:S.sel.filter(x=>x.light).length};\n}\nfunction calc(){\n  const st=stats(), wk=+S.weekHrs||0;\n  S.sel.forEach((x,i)=>{const c=$(\"ah\"+i);if(c)c.textContent=st.hrs(+x.pct||0).toFixed(1);});\n  const left=100-st.alloc;\n  if($(\"totalbar\")) $(\"totalbar\").innerHTML=`<span>Allocated: <b class=\"${st.alloc>100?\"warn\":\"\"}\">${st.alloc}%</b> of your week (${st.hrs(st.alloc).toFixed(1)} of ${wk} hours)</span><span class=\"${st.alloc>100?\"warn\":\"\"}\">${st.alloc>100?`Over by ${st.alloc-100}%. Trim the largest items.`:left>0?`${left}% not yet assigned`:\"Fully allocated\"}</span>`;\n  // rail\n  const redShare=st.alloc?Math.round(st.byL.red/Math.max(100,st.alloc)*100):0;\n  $(\"redPct\").textContent=st.byL.red+\"%\";\n  $(\"redSub\").textContent=st.byL.red?`${st.redHrs.toFixed(1)} hours a week on work you want to stop`:\"Mark services RED and give them a share of your week\";\n  $(\"nSel\").textContent=S.sel.length;$(\"nRated\").textContent=st.rated;$(\"redHrs\").textContent=st.redHrs.toFixed(1);$(\"alloc\").textContent=st.alloc+\"%\";\n  const tot=Math.max(1,QUADS.reduce((a,[k])=>a+st.byQ[k],0));\n  $(\"stack\").innerHTML=QUADS.map(([k,,, c])=>`<i style=\"width:${st.byQ[k]/tot*100}%;background:${c}\" title=\"${k} ${st.byQ[k]}%\"></i>`).join(\"\");\n  let tip;\n  if(!S.sel.length) tip=\"Start in step 1: tick every service you provide.\";\n  else if(st.rated<S.sel.length) tip=`${S.sel.length-st.rated} selected service${S.sel.length-st.rated===1?\" has\":\"s have\"} no light yet.`;\n  else if(st.alloc<90) tip=\"Go to step 2 and estimate each service's share of your week.\";\n  else if(st.alloc>100) tip=\"Your percentages add up to more than 100%. Trim the biggest items.\";\n  else if(st.byL.red>=30) tip=\"Over 30% of your week is RED. Start the action plan with your largest RED item.\";\n  else tip=\"Open the action plan, then carry your lists into the $100K Question.\";\n  $(\"tip\").textContent=tip;\n  // analytics\n  $(\"sumCards\").innerHTML=[[\"Services\",S.sel.length],...QUADS.map(([k,l])=>[l,st.cntQ[k]])].map(c=>`<div class=\"card\"><b>${c[1]}</b><span>${c[0]}</span></div>`).join(\"\");\n  const bars=(items,max)=>items.map(([lab,val,c,extra])=>`<div class=\"bar\"><span>${lab}</span><div class=\"track\"><i style=\"width:${max?val/max*100:0}%;background:${c}\"></i></div><em>${val}% · ${st.hrs(val).toFixed(1)} h${extra||\"\"}</em></div>`).join(\"\");\n  const mq=Math.max(1,...QUADS.map(([k])=>st.byQ[k]));\n  $(\"qBars\").innerHTML=bars(QUADS.map(([k,l,,c])=>[l,st.byQ[k],c]),mq);\n  const ml=Math.max(1,st.byL.green,st.byL.yellow,st.byL.red,st.byL.none);\n  $(\"lBars\").innerHTML=bars([[\"GREEN\",st.byL.green,\"var(--green)\"],[\"YELLOW\",st.byL.yellow,\"var(--yellow)\"],[\"RED\",st.byL.red,\"var(--red)\"],...(st.byL.none?[[\"No light\",st.byL.none,\"var(--line)\"]]:[])],ml);\n  // insights\n  const I=[];\n  if(st.byL.red>=30) I.push([\"w\",`${st.byL.red}% of your week is RED. That is ${st.redHrs.toFixed(1)} hours a week on work you want to stop.`]);\n  else if(st.cntL.red>3) I.push([\"w\",`You have ${st.cntL.red} RED services. Pick the largest and stop it first.`]);\n  const op=st.byQ.operator, sg=st.byQ.strategist;\n  if(op>0&&op>sg*2) I.push([\"w\",`Operator work takes ${op}% of your week against ${sg}% for Strategist work. That is the work most exposed to automation and price pressure.`]);\n  if(st.cntQ.strategist<3) I.push([\"\",`Only ${st.cntQ.strategist} Strategist service${st.cntQ.strategist===1?\"\":\"s\"} selected. Building advisory services is where premium pricing lives.`]);\n  if(st.cntL.green>st.cntL.red*2&&st.cntL.green>0) I.push([\"g\",\"Strong alignment: you enjoy most of your work. Now make sure the GREEN work is also the best paid.\"]);\n  const greenOps=S.sel.filter(x=>x.light===\"green\"&&qOf(x.id)===\"operator\").length;\n  if(greenOps) I.push([\"\",`${greenOps} Operator service${greenOps===1?\" is\":\"s are\"} GREEN. Enjoying them is fine, but check they pass the skilled + fulfilled + compensated test.`]);\n  $(\"ins\").innerHTML=I.length?I.map(i=>`<div class=\"${i[0]}\">${esc(i[1])}</div>`).join(\"\"):'<div>Select, mark and time your services to see insights.</div>';\n  $(\"rate\").value=S.rate;\n  const annual=st.redHrs*48*(+S.rate||0);\n  $(\"roi\").innerHTML=[[st.redHrs.toFixed(1),\"hours a week to reclaim\"],[Math.round(st.redHrs*48).toLocaleString(),\"hours a year\"],[money(annual),\"a year if redeployed to advisory\"]].map(c=>`<div class=\"card\"><b>${c[0]}</b><span>${c[1]}</span></div>`).join(\"\");\n  // plan\n  const reds=S.sel.filter(x=>x.light===\"red\").sort((a,b)=>(+b.pct||0)-(+a.pct||0));\n  const yel=S.sel.filter(x=>x.light===\"yellow\"), gs=S.sel.filter(x=>x.light===\"green\"&&(qOf(x.id)===\"strategist\"||qOf(x.id)===\"catalyst\"));\n  $(\"p30\").innerHTML=reds.slice(0,3).map((x,i)=>`<div class=\"pi\"><b>Day ${(i+1)*10}</b><span>${esc(actionOf(x))} \"${esc(nameOf(x.id))}\" (${x.pct||0}% of your week)</span></div>`).join(\"\")||'<div class=\"pi\"><b>–</b><span>No RED services yet. Mark the work you want to stop.</span></div>';\n  const verb=a=>({Outsource:\"outsource\",Automate:\"automate\",Delegate:\"delegate\",Eliminate:\"eliminate\",Keep:\"keep\",Grow:\"grow\"}[a]||a.toLowerCase());\n  $(\"p90\").innerHTML=[[\"Month 1\",`Stop or hand off ${reds.length} RED service${reds.length===1?\"\":\"s\"} (${st.byL.red}% of your week).`],\n    [\"Month 2\",`Outsource, automate or delegate ${yel.length} YELLOW service${yel.length===1?\"\":\"s\"}${yel.length?\": \"+yel.slice(0,3).map(x=>`${nameOf(x.id)} (${verb(actionOf(x))})`).join(\", \")+(yel.length>3?\"…\":\"\"):\"\"}.`],\n    [\"Month 3\",`Expand ${gs.length} GREEN Catalyst and Strategist service${gs.length===1?\"\":\"s\"}${gs.length?\": \"+gs.slice(0,3).map(x=>nameOf(x.id)).join(\", \"):\"\"}.`]].map(p=>`<div class=\"pi\"><b>${p[0]}</b><span>${esc(p[1])}</span></div>`).join(\"\");\n  // hand-off\n  try{localStorage.setItem(OUT,JSON.stringify({weekHrs:+S.weekHrs||0,redPct:st.byL.red,redHrs:st.redHrs,items:S.sel.filter(x=>x.light).map(x=>({name:nameOf(x.id),quadrant:qOf(x.id),light:x.light,pct:+x.pct||0,action:actionOf(x)})),at:Date.now()}));}catch(e){}\n  save();\n}\nfunction report(){const st=stats(),L=[\"TRAFFIC LIGHT SERVICE ASSESSMENT\",`Working week: ${S.weekHrs} hours`,`RED share: ${st.byL.red}% (${st.redHrs.toFixed(1)} h/wk) · YELLOW ${st.byL.yellow}% · GREEN ${st.byL.green}%`,\"\"];\n  QUADS.forEach(([k,l])=>{const xs=S.sel.filter(x=>qOf(x.id)===k);if(!xs.length)return;L.push(`${l} (${st.byQ[k]}% of week)`);xs.forEach(x=>L.push(`  - ${nameOf(x.id)} | ${x.light?LIGHTS[x.light]:\"no light\"} | ${x.pct||0}% | ${actionOf(x)} | ${x.priority}`));});\n  return L.join(\"\\n\");}\nfunction csv(){const L=[\"Service,Quadrant,Light,% of week,Hours per week,Action,Priority\"];const st=stats();\n  S.sel.forEach(x=>L.push([`\"${nameOf(x.id).replace(/\"/g,'\"\"')}\"`,qOf(x.id),x.light?LIGHTS[x.light]:\"\",x.pct||0,st.hrs(+x.pct||0).toFixed(1),actionOf(x),x.priority].join(\",\")));return L.join(\"\\n\");}\nwindow.bnTLcsv=csv;\nasync function copyText(t,msg){try{await navigator.clipboard.writeText(t);toast(msg);}catch(e){const b=$(\"copybox\");b.value=t;b.select();try{document.execCommand(\"copy\");toast(msg);}catch(_){toast(\"Copy is blocked here.\");}}}\n$(\"copyRep\").onclick=()=>copyText(report(),\"Report copied.\");\n$(\"copyCsv\").onclick=()=>copyText(csv(),\"Copied. Paste into Excel or Google Sheets.\");\nfunction toast(m){$(\"toast\").textContent=m;setTimeout(()=>$(\"toast\").textContent=\"\",3500);}\nlet armed=null;\nfunction confirmBtn(btn,label,fn){if(armed===btn){armed=null;fn();return;}armed=btn;const old=btn.textContent;btn.textContent=label;setTimeout(()=>{if(armed===btn){armed=null;btn.textContent=old;}},3500);}\n$(\"startOwn\").onclick=function(){const b=this;if(S.sample){S=clone(BLANK);init();return;}confirmBtn(b,\"Clear everything? Click again\",()=>{S=clone(BLANK);b.textContent=\"Start my own\";init();});};\n$(\"loadSample\").onclick=function(){const b=this;if(S.sample){init();return;}confirmBtn(b,\"Replace my work? Click again\",()=>{S=clone(SAMPLE);b.textContent=\"Load sample\";init();});};\nfunction init(){sampleMsg();renderSelect();renderAssess();go(cur);calc();}\nS=load(); init();\n})();\n</script>\n\n</body>\n</html>\n"
  }
}