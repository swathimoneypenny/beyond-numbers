{
  "schemaVersion": "1.0",
  "id": "s2-hw1-client-portfolio-matrix",
  "session": 2,
  "exercise": 1,
  "title": "Client Portfolio Matrix",
  "type": "matrix",
  "summary": "Homework 1 for Session 2 (Clients & Pricing), rebuilt from the 2025 Session 4 Client Portfolio Evaluation Matrix. Enter clients with industry and annual fees, score value and effort 1–5, and each client is sorted live into IDEAL (value ≥3, effort ≤2), DEVELOP (value ≥3, effort ≥3), EXIT (value ≤2, effort ≥3) or AUTOMATE (value ≤2, effort ≤2). Shows a plotted matrix, counts and share of fees per quadrant, debrief flags (30%+ in EXIT, under 20% IDEAL), and a this-week / 30-day / 90-day action plan. Up to three IDEAL clients ticked 'Price it' are passed to Homework 2 (True Cost) and Homework 3 (Firm Cost) through browser storage. Opens on a ten-client sample book; copy or download as CSV.",
  "interactive": true,
  "homework": true,
  "sharedStorageKeys": [
    "bn-ideal-clients",
    "bn-true-cost-results",
    "bn-true-cost-result"
  ],
  "brand": {
    "indigo": "#667EEA",
    "purple": "#764BA2",
    "deep": "#44337A",
    "gold": "#E6B450",
    "teal": "#4ECDC4",
    "gradient": [
      "#667EEA",
      "#764BA2"
    ],
    "font": "Calibri"
  },
  "embed": {
    "format": "html",
    "selfContained": true,
    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Client Portfolio Matrix</title>\n<style>\n/* Layout: brand gradient field; client table panel left, live matrix + IDEAL picks rail right; plan below */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69; --coral:#E05D5D; --coralBg:#FDECEC;\n  --ideal:#2F855A; --idealBg:#E8F6EE; --develop:#B7791F; --developBg:#FDF3DC; --exit:#C53030; --exitBg:#FDECEC; --auto:#5A67D8; --autoBg:#ECEFFE;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1360px;margin:0 auto;padding-block:20px 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:64ch;opacity:.92}\n.sample{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:10px 14px;color:var(--white);font-size:13.5px}\n.sample b{color:var(--gold)}\n.btn{border:none;border-radius:999px;padding:8px 16px;font:inherit;font-weight:700;font-size:13.5px;cursor:pointer}\n.btn:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.light{background:var(--white);color:var(--deep)}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.7)}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.teal{background:var(--teal);color:#0E4A45}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 420px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.main{padding:20px 22px 22px;display:flex;flex-direction:column;gap:14px}\nh2{margin:0;font-size:18px;color:var(--purple);display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}\nh2 small{font-size:12.5px;color:var(--mute);font-weight:400;font-style:italic}\n.guide{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px}\n.guide div{background:var(--card);border-radius:10px;padding:10px 12px}\n.guide b{color:var(--deep)}\n.scroll{overflow-x:auto;border:1.5px solid var(--line);border-radius:12px}\ntable{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}\nth{background:var(--deep);color:var(--white);text-align:left;font-size:12px;letter-spacing:.04em;padding:8px;white-space:nowrap}\ntd{border-bottom:1px solid var(--line);padding:4px 6px;vertical-align:middle}\ntd input,td select{font:inherit;font-size:13.5px;color:var(--ink);border:1.5px solid transparent;border-radius:7px;padding:5px 6px;width:100%;background:transparent;min-width:0}\ntd input:hover,td select:hover{border-color:var(--line)}\ntd input:focus,td select:focus{border-color:var(--purple);outline:none;background:var(--white)}\ntd input.num{text-align:right}\n.c-num{width:34px;color:var(--mute);text-align:center;font-weight:700}\n.c-name{min-width:180px}.c-ind{min-width:150px}.c-fee{width:120px}.c-sc{width:78px}.c-q{width:112px}.c-pick{width:70px;text-align:center}.c-x{width:36px}\n.chip{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.08em;border-radius:999px;padding:3px 10px}\n.q-IDEAL{background:var(--idealBg);color:var(--ideal)}.q-DEVELOP{background:var(--developBg);color:var(--develop)}.q-EXIT{background:var(--exitBg);color:var(--exit)}.q-AUTOMATE{background:var(--autoBg);color:var(--auto)}.q-none{background:var(--card);color:var(--mute)}\ntd.c-pick input{width:18px;height:18px;accent-color:var(--ideal)}\n.del{border:none;background:transparent;color:var(--coral);font-weight:800;cursor:pointer;font-size:16px;padding:2px 6px;border-radius:6px}\n.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.toast{font-size:12.5px;color:var(--tealInk);min-height:18px}\n/* matrix */\n.side{display:flex;flex-direction:column;gap:16px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px)}\n.mx{padding:16px 18px 18px;display:flex;flex-direction:column;gap:10px}\n.plotwrap{display:grid;grid-template-columns:22px minmax(0,1fr);gap:4px}\n.ylab{writing-mode:vertical-rl;transform:rotate(180deg);font-size:11px;font-weight:700;letter-spacing:.1em;color:var(--purple);text-align:center}\n.xlab{grid-column:2;font-size:11px;font-weight:700;letter-spacing:.1em;color:var(--purple);text-align:center}\n.plot{position:relative;aspect-ratio:1/1;max-width:100%;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;border-radius:12px;overflow:hidden;border:1.5px solid var(--line)}\n.plotcol{display:flex;flex-direction:column;gap:6px;min-width:0}\n.qlabels{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.ql{display:flex;flex-direction:column;line-height:1.2}\n.ql b{font-size:13px;letter-spacing:.1em}\n.ql span{font-size:11px;color:var(--mute)}\n.ql.IDEAL,.ql.DEVELOP{text-align:right}\n.ql.AUTOMATE b{color:var(--auto)}.ql.IDEAL b{color:var(--ideal)}.ql.EXIT b{color:var(--exit)}.ql.DEVELOP b{color:var(--develop)}\n.quad{}\n.quad.AUTOMATE{background:var(--autoBg)}\n.quad.IDEAL{background:var(--idealBg)}\n.quad.EXIT{background:var(--exitBg)}\n.quad.DEVELOP{background:var(--developBg)}\n.dot{position:absolute;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:800;color:var(--white);border:2px solid var(--white);box-shadow:0 2px 6px rgba(0,0,0,.2)}\n.dot.IDEAL{background:var(--ideal)}.dot.DEVELOP{background:var(--develop)}.dot.EXIT{background:var(--exit)}.dot.AUTOMATE{background:var(--auto)}\n.dot.pick{box-shadow:0 0 0 3px var(--gold)}\n.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}\n.stat{border-radius:10px;padding:8px;text-align:center}\n.stat b{display:block;font-size:22px;line-height:1.1;font-variant-numeric:tabular-nums}\n.stat span{font-size:11px;font-weight:700;letter-spacing:.06em}\n.stat em{display:block;font-style:normal;font-size:11px;color:var(--mute)}\n.stat.IDEAL{background:var(--idealBg);color:var(--ideal)}.stat.DEVELOP{background:var(--developBg);color:var(--develop)}.stat.EXIT{background:var(--exitBg);color:var(--exit)}.stat.AUTOMATE{background:var(--autoBg);color:var(--auto)}\n.flags{display:flex;flex-direction:column;gap:6px}\n.flag{font-size:12.5px;border-radius:8px;padding:7px 10px;background:var(--card)}\n.flag.warn{background:var(--coralBg);color:#9B2C2C}\n.picks{padding:16px 18px;display:flex;flex-direction:column;gap:10px;background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.picks .lbl{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:700;text-transform:uppercase}\n.pick{display:flex;gap:10px;align-items:center;background:rgba(255,255,255,.1);border-radius:10px;padding:8px 10px}\n.pick i{width:24px;height:24px;border-radius:50%;background:var(--gold);color:#4A3608;font-style:normal;font-weight:800;display:grid;place-items:center;font-size:12px;flex:none}\n.pick div{min-width:0}\n.pick b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.pick span{font-size:12px;opacity:.85}\n.pick.empty{opacity:.6}\n.picks p{margin:0;font-size:12.5px;opacity:.9}\n/* plan */\n.plan{padding:18px 20px;display:flex;flex-direction:column;gap:12px}\n.plancols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n.pc{border:1.5px solid var(--line);border-radius:12px;padding:12px 14px}\n.pc h3{margin:0 0 6px;font-size:14px;color:var(--deep)}\n.pc ul{margin:0;padding-left:18px;font-size:13.5px;display:flex;flex-direction:column;gap:4px}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\ntextarea.copybox{position:absolute;left:-9999px;top:0;width:1px;height:1px}\n@media (max-width:1100px){.grid{grid-template-columns:minmax(0,1fr)}.side{position:static}.plot{max-width:460px}}\n@media (max-width:720px){.guide,.plancols{grid-template-columns:minmax(0,1fr)}.main,.mx,.plan{padding:16px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">From Scorekeeper to Strategist · Session 2 · Homework 1</div>\n      <h1>Client Portfolio Matrix</h1>\n      <p>Score your clients on the value they bring and the effort they take. The matrix sorts them into IDEAL, DEVELOP, EXIT and AUTOMATE as you type. Then choose three IDEAL clients to price for advisory in Homework 2 and 3.</p>\n    </div>\n    <div class=\"sample\">\n      <span id=\"sampleMsg\"></span>\n      <button class=\"btn light\" type=\"button\" id=\"startOwn\">Start my own book</button>\n      <button class=\"btn ghost\" type=\"button\" id=\"loadSample\">Load sample</button>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel main\">\n      <h2>Your clients <small>start with your top 20 by fees, or 10 if you're short on time</small></h2>\n      <div class=\"guide\">\n        <div><b>Value (1–5):</b> revenue and growth potential, referrals, strategic importance, appetite for advisory.</div>\n        <div><b>Effort (1–5):</b> time demands, tech resistance, communication needs, deadline stress. 5 = most effort.</div>\n      </div>\n      <div class=\"scroll\">\n        <table>\n          <thead><tr><th class=\"c-num\">#</th><th class=\"c-name\">Client</th><th class=\"c-ind\">Industry</th><th class=\"c-fee\">Annual fees</th><th class=\"c-sc\">Value</th><th class=\"c-sc\">Effort</th><th class=\"c-q\">Quadrant</th><th class=\"c-pick\" title=\"Price this client in Homework 2 and 3\">Price it</th><th class=\"c-x\"></th></tr></thead>\n          <tbody id=\"rows\"></tbody>\n        </table>\n      </div>\n      <div class=\"row\">\n        <button class=\"btn soft\" type=\"button\" id=\"add\">+ Add a client</button>\n        <button class=\"btn soft\" type=\"button\" id=\"copyCsv\">Copy as spreadsheet rows</button>\n        <button class=\"btn soft\" type=\"button\" onclick=\"(function(){var b=new Blob([window.bnMatrixCsv()],{type:'text/csv'});var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='client_portfolio_matrix.csv';document.body.appendChild(a);a.click();a.remove();})()\">Download CSV</button><button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button>\n        <span class=\"toast\" id=\"toast\" aria-live=\"polite\"></span>\n      </div>\n    </main>\n\n    <aside class=\"side\">\n      <section class=\"panel mx\" aria-label=\"Matrix\">\n        <h2>Your portfolio matrix</h2>\n        <div class=\"plotwrap\">\n          <div class=\"ylab\">← LOW EFFORT · · · HIGH EFFORT →</div>\n          <div class=\"plotcol\">\n          <div class=\"qlabels\"><div class=\"ql AUTOMATE\"><b>AUTOMATE</b><span>Low value · low effort</span></div><div class=\"ql IDEAL\"><b>IDEAL</b><span>High value · low effort</span></div></div>\n          <div class=\"plot\" id=\"plot\">\n            <div class=\"quad AUTOMATE\"></div><div class=\"quad IDEAL\"></div><div class=\"quad EXIT\"></div><div class=\"quad DEVELOP\"></div>\n          </div>\n          <div class=\"qlabels\"><div class=\"ql EXIT\"><b>EXIT</b><span>Low value · high effort</span></div><div class=\"ql DEVELOP\"><b>DEVELOP</b><span>High value · high effort</span></div></div>\n          </div>\n          <div class=\"xlab\">LOW VALUE · · · HIGH VALUE →</div>\n        </div>\n        <div class=\"stats\" id=\"stats\"></div>\n        <div class=\"flags\" id=\"flags\"></div>\n      </section>\n      <section class=\"panel picks\" aria-label=\"IDEAL clients to price\">\n        <div class=\"lbl\">Your three IDEAL clients to price</div>\n        <div id=\"picks\"></div>\n        <p id=\"picksNote\"></p>\n      </section>\n    </aside>\n  </div>\n\n  <section class=\"panel plan\" aria-label=\"Action plan\">\n    <h2>Your action plan <small>built from your matrix</small></h2>\n    <div class=\"plancols\">\n      <div class=\"pc\"><h3>This week</h3><ul id=\"pWeek\"></ul></div>\n      <div class=\"pc\"><h3>Next 30 days</h3><ul id=\"p30\"></ul></div>\n      <div class=\"pc\"><h3>Next 90 days</h3><ul id=\"p90\"></ul></div>\n    </div>\n  </section>\n  <div class=\"foot\">From Scorekeeper to Strategist · Session 2: Clients &amp; Pricing · Beyond Numbers · Value ≥ 3 is high value; effort ≤ 2 is low effort.</div>\n</div>\n<textarea class=\"copybox\" id=\"copybox\" aria-hidden=\"true\" tabindex=\"-1\"></textarea>\n\n<script>\n(function(){\nconst INDUSTRIES=[\"Restaurant\",\"Construction\",\"Retail\",\"Professional Services\",\"Healthcare\",\"Real Estate\",\"Manufacturing\",\"Technology\",\"Non-Profit\",\"E-commerce\",\"Consulting\",\"Other\"];\nconst Q=[\"IDEAL\",\"DEVELOP\",\"EXIT\",\"AUTOMATE\"];\nconst KEY=\"bn-client-matrix-v1\", IDEALKEY=\"bn-ideal-clients\";\nconst C=(name,industry,fee,value,effort,pick)=>({name,industry,fee,value,effort,pick:!!pick});\nconst SAMPLE={sample:true,clients:[\n C(\"Harbor Dental Group\",\"Healthcare\",14400,5,2,true),C(\"Ridgeline Builders\",\"Construction\",18000,5,1,true),C(\"Bayside Bistro\",\"Restaurant\",9600,4,2,true),\n C(\"Coastal Property Partners\",\"Real Estate\",12000,4,4),C(\"Summit Outfitters\",\"Retail\",6000,4,3),C(\"Westside Tutoring\",\"Professional Services\",2400,2,4),\n C(\"Pacific Print Shop\",\"Manufacturing\",1800,2,1),C(\"Elm Street Café\",\"Restaurant\",2100,1,5),C(\"Northwind Consulting\",\"Consulting\",4800,3,2),C(\"Garcia Family Trust\",\"Other\",1500,1,2)]};\nconst BLANK={sample:false,clients:[C(\"\",\"\",null,null,null),C(\"\",\"\",null,null,null),C(\"\",\"\",null,null,null),C(\"\",\"\",null,null,null),C(\"\",\"\",null,null,null)]};\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??\"\").replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst money=n=>\"$\"+Math.round(n).toLocaleString(\"en-US\");\nconst clone=o=>JSON.parse(JSON.stringify(o));\nlet S;\nfunction load(){try{const r=localStorage.getItem(KEY);if(r)return JSON.parse(r);}catch(e){}return clone(SAMPLE);}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}\nfunction quad(c){const v=+c.value,e=+c.effort;if(!c.name||!v||!e)return null;\n  if(v>=3&&e<=2)return\"IDEAL\";if(v>=3&&e>=3)return\"DEVELOP\";if(v<=2&&e>=3)return\"EXIT\";return\"AUTOMATE\";}\nfunction scored(){return S.clients.map((c,i)=>({c,i,q:quad(c)})).filter(x=>x.q);}\n\nfunction renderRows(){\n  $(\"rows\").innerHTML=S.clients.map((c,i)=>{\n    const q=quad(c);\n    const sc=(f)=>`<select id=\"${f}${i}\" data-i=\"${i}\" data-f=\"${f}\" aria-label=\"${f===\"value\"?\"Value score\":\"Effort score\"}\"><option value=\"\">–</option>${[1,2,3,4,5].map(n=>`<option${+c[f]===n?\" selected\":\"\"}>${n}</option>`).join(\"\")}</select>`;\n    return `<tr>\n     <td class=\"c-num\">${i+1}</td>\n     <td><input id=\"name${i}\" data-i=\"${i}\" data-f=\"name\" value=\"${esc(c.name)}\" placeholder=\"Client name\" aria-label=\"Client name\"></td>\n     <td><select id=\"industry${i}\" data-i=\"${i}\" data-f=\"industry\" aria-label=\"Industry\"><option value=\"\">Select industry</option>${INDUSTRIES.map(x=>`<option${c.industry===x?\" selected\":\"\"}>${x}</option>`).join(\"\")}</select></td>\n     <td><input class=\"num\" type=\"number\" id=\"fee${i}\" data-i=\"${i}\" data-f=\"fee\" value=\"${c.fee??\"\"}\" min=\"0\" step=\"100\" placeholder=\"$/yr\" aria-label=\"Annual fees\"></td>\n     <td>${sc(\"value\")}</td><td>${sc(\"effort\")}</td>\n     <td><span class=\"chip ${q?\"q-\"+q:\"q-none\"}\" id=\"q${i}\">${q||\"not scored\"}</span></td>\n     <td class=\"c-pick\"><input type=\"checkbox\" id=\"pick${i}\" data-i=\"${i}\" data-f=\"pick\"${c.pick&&q===\"IDEAL\"?\" checked\":\"\"}${q===\"IDEAL\"?\"\":\" disabled\"} aria-label=\"Price this client in Homework 2 and 3\"></td>\n     <td><button class=\"del\" type=\"button\" data-del=\"${i}\" aria-label=\"Remove client\">×</button></td></tr>`;}).join(\"\");\n  $(\"rows\").querySelectorAll(\"[data-f]\").forEach(el=>{\n    const h=()=>{const c=S.clients[+el.dataset.i],f=el.dataset.f;\n      if(f===\"pick\"){ if(el.checked&&S.clients.filter(x=>x.pick&&quad(x)===\"IDEAL\").length>=3){el.checked=false;toast(\"Pick three IDEAL clients at most. Untick one first.\");return;} c.pick=el.checked; }\n      else c[f]=el.type===\"number\"?(el.value===\"\"?null:+el.value):el.value;\n      mine(); if(f===\"value\"||f===\"effort\"||f===\"name\"){updateRow(+el.dataset.i);} calc();};\n    el.addEventListener(el.type===\"checkbox\"||el.tagName===\"SELECT\"?\"change\":\"input\",h);});\n  $(\"rows\").querySelectorAll(\"[data-del]\").forEach(b=>b.onclick=()=>{S.clients.splice(+b.dataset.del,1);mine();renderRows();calc();});\n}\nfunction updateRow(i){const c=S.clients[i],q=quad(c),chip=$(\"q\"+i),pk=$(\"pick\"+i);\n  chip.className=\"chip \"+(q?\"q-\"+q:\"q-none\");chip.textContent=q||\"not scored\";\n  pk.disabled=q!==\"IDEAL\"; if(q!==\"IDEAL\"){pk.checked=false;} else pk.checked=!!c.pick;}\nfunction mine(){if(S.sample){S.sample=false;sampleMsg();}}\nfunction sampleMsg(){$(\"sampleMsg\").innerHTML=S.sample?\"<b>Sample book loaded.</b> Explore it, then start your own.\":\"<b>Your book</b> saves in this browser as you type.\";}\n\nfunction picks(){\n  const chosen=S.clients.filter(c=>c.pick&&quad(c)===\"IDEAL\");\n  return chosen.slice(0,3);\n}\nfunction calc(){\n  const sc=scored(), n=sc.length;\n  const counts={},fees={};Q.forEach(q=>{counts[q]=0;fees[q]=0;});\n  sc.forEach(x=>{counts[x.q]++;fees[x.q]+=+x.c.fee||0;});\n  const totalFee=Q.reduce((a,q)=>a+fees[q],0);\n  // dots\n  $(\"plot\").querySelectorAll(\".dot\").forEach(d=>d.remove());\n  const seen={};\n  sc.forEach(x=>{const v=+x.c.value,e=+x.c.effort,k=v+\"-\"+e;const j=seen[k]=(seen[k]||0)+1;\n    const off=[[0,0],[6,4],[-6,4],[4,-6],[-4,-6],[9,-1],[-9,-1]][(j-1)%7];\n    const d=document.createElement(\"div\");d.className=\"dot \"+x.q+(x.c.pick&&x.q===\"IDEAL\"?\" pick\":\"\");d.textContent=x.i+1;\n    const POS=[0,14,36,60,74,88];d.style.left=`calc(${POS[v]}% + ${off[0]}px)`;d.style.top=`calc(${POS[e]}% + ${off[1]}px)`;\n    d.title=`${x.c.name} · value ${v}, effort ${e} · ${x.q}`;$(\"plot\").appendChild(d);});\n  $(\"stats\").innerHTML=Q.map(q=>`<div class=\"stat ${q}\"><b>${counts[q]}</b><span>${q}</span><em>${totalFee?Math.round(fees[q]/totalFee*100)+\"% of fees\":(n?Math.round(counts[q]/n*100)+\"% of clients\":\"–\")}</em></div>`).join(\"\");\n  const fl=[];\n  if(!n) fl.push([\"\",\"Score at least one client to see your matrix.\"]);\n  else{\n    const exitShare=counts.EXIT/n, idealShare=counts.IDEAL/n;\n    if(exitShare>=0.3) fl.push([\"warn\",`${Math.round(exitShare*100)}% of your clients sit in EXIT. They are using hours your IDEAL clients need.`]);\n    if(idealShare<0.2) fl.push([\"warn\",`Only ${Math.round(idealShare*100)}% of your clients are IDEAL. Look at DEVELOP clients who could become IDEAL with a fixed fee and clear scope.`]);\n    if(totalFee&&fees.EXIT/totalFee>0.2) fl.push([\"warn\",`EXIT clients bring ${Math.round(fees.EXIT/totalFee*100)}% of your fees. Reprice them in Homework 3 before you release them.`]);\n    if(!fl.length) fl.push([\"\",`A healthy book: ${counts.IDEAL} IDEAL and ${counts.EXIT} EXIT. Keep growing the IDEAL group.`]);\n  }\n  $(\"flags\").innerHTML=fl.map(f=>`<div class=\"flag ${f[0]}\">${esc(f[1])}</div>`).join(\"\");\n  // picks\n  const p=picks(), ideals=sc.filter(x=>x.q===\"IDEAL\");\n  $(\"picks\").innerHTML=[0,1,2].map(k=>p[k]?`<div class=\"pick\"><i>${k+1}</i><div><b>${esc(p[k].name)}</b><span>${esc(p[k].industry||\"Industry not set\")}${p[k].fee?\" · \"+money(p[k].fee)+\"/yr\":\"\"}</span></div></div>`:`<div class=\"pick empty\"><i>${k+1}</i><div><b>Not chosen</b><span>Tick \"Price it\" on an IDEAL client</span></div></div>`).join(\"\");\n  $(\"picksNote\").textContent=p.length?`These ${p.length===1?\"client appears\":\"clients appear\"} in the \"Pricing for\" list in Homework 2 (True Cost) and Homework 3 (Firm Cost) when you open them in this browser.`:(ideals.length?\"Tick \\\"Price it\\\" on up to three IDEAL clients.\":\"No IDEAL clients yet. Score your book, or look for DEVELOP clients you could move to IDEAL.\");\n  try{localStorage.setItem(IDEALKEY,JSON.stringify(p.map(c=>({name:c.name,industry:c.industry||\"\",fee:+c.fee||0,value:+c.value,effort:+c.effort}))));}catch(e){}\n  // plan\n  const by=q=>sc.filter(x=>x.q===q).map(x=>x.c).sort((a,b)=>(+b.value-+a.value)||((+b.fee||0)-(+a.fee||0)));\n  const I=by(\"IDEAL\"),D=by(\"DEVELOP\"),E=by(\"EXIT\").sort((a,b)=>(+b.effort-+a.effort)),A=by(\"AUTOMATE\");\n  const li=a=>a.map(t=>`<li>${esc(t)}</li>`).join(\"\");\n  $(\"pWeek\").innerHTML=li([\n    p[0]?`Run Homework 2 (True Cost) for ${p[0].name}.`:(I[0]?`Tick \"Price it\" on ${I[0].name} and run Homework 2.`:\"Score your top 10 clients.\"),\n    E[0]?`Review the engagement with ${E[0].name}: reprice or plan the exit.`:\"Note which clients drain the most time.\",\n    \"Document current processes for your IDEAL clients.\"]);\n  $(\"p30\").innerHTML=li([\n    `Approach ${Math.min(3,Math.max(p.length,I.length))||\"your top\"} IDEAL client${Math.min(3,Math.max(p.length,I.length))===1?\"\":\"s\"} with a fixed-fee advisory proposal.`,\n    D[0]?`Set clear scope with ${D[0].name} to cut effort and move them toward IDEAL.`:\"Standardize your service offerings.\",\n    A.length?`Systematize the ${A.length} AUTOMATE client${A.length===1?\"\":\"s\"}: apps, templates, outsourced preparers.`:\"Set up the technology stack for recurring work.\"]);\n  $(\"p90\").innerHTML=li([\n    `Convert ${Math.min(5,I.length)||\"your first\"} IDEAL client${Math.min(5,I.length)===1?\"\":\"s\"} to monthly advisory.`,\n    E.length?`Exit or transition ${Math.min(3,E.length)} EXIT client${Math.min(3,E.length)===1?\"\":\"s\"} over 60–90 days.`:\"Keep the EXIT quadrant empty: screen new clients on value and effort.\",\n    \"Pick the vertical that shows up most among your IDEAL clients.\"]);\n  save();\n}\n$(\"add\").onclick=()=>{S.clients.push(C(\"\",\"\",null,null,null));mine();renderRows();calc();const el=$(\"name\"+(S.clients.length-1));el.focus();};\nlet armed=null;\nfunction confirmBtn(btn,label,fn){if(armed===btn){armed=null;fn();return;}armed=btn;const old=btn.textContent;btn.textContent=label;setTimeout(()=>{if(armed===btn){armed=null;btn.textContent=old;}},3500);}\n$(\"startOwn\").onclick=function(){const b=this;if(S.sample){S=clone(BLANK);init();return;}confirmBtn(b,\"Clear my book? Click again\",()=>{S=clone(BLANK);b.textContent=\"Start my own book\";init();});};\n$(\"loadSample\").onclick=function(){const b=this;if(S.sample){init();return;}confirmBtn(b,\"Replace my book? Click again\",()=>{S=clone(SAMPLE);b.textContent=\"Load sample\";init();});};\nfunction csv(){const L=[\"Client,Industry,Annual fees,Value,Effort,Quadrant,Price it\"];\n  S.clients.forEach(c=>{const q=quad(c);if(!c.name)return;L.push([`\"${c.name.replace(/\"/g,'\"\"')}\"`,`\"${c.industry||\"\"}\"`,c.fee||\"\",c.value||\"\",c.effort||\"\",q||\"\",c.pick&&q===\"IDEAL\"?\"Y\":\"\"].join(\",\"));});return L.join(\"\\n\");}\n$(\"copyCsv\").onclick=async()=>{const t=csv();try{await navigator.clipboard.writeText(t);toast(\"Copied. Paste into Excel or Google Sheets.\");}catch(e){const b=$(\"copybox\");b.value=t;b.select();try{document.execCommand(\"copy\");toast(\"Copied. Paste into Excel or Google Sheets.\");}catch(_){toast(\"Copy is blocked here.\");}}};\nwindow.bnMatrixCsv=csv;\nfunction toast(m){$(\"toast\").textContent=m;setTimeout(()=>$(\"toast\").textContent=\"\",3500);}\nfunction init(){sampleMsg();renderRows();calc();}\nS=load(); init();\n})();\n</script>\n\n</body>\n</html>\n"
  },
  "source": "Session_4_Interactive_Client_Matrix.html (2025)"
}