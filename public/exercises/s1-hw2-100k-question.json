    "selfContained": true,
    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>The $100K Question</title>\n<style>\n/* Layout: brand gradient field; scenario band, four boxes + Box 5 left, live analysis rail right, commitment below */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69;\n  --stop:#C53030; --stopBg:#FDECEC; --out:#C05621; --outBg:#FEF0E3; --auto:#3182CE; --autoBg:#EBF4FF; --focus:#2F855A; --focusBg:#E8F6EE;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1300px;margin:0 auto;padding-block:20px 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:62ch;opacity:.92}\n.sample{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:10px 14px;color:var(--white);font-size:13.5px}\n.sample b{color:var(--gold)}\n.btn{border:none;border-radius:999px;padding:8px 16px;font:inherit;font-weight:700;font-size:13.5px;cursor:pointer}\n.btn:focus-visible,input:focus-visible,select:focus-visible,.pill:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.light{background:var(--white);color:var(--deep)}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.7)}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.teal{background:var(--teal);color:#0E4A45}\n.btn.gold{background:var(--gold);color:#3D2C05}\n.scenario{background:var(--deep);color:var(--white);border-radius:16px;padding:18px 22px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;box-shadow:0 12px 32px rgba(40,25,90,.22)}\n.scenario .lbl{font-size:12px;font-weight:700;letter-spacing:.18em;color:var(--teal)}\n.scenario q{display:block;font-size:clamp(16px,2vw,19px);font-style:italic;max-width:80ch;quotes:\"\\201C\" \"\\201D\"}\n.scenario q b{color:var(--gold);font-style:normal}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.main{padding:20px 22px 22px;display:flex;flex-direction:column;gap:16px}\n.pullbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:#E9FBF9;border-radius:12px;padding:10px 14px;font-size:13.5px;color:var(--tealInk)}\n.boxes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.box{border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:8px;min-width:0;border:1.5px solid transparent}\n.box h3{margin:0;display:flex;align-items:center;gap:10px;font-size:16px}\n.box h3 .n{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;color:var(--white);font-weight:800;flex:none}\n.box h3 small{margin-left:auto;font-size:12px;font-weight:700;color:var(--mute)}\n.box .hint{font-size:12.5px;color:var(--mute);margin-top:-4px}\n.b-stop{background:var(--stopBg);border-color:#F5B5B5}.b-stop .n{background:var(--stop)}\n.b-out{background:var(--outBg);border-color:#F6C79D}.b-out .n{background:var(--out)}\n.b-auto{background:var(--autoBg);border-color:#B3D4F5}.b-auto .n{background:var(--auto)}\n.b-focus{background:var(--focusBg);border-color:#A9DCC0}.b-focus .n{background:var(--focus)}\n.items{display:flex;flex-direction:column;gap:6px}\n.item{display:flex;gap:6px;align-items:center}\n.item input{flex:1;min-width:0;font:inherit;font-size:14px;border:1.5px solid var(--line);border-radius:8px;padding:7px 10px;background:var(--white);color:var(--ink)}\n.item input:focus{border-color:var(--purple);outline:none}\n.item .src{font-size:10.5px;font-weight:800;letter-spacing:.06em;border-radius:999px;padding:2px 7px;background:var(--white);color:var(--mute);flex:none}\n.del{border:none;background:transparent;color:var(--stop);font-weight:800;cursor:pointer;font-size:16px;padding:2px 6px;border-radius:6px;flex:none}\n.add{border:1.5px dashed rgba(0,0,0,.18);background:rgba(255,255,255,.6);border-radius:8px;padding:6px;font:inherit;font-size:13px;color:var(--mute);cursor:pointer}\n.box5{border-radius:14px;padding:18px;background:linear-gradient(135deg,var(--purple),var(--deep));color:var(--white);display:flex;flex-direction:column;gap:10px}\n.box5 h3{margin:0;font-size:18px;display:flex;gap:10px;align-items:center}\n.box5 h3 .n{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--gold);color:#3D2C05;font-weight:800}\n.box5 p{margin:0;opacity:.9;font-size:13.5px}\n.box5 textarea{font:inherit;font-size:18px;font-weight:700;color:var(--deep);border:none;border-radius:10px;padding:12px 14px;resize:vertical;min-height:64px;width:100%}\n.pills{display:flex;flex-wrap:wrap;gap:6px}\n.pill{border:1.5px solid rgba(255,255,255,.45);background:rgba(255,255,255,.12);color:var(--white);border-radius:999px;padding:4px 12px;font:inherit;font-size:13px;cursor:pointer}\n.checks{display:flex;flex-wrap:wrap;gap:6px}\n.chip{font-size:12px;font-weight:700;border-radius:999px;padding:3px 10px;background:rgba(255,255,255,.14)}\n.chip.ok{background:#C6F0D8;color:#22543D}.chip.warn{background:#FED7D7;color:#822727}\n/* rail */\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:18px;display:flex;flex-direction:column;gap:12px;background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.rail .lbl{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:700;text-transform:uppercase}\n.counts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}\n.counts div{border-radius:10px;padding:8px 4px;text-align:center;background:rgba(255,255,255,.08)}\n.counts b{display:block;font-size:22px;font-variant-numeric:tabular-nums}\n.counts span{font-size:10.5px;letter-spacing:.06em;opacity:.85}\n.bars{display:flex;align-items:flex-end;gap:10px;height:120px;padding:0 4px;border-bottom:1px solid rgba(255,255,255,.2)}\n.bars div{flex:1;border-radius:8px 8px 0 0;min-height:4px;transition:height .3s}\n.blabels{display:flex;gap:10px;padding:0 4px;font-size:10.5px;letter-spacing:.06em;opacity:.85}\n.blabels span{flex:1;text-align:center}\n.hours{background:rgba(255,255,255,.08);border-radius:10px;padding:10px 12px;font-size:13px}\n.hours b{display:block;font-size:22px;color:var(--gold);font-variant-numeric:tabular-nums}\n.ins{display:flex;flex-direction:column;gap:6px}\n.ins div{background:rgba(230,180,80,.16);border-radius:10px;padding:8px 10px;font-size:13px}\n.rail .btn{width:100%}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n/* commitment */\n.commit{padding:18px 22px 22px;display:flex;flex-direction:column;gap:12px}\n.commit h2{margin:0;font-size:19px;color:var(--purple)}\n.cform{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}\n.f{display:flex;flex-direction:column;gap:4px;min-width:0}\n.f label{font-weight:700;font-size:13.5px}\n.f input,.f select{font:inherit;font-size:14.5px;border:1.5px solid var(--line);border-radius:10px;padding:8px 10px;background:var(--white);color:var(--ink);width:100%}\n.statement{background:#FBF1DC;border-radius:12px;padding:14px 16px;font-size:15px;line-height:1.6}\n.statement b{color:var(--deep)}\n.row{display:flex;gap:8px;flex-wrap:wrap}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\ntextarea.copybox{position:absolute;left:-9999px;top:0;width:1px;height:1px}\n@media (max-width:1060px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:720px){.boxes,.cform{grid-template-columns:minmax(0,1fr)}.main,.commit{padding:16px}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n\n<style id=\"bn-restyle\">\n/* ============================================================\n   bn-restyle v2 · BOLD visual refresh. Appearance only. Appended\n   last in <head>. No transform/filter/backdrop-filter/will-change\n   on body or any tall/large container; big surfaces animate via\n   opacity / background-position / box-shadow only. Small transient\n   transforms live only on button/chip hover+press. Dark text on\n   light surfaces preserved. Motion gated by prefers-reduced-motion.\n   ============================================================ */\n@media screen {\n  :root {\n    --ink:#1b2130;                      /* deeper body text: max contrast */\n    --bnE:cubic-bezier(.22,.9,.3,1);\n    --bnCard:0 2px 4px rgba(26,14,54,.10), 0 20px 44px -18px rgba(52,22,92,.50), 0 44px 90px -46px rgba(34,14,70,.60);\n    --bnLift:0 18px 38px -14px rgba(44,18,86,.58), 0 4px 12px -6px rgba(44,18,86,.30);\n    --bnGradPrimary:linear-gradient(135deg,#8E6BE6 0%,#6C45C0 54%,#4A2C94 100%);\n    --bnGradTeal:linear-gradient(135deg,#6BE8DF 0%,#2FBBB0 100%);\n    --bnGradGold:linear-gradient(135deg,#FFDE8A 0%,#E6B450 100%);\n    --bnGradHead:linear-gradient(100deg,#FFE3A8 0%,#FFFFFF 46%,#8FE9E1 100%);\n  }\n  /* ---- Dramatic multi-stop field + big soft glow accents ---- */\n  /* min-height:0 neutralises the exercise's own body{min-height:100vh}: inside\n     the auto-resizing iframe, 100vh equals the iframe height, so a shorter step\n     could never report less height than the current (taller) iframe, leaving a\n     big empty tail. Measuring real content height lets the iframe shrink back.\n     html bg matches the field so the iframe's min-height floor never flashes. */\n  html { background-color:#20143E !important; }\n  body {\n    min-height:0 !important;\n    background-color:#20143E !important;\n    background-image:\n      radial-gradient(1000px 560px at 4% -10%, rgba(126,140,255,.42), transparent 60%),\n      radial-gradient(880px 560px at 118% 2%, rgba(188,120,236,.40), transparent 58%),\n      radial-gradient(820px 680px at 50% 120%, rgba(78,205,196,.22), transparent 60%),\n      linear-gradient(165deg,#3B2F86 0%,#4B2A7C 30%,#3A1C68 62%,#20143E 100%) !important;\n    background-attachment:scroll !important;\n  }\n  /* ---- Bigger, bolder headings; gradient title on the dark header ---- */\n  h1 { font-weight:800 !important; letter-spacing:-.015em !important;\n       font-size:clamp(29px,4.4vw,42px) !important; }\n  h2 { font-weight:800 !important; }\n  .eyebrow { letter-spacing:.26em !important; font-weight:800 !important; }\n  /* Gradient-text only for the header title (always on the dark field), with a\n     light gradient so contrast stays high; guarded so unsupported browsers keep\n     the solid white title. */\n  @supports ((-webkit-background-clip:text) or (background-clip:text)) {\n    header.top h1, .top h1 {\n      background:var(--bnGradHead);\n      -webkit-background-clip:text; background-clip:text;\n      -webkit-text-fill-color:transparent; color:transparent;\n    }\n  }\n  /* ---- PROMINENT cards: big radius, strong layered shadow, hairline edge ---- */\n  .panel, .card, .rail, .poster, .callout, .scenario, .box5, .tip, .copybox, .sample {\n    border-radius:22px !important;\n  }\n  .panel, .poster {\n    box-shadow:var(--bnCard) !important;\n    border:1px solid rgba(255,255,255,.16) !important;\n  }\n  .card, .qbox, .box, .role, .person, .callout, .tip {\n    box-shadow:0 12px 30px -16px rgba(40,18,80,.5) !important;\n  }\n  /* ---- Compositing-safe transitions (exercise disables these under reduced motion) ---- */\n  .btn, .tab, .lt, .chip, .pill, .svc, .card, .qbox, .box, .role, .person, .rrow,\n  .trow, .star, .starbtn, button, input, select, textarea, a {\n    transition:transform .15s var(--bnE), box-shadow .26s var(--bnE),\n      background-color .22s var(--bnE), border-color .2s var(--bnE), color .16s var(--bnE) !important;\n  }\n  /* ---- BOLD pill buttons: gradient fills, hover lift+scale, press (small elems) ---- */\n  .btn { border-radius:999px !important; font-weight:800 !important; letter-spacing:.01em;\n         box-shadow:0 8px 18px -9px rgba(26,12,58,.55); }\n  .btn:hover  { transform:translateY(-2px) scale(1.03); box-shadow:0 18px 34px -12px rgba(44,18,86,.6); }\n  .btn:active { transform:translateY(0) scale(.955); }\n  .btn:disabled { opacity:.5 !important; transform:none !important; box-shadow:none !important; }\n  .btn.primary { background:var(--bnGradPrimary) !important; color:#fff !important; border:none !important; }\n  .btn.teal    { background:var(--bnGradTeal) !important; color:#06312D !important; border:none !important; }\n  .btn.gold    { background:var(--bnGradGold) !important; color:#3D2C05 !important; border:none !important; }\n  /* ---- Medium cards: shadow-only hover pop (never transform big surfaces) ---- */\n  .card:hover, .qbox:hover, .svc:hover, .role:hover, .person:hover, .rrow:hover, .trow:hover, .pi:hover {\n    box-shadow:var(--bnLift) !important;\n  }\n  /* ---- Inputs: rounded with a strong brand focus ring ---- */\n  input, select, textarea { border-radius:12px !important; }\n  input:focus, select:focus, textarea:focus {\n    border-color:var(--purple) !important;\n    box-shadow:0 0 0 3px rgba(118,75,162,.30) !important; outline:none !important;\n  }\n  /* ---- Modern chips/badges: pill, gradient-ready, glow+scale on hover ---- */\n  .chip, .pill { border-radius:999px !important; font-weight:800 !important;\n                 box-shadow:0 2px 9px -3px rgba(40,18,80,.42); }\n  .chip:hover, .pill:hover { transform:translateY(-1px) scale(1.06);\n                 box-shadow:0 10px 18px -6px rgba(40,18,80,.5); }\n  /* ---- Tabs: bold, gold underline + glow on the active tab ---- */\n  .tab { font-weight:800 !important; }\n  .tab:hover { color:var(--deep) !important; }\n  .tab[aria-selected=\"true\"], .tab.active {\n    color:var(--deep) !important;\n    box-shadow:inset 0 -3px 0 0 var(--gold), 0 8px 20px -8px rgba(230,180,80,.55);\n  }\n  /* ---- Animated meter / progress-bar fills (width only) ---- */\n  .track i, .bar i, .meter i, .bars i, .stack i, .meter > span {\n    transition:width .75s var(--bnE), background-color .3s var(--bnE) !important;\n  }\n}\n/* ============ lively motion — all disabled under reduced motion ============ */\n@media screen and (prefers-reduced-motion: no-preference) {\n  @keyframes bnFade { from { opacity:0; } to { opacity:1; } }\n  @keyframes bnGlow {\n    0%,100% { box-shadow:inset 0 -3px 0 0 var(--gold), 0 8px 18px -10px rgba(230,180,80,.40); }\n    50%     { box-shadow:inset 0 -3px 0 0 var(--gold), 0 12px 28px -8px rgba(230,180,80,.80); }\n  }\n  @keyframes bnSheen {\n    0%   { background-position:0% 50%, 100% 50%, 50% 100%, 0 0; }\n    100% { background-position:26% 42%, 74% 58%, 50% 88%, 0 0; }\n  }\n  /* Entrance = OPACITY fade on CONTAINERS (not re-rendered items → no flicker),\n     lightly staggered. Big surfaces, opacity only — compositing-safe. */\n  .top, header.top, .panel, .rail, .scenario, .poster, .callout, .step {\n    animation:bnFade .6s var(--bnE) both;\n  }\n  .grid > *:nth-child(2)  { animation-delay:.08s; }\n  .grid > *:nth-child(3)  { animation-delay:.16s; }\n  .rail { animation-delay:.14s; }\n  /* Ambient: slow glow drift (background-position only — never transform). */\n  body { animation:bnSheen 30s ease-in-out infinite alternate; }\n  /* Active tab: gentle pulsing glow (box-shadow only). */\n  .tab[aria-selected=\"true\"], .tab.active { animation:bnGlow 2.8s ease-in-out infinite; }\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">From Scorekeeper to Strategist · Session 1 · Homework 2</div>\n      <h1>The $100K Question</h1>\n      <p>Design the practice you'd build if money weren't the constraint. Sort your work into four boxes, then write the one sentence that makes you irreplaceable.</p>\n    </div>\n    <div class=\"sample\">\n      <span id=\"sampleMsg\"></span>\n      <button class=\"btn light\" type=\"button\" id=\"startOwn\">Start my own</button>\n      <button class=\"btn ghost\" type=\"button\" id=\"loadSample\">Load sample</button>\n    </div>\n  </header>\n\n  <section class=\"scenario\">\n    <div class=\"lbl\">THE SCENARIO</div>\n    <q>A client walks in tomorrow and says: <b>\"Here's $100,000.</b> I want to hire you for a year. But you can <b>ONLY do work you love.</b> Outsource everything else. Design the perfect service package.\" What would you create?</q>\n  </section>\n\n  <div class=\"grid\">\n    <main class=\"panel main\">\n      <div class=\"pullbar\" id=\"pullbar\" hidden><span id=\"pullTxt\"></span><button class=\"btn teal\" type=\"button\" id=\"pull\">Fill the boxes from my traffic lights</button></div>\n      <div class=\"boxes\" id=\"boxes\"></div>\n      <div class=\"box5\">\n        <h3><span class=\"n\">5</span>My unique value is…</h3>\n        <p>In one sentence, what makes you irreplaceable? Specific enough that a stranger would understand it.</p>\n        <textarea id=\"box5\" aria-label=\"My unique value\" placeholder=\"I'm the only one who can…\"></textarea>\n        <div class=\"pills\" id=\"pills\"></div>\n        <div class=\"checks\" id=\"checks\"></div>\n      </div>\n    </main>\n\n    <aside class=\"panel rail\" aria-label=\"Your practice analysis\">\n      <div class=\"lbl\">Your practice analysis</div>\n      <div class=\"counts\" id=\"counts\"></div>\n      <div class=\"bars\" id=\"bars\"></div>\n      <div class=\"blabels\"><span>STOP</span><span>OUTSOURCE</span><span>AUTOMATE-AI</span><span>FOCUS</span></div>\n      <div class=\"hours\" id=\"hours\"></div>\n      <div class=\"ins\" id=\"ins\"></div>\n      <button class=\"btn teal\" type=\"button\" id=\"copyAll\">Copy my five boxes</button>\n      <div class=\"toast\" id=\"toast\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n\n  <section class=\"panel commit\" aria-label=\"30-day commitment\">\n    <h2>My 30-day commitment</h2>\n    <div class=\"cform\">\n      <div class=\"f\"><label for=\"cdate\">By this date</label><input type=\"date\" id=\"cdate\"></div>\n      <div class=\"f\"><label for=\"cstop\">I will stop doing</label><select id=\"cstop\"></select></div>\n      <div class=\"f\"><label for=\"cmethod\">By</label><select id=\"cmethod\"></select></div>\n      <div class=\"f\"><label for=\"cfocus\">And start focusing on</label><select id=\"cfocus\"></select></div>\n      <div class=\"f\"><label for=\"cpartner\">My accountability partner</label><input type=\"text\" id=\"cpartner\" placeholder=\"Name\"></div>\n      <div class=\"f\"><label for=\"ccheck\">Our check-in date</label><input type=\"date\" id=\"ccheck\"></div>\n    </div>\n    <div class=\"statement\" id=\"statement\"></div>\n    <div class=\"row\"><button class=\"btn gold\" type=\"button\" id=\"copyCommit\">Copy my commitment</button><button class=\"btn soft\" type=\"button\" id=\"copyPartner\">Copy a note to my partner</button><button class=\"btn soft\" type=\"button\" onclick=\"(function(){var b=new Blob([window.bn100kText()],{type:'text/plain'});var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='100k_question.txt';document.body.appendChild(a);a.click();a.remove();})()\">Download my answers</button>\n<button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button></div>\n  </section>\n  <div class=\"foot\">From Scorekeeper to Strategist · Session 1: Your Vision, Your Team · Beyond Numbers · Your Box 5 sentence carries into the Team Purpose Map (Homework 4).</div>\n</div>\n<textarea class=\"copybox\" id=\"copybox\" aria-hidden=\"true\" tabindex=\"-1\"></textarea>\n\n<script>\n(function(){\nconst BOX=[[\"stop\",\"b-stop\",\"I would STOP…\",\"Work that makes your soul die a little\"],[\"outsource\",\"b-out\",\"I would OUTSOURCE…\",\"Needs doing, but not by you\"],[\"automate\",\"b-auto\",\"I would AUTOMATE-AI…\",\"Technology should handle this\"],[\"focus\",\"b-focus\",\"I would FOCUS ON…\",\"Your zone of genius\"]];\nconst COLORS={stop:\"var(--stop)\",outsource:\"var(--out)\",automate:\"var(--auto)\",focus:\"var(--focus)\"};\nconst METHODS=[\"eliminating it completely\",\"outsourcing it to an offshore or virtual team\",\"hiring a virtual assistant\",\"partnering with another firm\",\"referring it to a specialist\",\"automating it with software\",\"delegating it to a team member\",\"phasing it out gradually\",\"repricing it\"];\nconst STARTERS=[\"I'm the only one who can \",\"I help [client type] do [specific outcome] by \",\"I transform complex financial data into \",\"I help business owners sleep better by \",\"I'm the bridge between \"];\nconst GENERIC=[\"succeed\",\"success\",\"excellence\",\"excellent\",\"best\",\"quality\",\"solutions\",\"world-class\",\"businesses\",\"value-added\",\"exceed\",\"innovative\"];\nconst KEY=\"bn-100k-v1\", OUT=\"bn-100k\", TL=\"bn-traffic-light\";\nconst it=(t,src)=>({t,src:src||\"\"});\nconst SAMPLE={sample:true,stop:[it(\"Paper pickup and bank runs\"),it(\"IRS correspondence for 1040 clients\"),it(\"Clients who argue every invoice\")],\n outsource:[it(\"Bank and credit card reconciliations\"),it(\"Accounts payable data entry\"),it(\"1040 preparation\")],\n automate:[it(\"Receipt scanning\"),it(\"Monthly P&L statements\"),it(\"Payroll entries\")],\n focus:[it(\"Cash flow forecasting\"),it(\"Fractional CFO for construction firms\"),it(\"Software implementation\")],\n box5:\"I help family-owned trade businesses see the next 12 months clearly enough to make their next big decision with confidence.\",\n commit:{date:\"\",stop:\"Paper pickup and bank runs\",method:\"automating it with software\",focus:\"Cash flow forecasting\",partner:\"\",check:\"\"}};\nconst BLANK={sample:false,stop:[it(\"\")],outsource:[it(\"\")],automate:[it(\"\")],focus:[it(\"\")],box5:\"\",commit:{date:\"\",stop:\"\",method:METHODS[0],focus:\"\",partner:\"\",check:\"\"}};\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??\"\").replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst clone=o=>JSON.parse(JSON.stringify(o));\nconst plus=d=>{const x=new Date();x.setDate(x.getDate()+d);return x.toISOString().slice(0,10);};\nlet S;\nfunction load(){try{const r=localStorage.getItem(KEY);if(r)return JSON.parse(r);}catch(e){}return clone(SAMPLE);}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}\nfunction mine(){if(S.sample){S.sample=false;sampleMsg();}}\nfunction sampleMsg(){$(\"sampleMsg\").innerHTML=S.sample?\"<b>Sample answers loaded.</b> Explore them, then start your own.\":\"<b>Your answers</b> save in this browser as you type.\";}\nconst filled=k=>S[k].map(x=>x.t.trim()).filter(Boolean);\n\nfunction renderBoxes(){\n  $(\"boxes\").innerHTML=BOX.map(([k,cls,title,hint],bi)=>`<div class=\"box ${cls}\"><h3><span class=\"n\">${bi+1}</span>${title}<small id=\"cnt_${k}\"></small></h3><div class=\"hint\">${hint}</div>\n   <div class=\"items\">${S[k].map((x,i)=>`<div class=\"item\"><input id=\"${k}${i}\" data-k=\"${k}\" data-i=\"${i}\" value=\"${esc(x.t)}\" placeholder=\"${hint}…\" aria-label=\"${title} item ${i+1}\">${x.src?`<span class=\"src\">${esc(x.src)}</span>`:\"\"}<button class=\"del\" type=\"button\" data-k=\"${k}\" data-del=\"${i}\" aria-label=\"Remove\">×</button></div>`).join(\"\")}</div>\n   <button class=\"add\" type=\"button\" data-add=\"${k}\">+ Add another</button></div>`).join(\"\");\n  $(\"boxes\").querySelectorAll(\"input[data-k]\").forEach(el=>{el.oninput=()=>{S[el.dataset.k][+el.dataset.i].t=el.value;mine();calc();};\n    el.onkeydown=e=>{if(e.key===\"Enter\"){e.preventDefault();addItem(el.dataset.k);}};});\n  $(\"boxes\").querySelectorAll(\"[data-del]\").forEach(b=>b.onclick=()=>{const k=b.dataset.k;S[k].splice(+b.dataset.del,1);if(!S[k].length)S[k].push(it(\"\"));mine();renderBoxes();calc();});\n  $(\"boxes\").querySelectorAll(\"[data-add]\").forEach(b=>b.onclick=()=>addItem(b.dataset.add));\n}\nfunction addItem(k){S[k].push(it(\"\"));mine();renderBoxes();calc();const el=$(k+(S[k].length-1));if(el)el.focus();}\n\n$(\"pills\").innerHTML=STARTERS.map((s,i)=>`<button type=\"button\" class=\"pill\" data-s=\"${i}\">\"${esc(s.trim())}…\"</button>`).join(\"\");\n$(\"pills\").querySelectorAll(\".pill\").forEach(p=>p.onclick=()=>{const t=$(\"box5\");t.value=STARTERS[+p.dataset.s];S.box5=t.value;t.focus();t.setSelectionRange(t.value.length,t.value.length);mine();calc();});\n$(\"box5\").oninput=()=>{S.box5=$(\"box5\").value;mine();calc();};\n\nfunction box5Checks(){\n  const t=S.box5.trim(),w=t.split(/\\s+/).filter(Boolean),o=[];\n  if(!w.length){$(\"checks\").innerHTML='<span class=\"chip\">Start writing to see checks</span>';return 0;}\n  let ok=0;\n  if(/\\[.*\\]/.test(t)){o.push('<span class=\"chip warn\">Replace the [brackets] with your own words</span>');}\n  const g=GENERIC.filter(x=>w.some(y=>y.toLowerCase().replace(/[^a-z-]/g,\"\")===x));\n  o.push(g.length?`<span class=\"chip warn\">\"${g.join('\", \"')}\" could describe any firm</span>`:(ok++,'<span class=\"chip ok\">✓ No generic words</span>'));\n  o.push(w.length>=10&&w.length<=30?(ok++,`<span class=\"chip ok\">✓ ${w.length} words</span>`):`<span class=\"chip warn\">${w.length} words · aim for 10–30</span>`);\n  const who=/\\b(owners?|founders?|firms?|families|family|companies|restaurants?|contractors?|builders?|dentists?|doctors?|non-?profits?|wineries|retailers?|agencies|clients? who|businesses that|trade|practices|startups?|start-ups?)\\b/i.test(t);\n  o.push(who?(ok++,'<span class=\"chip ok\">✓ Names who you serve</span>'):'<span class=\"chip warn\">Name who you serve</span>');\n  $(\"checks\").innerHTML=o.join(\"\");return ok;\n}\nfunction calc(){\n  const c={};BOX.forEach(([k])=>{c[k]=filled(k).length;const el=$(\"cnt_\"+k);if(el)el.textContent=c[k]?c[k]+\" item\"+(c[k]===1?\"\":\"s\"):\"\";});\n  $(\"counts\").innerHTML=BOX.map(([k])=>`<div><b>${c[k]}</b><span>${k.toUpperCase()}</span></div>`).join(\"\");\n  const mx=Math.max(1,...Object.values(c));\n  $(\"bars\").innerHTML=BOX.map(([k])=>`<div style=\"height:${c[k]/mx*100}%;background:${COLORS[k]}\" title=\"${k} ${c[k]}\"></div>`).join(\"\");\n  let tl=null;try{tl=JSON.parse(localStorage.getItem(TL)||\"null\");}catch(e){}\n  const handed=(tl&&tl.items)?tl.items.filter(x=>[...filled(\"stop\"),...filled(\"outsource\"),...filled(\"automate\")].includes(x.name)).reduce((a,x)=>a+x.pct/100*(tl.weekHrs||0),0):0;\n  $(\"hours\").innerHTML=tl&&tl.items&&tl.items.length?`<b>${handed.toFixed(1)} h/wk</b>freed by the items in boxes 1–3 that came from your traffic lights (of ${tl.weekHrs} working hours)`:`<b>–</b>Complete Homework 1 (Traffic Light) in this browser to see the hours your boxes free up.`;\n  const I=[];\n  if(c.stop>c.focus&&c.focus>0) I.push(\"More to stop than to focus on. You're ready to simplify.\");\n  if(c.focus>=3) I.push(`${c.focus} focus areas: these could become your signature services.`);\n  if(c.outsource+c.automate>=5) I.push(`${c.outsource+c.automate} items to outsource or automate. Each one is capacity for advisory work.`);\n  if(c.stop===0&&c.focus>0) I.push(\"What will you stop to make room for your focus areas?\");\n  const q=box5Checks();\n  if(S.box5.trim()&&q===3) I.push(\"Your Box 5 sentence passes all three checks. It goes into your Team Purpose Map.\");\n  $(\"ins\").innerHTML=I.map(x=>`<div>${esc(x)}</div>`).join(\"\")||\"<div>Fill the boxes to see insights.</div>\";\n  // commitment\n  const st=filled(\"stop\"),fo=filled(\"focus\");\n  const opt=(arr,sel,ph)=>`<option value=\"\">${ph}</option>`+arr.map(x=>`<option${x===sel?\" selected\":\"\"}>${esc(x)}</option>`).join(\"\");\n  if(!S.commit.date)S.commit.date=plus(30);\n  if(!S.commit.check)S.commit.check=plus(30);\n  $(\"cdate\").value=S.commit.date;$(\"ccheck\").value=S.commit.check;$(\"cpartner\").value=S.commit.partner;\n  if(document.activeElement!==$(\"cstop\"))$(\"cstop\").innerHTML=opt(st,S.commit.stop,\"Choose from your STOP box\");\n  if(document.activeElement!==$(\"cfocus\"))$(\"cfocus\").innerHTML=opt(fo,S.commit.focus,\"Choose from your FOCUS box\");\n  if(document.activeElement!==$(\"cmethod\"))$(\"cmethod\").innerHTML=METHODS.map(m=>`<option${m===S.commit.method?\" selected\":\"\"}>${m}</option>`).join(\"\");\n  $(\"statement\").innerHTML=commitHTML();\n  try{localStorage.setItem(OUT,JSON.stringify({box5:S.box5.trim(),stop:st,outsource:filled(\"outsource\"),automate:filled(\"automate\"),focus:fo,at:Date.now()}));}catch(e){}\n  save();\n}\nconst fmtD=d=>{if(!d)return\"____\";const x=new Date(d+\"T12:00:00\");return x.toLocaleDateString(\"en-US\",{month:\"long\",day:\"numeric\",year:\"numeric\"});};\nfunction commitHTML(){const c=S.commit;return `By <b>${fmtD(c.date)}</b>, I will stop doing <b>${esc(c.stop||\"____\")}</b> by <b>${esc(c.method||\"____\")}</b>, and start focusing on <b>${esc(c.focus||\"____\")}</b>.${c.partner?` My accountability partner is <b>${esc(c.partner)}</b>; we check in on <b>${fmtD(c.check)}</b>.`:\"\"}`;}\n[\"cdate\",\"cstop\",\"cmethod\",\"cfocus\",\"cpartner\",\"ccheck\"].forEach(id=>$(id).addEventListener(id===\"cpartner\"?\"input\":\"change\",()=>{const m={cdate:\"date\",cstop:\"stop\",cmethod:\"method\",cfocus:\"focus\",cpartner:\"partner\",ccheck:\"check\"};S.commit[m[id]]=$(id).value;mine();$(\"statement\").innerHTML=commitHTML();save();}));\n\nfunction checkPull(){\n  let tl=null;try{tl=JSON.parse(localStorage.getItem(TL)||\"null\");}catch(e){}\n  if(!tl||!tl.items||!tl.items.length){$(\"pullbar\").hidden=true;return;}\n  const r=tl.items.filter(x=>x.light===\"red\").length,y=tl.items.filter(x=>x.light===\"yellow\").length,g=tl.items.filter(x=>x.light===\"green\").length;\n  $(\"pullbar\").hidden=false;$(\"pullTxt\").textContent=`Homework 1 found: ${r} RED, ${y} YELLOW, ${g} GREEN services.`;\n  $(\"pull\").onclick=()=>{\n    const route=x=>{if(x.light===\"green\")return(x.quadrant===\"catalyst\"||x.quadrant===\"strategist\"||x.action===\"Grow\")?\"focus\":null;\n      if(x.action===\"Automate\")return\"automate\";if(x.action===\"Outsource\"||x.action===\"Delegate\")return\"outsource\";\n      if(x.action===\"Eliminate\")return\"stop\";return x.light===\"red\"?\"stop\":\"outsource\";};\n    let added=0;\n    tl.items.forEach(x=>{const k=route(x);if(!k)return;if(BOX.some(([b])=>filled(b).includes(x.name)))return;\n      S[k]=S[k].filter(v=>v.t.trim());S[k].push(it(x.name,x.light.toUpperCase()));added++;});\n    BOX.forEach(([k])=>{if(!S[k].length)S[k].push(it(\"\"));});\n    mine();renderBoxes();calc();toast(added?`Added ${added} item${added===1?\"\":\"s\"} from your traffic lights.`:\"Those items are already in your boxes.\");};\n}\nfunction allText(){const L=[\"THE $100K QUESTION\",\"\"];BOX.forEach(([k,,title])=>{L.push(title.toUpperCase());filled(k).forEach((x,i)=>L.push(`  ${i+1}. ${x}`));L.push(\"\");});\n  L.push(\"BOX 5 · MY UNIQUE VALUE\",`  ${S.box5.trim()||\"(not yet written)\"}`,\"\",\"MY 30-DAY COMMITMENT\",`  ${$(\"statement\").textContent}`);return L.join(\"\\n\");}\nfunction partnerText(){return `Hi${S.commit.partner?\" \"+S.commit.partner:\"\"},\\n\\nI just finished the $100K Question exercise and I'd like you to be my accountability partner for the next 30 days.\\n\\nMy commitment: ${$(\"statement\").textContent}\\n\\nWhat I'm stopping: ${filled(\"stop\").join(\"; \")||\"(still deciding)\"}\\nWhat I'm focusing on: ${filled(\"focus\").join(\"; \")||\"(still deciding)\"}\\nMy unique value: ${S.box5.trim()||\"(still writing it)\"}\\n\\nCan we put a check-in on the calendar for ${fmtD(S.commit.check)}?\\n\\nThanks!`;}\nasync function copyText(t,msg){try{await navigator.clipboard.writeText(t);toast(msg);}catch(e){const b=$(\"copybox\");b.value=t;b.select();try{document.execCommand(\"copy\");toast(msg);}catch(_){toast(\"Copy is blocked here.\");}}}\n$(\"copyAll\").onclick=()=>copyText(allText(),\"Copied your five boxes.\");\n$(\"copyCommit\").onclick=()=>copyText($(\"statement\").textContent,\"Commitment copied.\");\n$(\"copyPartner\").onclick=()=>copyText(partnerText(),\"Note copied. Paste it into an email or text.\");\nwindow.bn100kText=allText;\nfunction toast(m){$(\"toast\").textContent=m;setTimeout(()=>$(\"toast\").textContent=\"\",3500);}\nlet armed=null;\nfunction confirmBtn(btn,label,fn){if(armed===btn){armed=null;fn();return;}armed=btn;const old=btn.textContent;btn.textContent=label;setTimeout(()=>{if(armed===btn){armed=null;btn.textContent=old;}},3500);}\n$(\"startOwn\").onclick=function(){const b=this;if(S.sample){S=clone(BLANK);init();return;}confirmBtn(b,\"Clear everything? Click again\",()=>{S=clone(BLANK);b.textContent=\"Start my own\";init();});};\n$(\"loadSample\").onclick=function(){const b=this;if(S.sample){init();return;}confirmBtn(b,\"Replace my answers? Click again\",()=>{S=clone(SAMPLE);b.textContent=\"Load sample\";init();});};\nfunction init(){sampleMsg();$(\"box5\").value=S.box5;renderBoxes();checkPull();calc();}\nS=load(); init();\n})();\n</script>\n\n</body>\n</html>\n"
  }
}
