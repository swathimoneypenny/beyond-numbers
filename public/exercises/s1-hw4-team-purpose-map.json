{
  "schemaVersion": "1.0",
  "id": "s1-hw4-team-purpose-map",
  "session": 1,
  "exercise": 4,
  "title": "Team Purpose Map",
  "type": "worksheet-tool",
  "summary": "Homework 4 for Session 1 (Your Vision, Your Team). Five steps: bring in Homework 1–3 results (Box 5 sentence, RED %, next-hire role); draft a purpose headline with live word-count and buzzword checks, a filter question and a four-point authenticity check; map every person to a role (BOS, Admin orchestrator, Business analyst, Technical team) with an 'I ___' headline, connecting line, stretch challenge and energizer flag, with role-coverage gaps; plan a one-on-one listening tour ordered energizers-first with dates, status and gold-nugget notes; and view a poster-style map with a Session 2 readiness checklist. Opens on a sample firm; autosaves in the browser; copy-as-text and print.",
  "interactive": true,
  "homework": true,
  "source": "Quinn & Thakor, 'Creating a Purpose-Driven Organization', HBR, July–August 2018",
  "brand": {
    "indigo": "#667EEA",
    "purple": "#764BA2",
    "deep": "#44337A",
    "gold": "#E6B450",
    "teal": "#4ECDC4",
    "gradient": [
      "#667EEA",
      "#764BA2"
    ],
    "font": "Calibri"
  },
  "embed": {
    "format": "html",
    "selfContained": true,
    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Team Purpose Map</title>\n<style>\n/* Layout: brand gradient field, white working panel with step tabs, sticky readiness rail on wide screens */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69; --coral:#E05D5D; --coralBg:#FDECEC; --green:#2F855A; --greenBg:#E8F6EE;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-display:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh;}\n.wrap{max-width:1280px;margin:0 auto;padding-block:20px 28px;\n  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));\n  display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-family:var(--f-display);font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0 6px;text-wrap:balance}\nheader.top p{margin:0;max-width:62ch;opacity:.92}\n.sample{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);\n  border-radius:12px;padding:10px 14px;color:var(--white);font-size:13.5px}\n.sample b{color:var(--gold)}\nbutton{font-family:inherit;cursor:pointer}\n.btn{border:none;border-radius:999px;padding:8px 16px;font-weight:700;font-size:13.5px}\n.btn:focus-visible,.tab:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.light{background:var(--white);color:var(--deep)}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.7)}\n.btn.primary{background:var(--purple);color:var(--white)}\n.btn.teal{background:var(--teal);color:#0E4A45}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.danger{background:transparent;color:var(--coral);padding:6px 10px}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;padding:10px;border-bottom:1px solid var(--line)}\n.tab{border:none;background:transparent;border-radius:10px;padding:8px 12px;font-weight:700;color:var(--mute);font-size:14px;display:flex;gap:8px;align-items:center}\n.tab .n{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--card);color:var(--deep);font-size:12px}\n.tab[aria-selected=\"true\"]{background:var(--card);color:var(--deep)}\n.tab[aria-selected=\"true\"] .n{background:var(--purple);color:var(--white)}\n.tab.done .n{background:var(--green);color:var(--white)}\n.step{padding:22px 24px 26px;display:flex;flex-direction:column;gap:18px}\n.step h2{margin:0;font-size:22px;color:var(--purple);text-wrap:balance}\n.lead{margin:-10px 0 0;color:var(--mute);font-style:italic;max-width:70ch}\n.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}\n.field{display:flex;flex-direction:column;gap:5px;min-width:0}\n.field.full{grid-column:1/-1}\nlabel,.lbl{font-weight:700;font-size:13.5px;color:var(--ink)}\n.hint{font-size:12.5px;color:var(--mute);font-weight:400}\ninput[type=text],input[type=date],input[type=number],textarea,select{width:100%;font:inherit;color:var(--ink);background:var(--white);\n  border:1.5px solid var(--line);border-radius:10px;padding:9px 11px}\ntextarea{resize:vertical;min-height:64px}\ninput:focus,textarea:focus,select:focus{border-color:var(--purple);outline:none}\n.big input{font-size:20px;font-weight:700;color:var(--deep)}\n.checks{display:flex;flex-wrap:wrap;gap:6px}\n.chip{font-size:12.5px;font-weight:700;border-radius:999px;padding:3px 10px;background:var(--card);color:var(--mute)}\n.chip.ok{background:var(--greenBg);color:var(--green)}\n.chip.warn{background:var(--coralBg);color:var(--coral)}\n.chip.gold{background:#FBF1DC;color:var(--goldInk)}\n.callout{background:var(--card);border-radius:12px;padding:14px 16px;font-size:13.5px}\n.callout b{color:var(--deep)}\n.examples{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}\n.ex{border:1.5px dashed var(--line);border-radius:12px;padding:12px 14px;font-size:13.5px}\n.ex .who{font-size:11.5px;font-weight:700;letter-spacing:.12em;color:var(--mute);text-transform:uppercase}\n.ex q{display:block;font-weight:700;color:var(--deep);margin-top:4px;quotes:\"\\201C\" \"\\201D\"}\n.auth{display:flex;flex-direction:column;gap:8px}\n.auth label{display:flex;gap:10px;align-items:flex-start;font-weight:400;cursor:pointer}\n.auth input{margin-top:3px;width:18px;height:18px;accent-color:var(--purple);flex:none}\n/* people */\n.people{display:flex;flex-direction:column;gap:12px}\n.person{border:1.5px solid var(--line);border-radius:14px;padding:14px;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:10px;align-items:end}\n.person.star{border-color:var(--gold);background:#FFFBF2}\n.c3{grid-column:span 3}.c4{grid-column:span 4}.c5{grid-column:span 5}.c6{grid-column:span 6}.c2{grid-column:span 2}.c12{grid-column:1/-1}\n.starbtn{border:1.5px solid var(--line);background:var(--white);border-radius:10px;padding:8px 10px;font-weight:700;color:var(--mute);width:100%}\n.starbtn[aria-pressed=\"true\"]{background:var(--gold);border-color:var(--gold);color:#4A3608}\n.pfoot{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}\n.coverage{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.role{border-radius:12px;padding:12px;background:var(--card)}\n.role .rn{font-weight:700;color:var(--deep);font-size:13.5px}\n.role .rc{font-size:26px;font-weight:800;color:var(--purple);font-variant-numeric:tabular-nums;line-height:1.1}\n.role .rs{font-size:12px;color:var(--mute)}\n.role.miss{background:var(--coralBg)}.role.miss .rc{color:var(--coral)}\n/* tour */\n.qs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;counter-reset:q}\n.q{background:var(--card);border-radius:12px;padding:12px 14px;font-size:13.5px;font-weight:700;color:var(--deep)}\n.q span{display:block;font-size:11.5px;letter-spacing:.12em;color:var(--teal);filter:brightness(.7)}\n.meter{height:10px;border-radius:999px;background:var(--card);overflow:hidden}\n.meter i{display:block;height:100%;background:linear-gradient(90deg,var(--teal),var(--indigo));width:0;transition:width .3s}\n.tour{display:flex;flex-direction:column;gap:10px}\n.trow{border:1.5px solid var(--line);border-radius:14px;padding:12px 14px;display:grid;grid-template-columns:minmax(0,1.3fr) 150px 150px;gap:10px;align-items:start}\n.trow .who{font-weight:700;color:var(--deep)}\n.trow .sub{font-size:12.5px;color:var(--mute)}\n.trow textarea{grid-column:1/-1;min-height:52px}\n/* map */\n.poster{border-radius:16px;padding:26px 28px;color:var(--white);background:linear-gradient(135deg,var(--purple),var(--deep))}\n.poster .eyebrow{color:var(--teal)}\n.poster h3{font-size:clamp(24px,3.6vw,34px);line-height:1.15;margin:8px 0;text-wrap:balance}\n.poster p{margin:0;max-width:70ch;opacity:.92}\n.poster .filter{margin-top:14px;display:inline-block;background:rgba(255,255,255,.14);border-radius:10px;padding:8px 12px;font-weight:700}\n.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}\n.pc{border-radius:14px;border:1.5px solid var(--line);padding:16px;display:flex;flex-direction:column;gap:6px;min-width:0}\n.pc .h{font-size:17px;font-weight:800;color:var(--purple);line-height:1.2}\n.pc .s{font-size:13px;color:var(--ink)}\n.pc .w{margin-top:auto;font-size:12.5px;color:var(--mute);display:flex;justify-content:space-between;gap:6px;padding-top:8px;border-top:1px solid var(--line)}\n.pc.star{border-color:var(--gold)}\n.bring{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n.bring div{display:flex;gap:8px;align-items:center;font-size:13.5px;padding:8px 10px;border-radius:10px;background:var(--card)}\n.dot{width:18px;height:18px;border-radius:50%;flex:none;background:var(--line);display:grid;place-items:center;color:var(--white);font-size:11px;font-weight:800}\n.dot.on{background:var(--green)}\n.nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;padding-top:4px}\n/* rail */\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:18px;display:flex;flex-direction:column;gap:14px;\n  background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.rail h3{margin:0;font-size:16px;letter-spacing:.04em}\n.rrow{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.14)}\n.rrow b{color:var(--teal);font-variant-numeric:tabular-nums;text-align:right}\n.rrow b.no{color:#C9BEF2;font-weight:400;font-style:italic}\n.tip{background:rgba(230,180,80,.16);border-radius:12px;padding:12px;font-size:13px}\n.tip .t{font-weight:700;color:var(--gold);margin-bottom:4px}\n.rail .btn{width:100%}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\ntextarea.copybox{position:absolute;left:-9999px;top:0;width:1px;height:1px}\n@media (max-width:1000px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:720px){\n  .fields,.examples,.bring{grid-template-columns:minmax(0,1fr)}\n  .coverage{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .qs{grid-template-columns:minmax(0,1fr)}\n  .person>*{grid-column:1/-1!important}\n  .trow{grid-template-columns:minmax(0,1fr)}\n  .step{padding:18px 16px 22px}\n  .tab .lbltxt{display:none}\n}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n\n<style id=\"bn-restyle\">\n/* ============================================================\n   bn-restyle v2 · BOLD visual refresh. Appearance only. Appended\n   last in <head>. No transform/filter/backdrop-filter/will-change\n   on body or any tall/large container; big surfaces animate via\n   opacity / background-position / box-shadow only. Small transient\n   transforms live only on button/chip hover+press. Dark text on\n   light surfaces preserved. Motion gated by prefers-reduced-motion.\n   ============================================================ */\n@media screen {\n  :root {\n    --ink:#1b2130;                      /* deeper body text: max contrast */\n    --bnE:cubic-bezier(.22,.9,.3,1);\n    --bnCard:0 2px 4px rgba(26,14,54,.10), 0 20px 44px -18px rgba(52,22,92,.50), 0 44px 90px -46px rgba(34,14,70,.60);\n    --bnLift:0 18px 38px -14px rgba(44,18,86,.58), 0 4px 12px -6px rgba(44,18,86,.30);\n    --bnGradPrimary:linear-gradient(135deg,#8E6BE6 0%,#6C45C0 54%,#4A2C94 100%);\n    --bnGradTeal:linear-gradient(135deg,#6BE8DF 0%,#2FBBB0 100%);\n    --bnGradGold:linear-gradient(135deg,#FFDE8A 0%,#E6B450 100%);\n    --bnGradHead:linear-gradient(100deg,#FFE3A8 0%,#FFFFFF 46%,#8FE9E1 100%);\n  }\n  /* ---- Dramatic multi-stop field + big soft glow accents ---- */\n  /* min-height:0 neutralises the exercise's own body{min-height:100vh}: inside\n     the auto-resizing iframe, 100vh equals the iframe height, so a shorter step\n     could never report less height than the current (taller) iframe, leaving a\n     big empty tail. Measuring real content height lets the iframe shrink back.\n     html bg matches the field so the iframe's min-height floor never flashes. */\n  html { background-color:#20143E !important; }\n  body {\n    min-height:0 !important;\n    background-color:#20143E !important;\n    background-image:\n      radial-gradient(1000px 560px at 4% -10%, rgba(126,140,255,.42), transparent 60%),\n      radial-gradient(880px 560px at 118% 2%, rgba(188,120,236,.40), transparent 58%),\n      radial-gradient(820px 680px at 50% 120%, rgba(78,205,196,.22), transparent 60%),\n      linear-gradient(165deg,#3B2F86 0%,#4B2A7C 30%,#3A1C68 62%,#20143E 100%) !important;\n    background-attachment:scroll !important;\n  }\n  /* ---- Bigger, bolder headings; gradient title on the dark header ---- */\n  h1 { font-weight:800 !important; letter-spacing:-.015em !important;\n       font-size:clamp(29px,4.4vw,42px) !important; }\n  h2 { font-weight:800 !important; }\n  .eyebrow { letter-spacing:.26em !important; font-weight:800 !important; }\n  /* Gradient-text only for the header title (always on the dark field), with a\n     light gradient so contrast stays high; guarded so unsupported browsers keep\n     the solid white title. */\n  @supports ((-webkit-background-clip:text) or (background-clip:text)) {\n    header.top h1, .top h1 {\n      background:var(--bnGradHead);\n      -webkit-background-clip:text; background-clip:text;\n      -webkit-text-fill-color:transparent; color:transparent;\n    }\n  }\n  /* ---- PROMINENT cards: big radius, strong layered shadow, hairline edge ---- */\n  .panel, .card, .rail, .poster, .callout, .scenario, .box5, .tip, .copybox, .sample {\n    border-radius:22px !important;\n  }\n  .panel, .poster {\n    box-shadow:var(--bnCard) !important;\n    border:1px solid rgba(255,255,255,.16) !important;\n  }\n  .card, .qbox, .box, .role, .person, .callout, .tip {\n    box-shadow:0 12px 30px -16px rgba(40,18,80,.5) !important;\n  }\n  /* ---- Compositing-safe transitions (exercise disables these under reduced motion) ---- */\n  .btn, .tab, .lt, .chip, .pill, .svc, .card, .qbox, .box, .role, .person, .rrow,\n  .trow, .star, .starbtn, button, input, select, textarea, a {\n    transition:transform .15s var(--bnE), box-shadow .26s var(--bnE),\n      background-color .22s var(--bnE), border-color .2s var(--bnE), color .16s var(--bnE) !important;\n  }\n  /* ---- BOLD pill buttons: gradient fills, hover lift+scale, press (small elems) ---- */\n  .btn { border-radius:999px !important; font-weight:800 !important; letter-spacing:.01em;\n         box-shadow:0 8px 18px -9px rgba(26,12,58,.55); }\n  .btn:hover  { transform:translateY(-2px) scale(1.03); box-shadow:0 18px 34px -12px rgba(44,18,86,.6); }\n  .btn:active { transform:translateY(0) scale(.955); }\n  .btn:disabled { opacity:.5 !important; transform:none !important; box-shadow:none !important; }\n  .btn.primary { background:var(--bnGradPrimary) !important; color:#fff !important; border:none !important; }\n  .btn.teal    { background:var(--bnGradTeal) !important; color:#06312D !important; border:none !important; }\n  .btn.gold    { background:var(--bnGradGold) !important; color:#3D2C05 !important; border:none !important; }\n  /* ---- Medium cards: shadow-only hover pop (never transform big surfaces) ---- */\n  .card:hover, .qbox:hover, .svc:hover, .role:hover, .person:hover, .rrow:hover, .trow:hover, .pi:hover {\n    box-shadow:var(--bnLift) !important;\n  }\n  /* ---- Inputs: rounded with a strong brand focus ring ---- */\n  input, select, textarea { border-radius:12px !important; }\n  input:focus, select:focus, textarea:focus {\n    border-color:var(--purple) !important;\n    box-shadow:0 0 0 3px rgba(118,75,162,.30) !important; outline:none !important;\n  }\n  /* ---- Modern chips/badges: pill, gradient-ready, glow+scale on hover ---- */\n  .chip, .pill { border-radius:999px !important; font-weight:800 !important;\n                 box-shadow:0 2px 9px -3px rgba(40,18,80,.42); }\n  .chip:hover, .pill:hover { transform:translateY(-1px) scale(1.06);\n                 box-shadow:0 10px 18px -6px rgba(40,18,80,.5); }\n  /* ---- Tabs: bold, gold underline + glow on the active tab ---- */\n  .tab { font-weight:800 !important; }\n  .tab:hover { color:var(--deep) !important; }\n  .tab[aria-selected=\"true\"], .tab.active {\n    color:var(--deep) !important;\n    box-shadow:inset 0 -3px 0 0 var(--gold), 0 8px 20px -8px rgba(230,180,80,.55);\n  }\n  /* ---- Animated meter / progress-bar fills (width only) ---- */\n  .track i, .bar i, .meter i, .bars i, .stack i, .meter > span {\n    transition:width .75s var(--bnE), background-color .3s var(--bnE) !important;\n  }\n}\n/* ============ lively motion — all disabled under reduced motion ============ */\n@media screen and (prefers-reduced-motion: no-preference) {\n  @keyframes bnFade { from { opacity:0; } to { opacity:1; } }\n  @keyframes bnGlow {\n    0%,100% { box-shadow:inset 0 -3px 0 0 var(--gold), 0 8px 18px -10px rgba(230,180,80,.40); }\n    50%     { box-shadow:inset 0 -3px 0 0 var(--gold), 0 12px 28px -8px rgba(230,180,80,.80); }\n  }\n  @keyframes bnSheen {\n    0%   { background-position:0% 50%, 100% 50%, 50% 100%, 0 0; }\n    100% { background-position:26% 42%, 74% 58%, 50% 88%, 0 0; }\n  }\n  /* Entrance = OPACITY fade on CONTAINERS (not re-rendered items → no flicker),\n     lightly staggered. Big surfaces, opacity only — compositing-safe. */\n  .top, header.top, .panel, .rail, .scenario, .poster, .callout, .step {\n    animation:bnFade .6s var(--bnE) both;\n  }\n  .grid > *:nth-child(2)  { animation-delay:.08s; }\n  .grid > *:nth-child(3)  { animation-delay:.16s; }\n  .rail { animation-delay:.14s; }\n  /* Ambient: slow glow drift (background-position only — never transform). */\n  body { animation:bnSheen 30s ease-in-out infinite alternate; }\n  /* Active tab: gentle pulsing glow (box-shadow only). */\n  .tab[aria-selected=\"true\"], .tab.active { animation:bnGlow 2.8s ease-in-out infinite; }\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">From Scorekeeper to Strategist · Session 1 · Homework 4</div>\n      <h1>Team Purpose Map</h1>\n      <p>Draft the purpose your firm will lead with, connect every person on your team to it, and plan the listening tour that turns your draft into something they believe.</p>\n    </div>\n    <div class=\"sample\" id=\"sampleBar\">\n      <span id=\"sampleMsg\"><b>Sample firm loaded:</b> Clear Path Advisory. Explore it, then start your own.</span>\n      <button class=\"btn light\" id=\"startOwn\" type=\"button\">Start my own map</button>\n      <button class=\"btn ghost\" id=\"loadSample\" type=\"button\">Load sample</button>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel\">\n      <div class=\"tabs\" role=\"tablist\" id=\"tabs\"></div>\n\n      <!-- STEP 1 -->\n      <section class=\"step\" data-step=\"0\" role=\"tabpanel\">\n        <h2>Bring in your homework</h2>\n        <p class=\"lead\">Your purpose is built on what you already decided. Pull these from Homework 1–3.</p>\n        <div class=\"callout\" id=\"hwPull\" hidden style=\"display:flex;gap:10px;align-items:center;flex-wrap:wrap\"><span id=\"hwPullTxt\"></span><button class=\"btn primary\" type=\"button\" id=\"hwPullBtn\">Bring them in</button></div>\n        <div class=\"fields\">\n          <div class=\"field\"><label for=\"firm\">Firm name</label><input type=\"text\" id=\"firm\" data-k=\"firm\"></div>\n          <div class=\"field\"><label for=\"owner\">Your name</label><input type=\"text\" id=\"owner\" data-k=\"owner\"></div>\n          <div class=\"field full\"><label for=\"box5\">Your Box 5 sentence <span class=\"hint\">· from the $100K Question (Homework 2)</span></label>\n            <textarea id=\"box5\" data-k=\"box5\" placeholder=\"I'm the only one who can…\"></textarea></div>\n          <div class=\"field\"><label for=\"red\">Your RED % <span class=\"hint\">· from the Traffic Light tool (Homework 1)</span></label>\n            <input type=\"number\" id=\"red\" data-k=\"red\" min=\"0\" max=\"100\" placeholder=\"e.g. 45\"></div>\n          <div class=\"field\"><label for=\"nexthire\">Your next-hire role <span class=\"hint\">· from the 52-card pickup (Homework 3)</span></label>\n            <select id=\"nexthire\" data-k=\"nexthire\">\n              <option value=\"\">Choose a role</option><option>Admin orchestrator</option><option>Business analyst</option><option>BOS</option><option>Technical team</option>\n            </select></div>\n        </div>\n        <div class=\"callout\"><b>Why start here?</b> The purpose that sticks sits where your unique value (Box 5) meets the story your team already tells about their work. You supply the first half now; the listening tour supplies the second.</div>\n        <div class=\"nav\"><span></span><button class=\"btn primary\" type=\"button\" data-go=\"1\">Next: draft the purpose →</button></div>\n      </section>\n\n      <!-- STEP 2 -->\n      <section class=\"step\" data-step=\"1\" role=\"tabpanel\" hidden>\n        <h2>Draft your purpose</h2>\n        <p class=\"lead\">Short enough to put on a poster, specific enough that a stranger knows who you serve. This is a draft. Your team will shape it.</p>\n        <div class=\"fields\">\n          <div class=\"field full big\"><label for=\"purpose\">Purpose headline <span class=\"hint\">· aim for 12 words or fewer</span></label>\n            <input type=\"text\" id=\"purpose\" data-k=\"purpose\" placeholder=\"We give… / We help… / We make…\"></div>\n          <div class=\"field full\"><div class=\"checks\" id=\"purposeChecks\"></div></div>\n          <div class=\"field full\"><label for=\"meaning\">What it means in practice <span class=\"hint\">· one or two sentences on the difference it makes for clients</span></label>\n            <textarea id=\"meaning\" data-k=\"meaning\"></textarea></div>\n          <div class=\"field full\"><label for=\"filterq\">Your filter question <span class=\"hint\">· the one question you'll ask of every decision</span></label>\n            <input type=\"text\" id=\"filterq\" data-k=\"filterq\" placeholder=\"Will this make us better advisors to the clients we want?\"></div>\n        </div>\n        <div>\n          <div class=\"lbl\" style=\"margin-bottom:8px\">Authenticity check <span class=\"hint\">· tick only what's true today</span></div>\n          <div class=\"auth\" id=\"auth\"></div>\n        </div>\n        <div class=\"examples\">\n          <div class=\"ex\"><div class=\"who\">KPMG · accounting firm</div><q>Inspire confidence. Empower change.</q>Found by analyzing hundreds of employee interviews, not written by a committee.</div>\n          <div class=\"ex\"><div class=\"who\">DTE Energy · utility</div><q>We serve with our energy, the lifeblood of communities and the engine of progress.</q>Showed truck drivers and plant operators what their work made possible.</div>\n        </div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"0\">← Back</button><button class=\"btn primary\" type=\"button\" data-go=\"2\">Next: map your people →</button></div>\n      </section>\n\n      <!-- STEP 3 -->\n      <section class=\"step\" data-step=\"2\" role=\"tabpanel\" hidden>\n        <h2>Map your people</h2>\n        <p class=\"lead\">For each person: the role they play, how they'd describe their work on their best day, and one stretch challenge that shows faith in their potential.</p>\n        <div class=\"coverage\" id=\"coverage\"></div>\n        <div class=\"people\" id=\"people\"></div>\n        <div><button class=\"btn soft\" type=\"button\" id=\"addPerson\">+ Add a person</button></div>\n        <div class=\"callout\"><b>Writing the \"I ___\" headline.</b> Ask what that person would say they do on their best day. KPMG's posters read like \"I Combat Terrorism,\" with one line underneath explaining how. If someone isn't hired yet, add the role with the name \"Future hire.\"</div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"1\">← Back</button><button class=\"btn primary\" type=\"button\" data-go=\"3\">Next: plan the listening tour →</button></div>\n      </section>\n\n      <!-- STEP 4 -->\n      <section class=\"step\" data-step=\"3\" role=\"tabpanel\" hidden>\n        <h2>Plan your listening tour</h2>\n        <p class=\"lead\">Meet one-on-one with every person. Your energizers go first. Listen for the gold nuggets, the shared story underneath different opinions.</p>\n        <div class=\"qs\">\n          <div class=\"q\"><span>QUESTION 1</span>What are you most proud of in your work here?</div>\n          <div class=\"q\"><span>QUESTION 2</span>What does a great week look like for you?</div>\n          <div class=\"q\"><span>QUESTION 3</span>What do you wish our clients understood about what we do?</div>\n        </div>\n        <div>\n          <div style=\"display:flex;justify-content:space-between;font-size:13.5px;margin-bottom:6px\"><b>Tour progress</b><span id=\"tourPct\">0 of 0 done</span></div>\n          <div class=\"meter\"><i id=\"tourBar\"></i></div>\n        </div>\n        <div class=\"tour\" id=\"tour\"></div>\n        <div class=\"callout\"><b>After the tour:</b> rewrite your purpose using what you heard, share the new draft with the people you interviewed, and refine it again. Deborah Ball called this \"collective creation.\"</div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"2\">← Back</button><button class=\"btn primary\" type=\"button\" data-go=\"4\">Next: see your map →</button></div>\n      </section>\n\n      <!-- STEP 5 -->\n      <section class=\"step\" data-step=\"4\" role=\"tabpanel\" hidden>\n        <h2>Your Team Purpose Map</h2>\n        <p class=\"lead\">Bring this to Session 2. Label it a draft until your listening tour is done.</p>\n        <div class=\"poster\" id=\"poster\"></div>\n        <div class=\"cards\" id=\"cards\"></div>\n        <div>\n          <div class=\"lbl\" style=\"margin-bottom:8px\">Ready for Session 2?</div>\n          <div class=\"bring\" id=\"bring\"></div>\n        </div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"3\">← Back</button>\n          <span style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"btn teal\" type=\"button\" id=\"copyBtn2\">Copy my map as text</button><button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button></span></div>\n      </section>\n    </main>\n\n    <aside class=\"panel rail\" aria-label=\"Readiness\">\n      <h3>Your readiness</h3>\n      <div id=\"rail\"></div>\n      <div class=\"tip\"><div class=\"t\" id=\"tipT\">Next best move</div><div id=\"tipB\"></div></div>\n      <button class=\"btn teal\" type=\"button\" id=\"copyBtn\">Copy my map as text</button>\n      <div class=\"toast\" id=\"toast\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n  <div class=\"foot\">From Scorekeeper to Strategist · Session 1: Your Vision, Your Team · Beyond Numbers · Framework adapted from Quinn &amp; Thakor, \"Creating a Purpose-Driven Organization,\" HBR, July–August 2018</div>\n</div>\n<textarea class=\"copybox\" id=\"copybox\" aria-hidden=\"true\" tabindex=\"-1\"></textarea>\n\n<script>\n(function(){\nconst ROLES=[\"BOS\",\"Admin orchestrator\",\"Business analyst\",\"Technical team\"];\nconst ROLE_NOTE={\"BOS\":\"Owns relationships & strategy\",\"Admin orchestrator\":\"The secret weapon\",\"Business analyst\":\"Tech, process & AI\",\"Technical team\":\"The production core\"};\nconst AUTH=[\n \"I can name a decision this purpose would change this month.\",\n \"I'd still say it in a bad year, when it costs us something.\",\n \"My team would recognize themselves in it.\",\n \"It points at the clients we want, not every client we have.\"\n];\nconst GENERIC=[\"succeed\",\"success\",\"excellence\",\"excellent\",\"best\",\"quality\",\"solutions\",\"world-class\",\"value-added\",\"exceed\",\"expectations\",\"synergy\",\"innovative\"];\nconst STEPS=[\"Foundation\",\"Purpose\",\"People\",\"Listening tour\",\"Your map\"];\nconst KEY=\"bn-team-purpose-map-v1\";\n\nconst SAMPLE={sample:true,firm:\"Clear Path Advisory\",owner:\"Penny Breslin\",\n box5:\"I help family-owned trade businesses see the next 12 months clearly enough to make their next big decision with confidence.\",\n red:\"45\",nexthire:\"Admin orchestrator\",\n purpose:\"We give owners the clarity to make their next big decision.\",\n meaning:\"Every reconciliation, forecast and monthly call exists so a business owner can stop guessing and decide. When our numbers are right and on time, families sleep better and businesses grow.\",\n filterq:\"Will this make us better advisors to the clients we want?\",\n auth:[true,false,true,true],\n people:[\n  {name:\"Maria Lopez\",role:\"Admin orchestrator\",head:\"I make month-end painless\",stmt:\"I keep documents, deadlines and clients moving so nobody waits on us.\",stretch:\"Own the new-client onboarding process\",star:true,date:\"2026-11-10\",status:\"Done\",notes:\"Proud that clients call her first. Wishes clients knew how much chasing happens behind the scenes.\"},\n  {name:\"Raj Kumar\",role:\"Business analyst\",head:\"I find the hours our clients are wasting\",stmt:\"I connect the apps and fix the workflows that slow small businesses down.\",stretch:\"Redesign the AP workflow end to end\",star:false,date:\"2026-11-12\",status:\"Scheduled\",notes:\"\"},\n  {name:\"Dana Whitfield\",role:\"BOS\",head:\"I help owners sleep at night\",stmt:\"I turn monthly numbers into the decisions our clients need to make next.\",stretch:\"Lead the monthly strategy call for three Gold clients\",star:true,date:\"2026-11-11\",status:\"Scheduled\",notes:\"\"},\n  {name:\"Chennai team\",role:\"Technical team\",head:\"We keep the books every decision rests on\",stmt:\"Clean, on-time books so advice is built on facts.\",stretch:\"Build the close checklist the whole firm uses\",star:false,date:\"\",status:\"Not scheduled\",notes:\"\"}\n ]};\nconst BLANK={sample:false,firm:\"\",owner:\"\",box5:\"\",red:\"\",nexthire:\"\",purpose:\"\",meaning:\"\",filterq:\"\",auth:[false,false,false,false],\n people:[{name:\"\",role:\"\",head:\"\",stretch:\"\",stmt:\"\",star:false,date:\"\",status:\"Not scheduled\",notes:\"\"}]};\n\nlet S, cur=0;\nfunction load(){ try{const r=localStorage.getItem(KEY); if(r) return JSON.parse(r);}catch(e){} return JSON.parse(JSON.stringify(SAMPLE)); }\nfunction save(){ try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){} }\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s==null?\"\":s).replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst words=s=>(s||\"\").trim().split(/\\s+/).filter(Boolean);\nconst filled=p=>p.name.trim()!==\"\";\n\n// tabs\nfunction renderTabs(){\n  const done=stepDone();\n  $(\"tabs\").innerHTML=STEPS.map((t,i)=>`<button class=\"tab${done[i]?\" done\":\"\"}\" role=\"tab\" type=\"button\" id=\"tab${i}\" aria-selected=\"${i===cur}\" data-tab=\"${i}\"><span class=\"n\">${done[i]?\"✓\":i+1}</span><span class=\"lbltxt\">${t}</span></button>`).join(\"\");\n}\nfunction go(i){cur=i;document.querySelectorAll(\".step\").forEach(s=>s.hidden=+s.dataset.step!==i);renderTabs();\n  if(i===3) renderTour(); if(i===4) renderMap(); const p=document.querySelector(\"main.panel\"); if(p.getBoundingClientRect().top<0) p.scrollIntoView({behavior:\"smooth\"});}\ndocument.addEventListener(\"click\",e=>{const t=e.target.closest(\"[data-tab],[data-go]\"); if(t) go(+(t.dataset.tab??t.dataset.go));});\n\n// simple fields\nfunction bindFields(){\n  document.querySelectorAll(\"[data-k]\").forEach(el=>{\n    el.value=S[el.dataset.k]??\"\";\n    el.oninput=()=>{S[el.dataset.k]=el.value; markEdited(); save(); refresh();};\n  });\n}\nfunction markEdited(){ if(S.sample){S.sample=false; sampleMsg();} }\nfunction sampleMsg(){\n  $(\"sampleMsg\").innerHTML=S.sample?\"<b>Sample firm loaded:</b> Clear Path Advisory. Explore it, then start your own.\":\"<b>Your map</b> saves in this browser as you type.\";\n}\n\n// purpose checks\nfunction purposeChecks(){\n  const w=words(S.purpose), out=[];\n  if(!w.length){$(\"purposeChecks\").innerHTML='<span class=\"chip\">Start typing to see checks</span>';return;}\n  out.push(w.length<=12?`<span class=\"chip ok\">✓ ${w.length} words</span>`:`<span class=\"chip warn\">${w.length} words · trim toward 12</span>`);\n  const g=GENERIC.filter(x=>w.some(y=>y.toLowerCase().replace(/[^a-z-]/g,\"\")===x));\n  out.push(g.length?`<span class=\"chip warn\">Generic: \"${g.join('\", \"')}\" could be any firm</span>`:'<span class=\"chip ok\">✓ No generic buzzwords</span>');\n  out.push(/\\b(we|our|us)\\b/i.test(S.purpose)?'<span class=\"chip ok\">✓ Written as \"we\"</span>':'<span class=\"chip gold\">Try writing it as \"we\"; it belongs to the team</span>');\n  $(\"purposeChecks\").innerHTML=out.join(\"\");\n}\nfunction renderAuth(){\n  $(\"auth\").innerHTML=AUTH.map((a,i)=>`<label for=\"auth${i}\"><input type=\"checkbox\" id=\"auth${i}\" data-a=\"${i}\"${S.auth[i]?\" checked\":\"\"}>${a}</label>`).join(\"\");\n  $(\"auth\").querySelectorAll(\"input\").forEach(c=>c.onchange=()=>{S.auth[+c.dataset.a]=c.checked;markEdited();save();refresh();});\n}\n\n// people\nfunction renderPeople(){\n  $(\"people\").innerHTML=S.people.map((p,i)=>`\n   <div class=\"person${p.star?\" star\":\"\"}\">\n    <div class=\"field c4\"><label for=\"pn${i}\">Name</label><input type=\"text\" id=\"pn${i}\" data-p=\"${i}\" data-f=\"name\" value=\"${esc(p.name)}\" placeholder=\"Name or Future hire\"></div>\n    <div class=\"field c5\"><label for=\"pr${i}\">Role</label><select id=\"pr${i}\" data-p=\"${i}\" data-f=\"role\"><option value=\"\">Choose a role</option>${ROLES.map(r=>`<option${p.role===r?\" selected\":\"\"}>${r}</option>`).join(\"\")}</select></div>\n    <div class=\"field c3\"><span class=\"lbl\">Energizer</span><button type=\"button\" class=\"starbtn\" data-star=\"${i}\" aria-pressed=\"${!!p.star}\">${p.star?\"★ Energizer\":\"☆ Mark\"}</button></div>\n    <div class=\"field c6\"><label for=\"ph${i}\">\"I ___\" headline</label><input type=\"text\" id=\"ph${i}\" data-p=\"${i}\" data-f=\"head\" value=\"${esc(p.head)}\" placeholder=\"I make month-end painless\"></div>\n    <div class=\"field c6\"><label for=\"pt${i}\">Stretch challenge</label><input type=\"text\" id=\"pt${i}\" data-p=\"${i}\" data-f=\"stretch\" value=\"${esc(p.stretch)}\" placeholder=\"Own the client onboarding process\"></div>\n    <div class=\"field c12\"><label for=\"ps${i}\">One line underneath the headline <span class=\"hint\">· how their work connects to the purpose</span></label><input type=\"text\" id=\"ps${i}\" data-p=\"${i}\" data-f=\"stmt\" value=\"${esc(p.stmt)}\"></div>\n    <div class=\"pfoot\"><span class=\"hint\">${p.star?\"Energizers go first on your listening tour.\":\"Others trust and follow this person? Mark them as an energizer.\"}</span>${S.people.length>1?`<button type=\"button\" class=\"btn danger\" data-del=\"${i}\">Remove</button>`:\"\"}</div>\n   </div>`).join(\"\");\n  $(\"people\").querySelectorAll(\"[data-p]\").forEach(el=>{\n    const h=()=>{S.people[+el.dataset.p][el.dataset.f]=el.value;markEdited();save();refresh(false);};\n    el.oninput=h; el.onchange=h;});\n  $(\"people\").querySelectorAll(\"[data-star]\").forEach(b=>b.onclick=()=>{const p=S.people[+b.dataset.star];p.star=!p.star;markEdited();save();renderPeople();refresh();});\n  $(\"people\").querySelectorAll(\"[data-del]\").forEach(b=>b.onclick=()=>{S.people.splice(+b.dataset.del,1);markEdited();save();renderPeople();refresh();});\n}\n$(\"addPerson\").onclick=()=>{S.people.push({name:\"\",role:\"\",head:\"\",stretch:\"\",stmt:\"\",star:false,date:\"\",status:\"Not scheduled\",notes:\"\"});markEdited();save();renderPeople();refresh();\n  const last=$(\"pn\"+(S.people.length-1)); if(last) last.focus();};\nfunction renderCoverage(){\n  $(\"coverage\").innerHTML=ROLES.map(r=>{const n=S.people.filter(p=>p.role===r).length;\n    return `<div class=\"role${n?\"\":\" miss\"}\"><div class=\"rn\">${r}</div><div class=\"rc\">${n}</div><div class=\"rs\">${n?ROLE_NOTE[r]:\"Nobody holds this role yet\"}</div></div>`;}).join(\"\");\n}\n\n// tour\nfunction tourOrder(){return S.people.map((p,i)=>({p,i})).filter(x=>filled(x.p)).sort((a,b)=>(b.p.star-a.p.star)||a.i-b.i);}\nfunction renderTour(){\n  const list=tourOrder();\n  $(\"tour\").innerHTML=list.length?list.map(({p,i})=>`\n   <div class=\"trow\">\n    <div><div class=\"who\">${p.star?\"★ \":\"\"}${esc(p.name)}</div><div class=\"sub\">${esc(p.role||\"Role not set\")}</div></div>\n    <div class=\"field\"><label for=\"td${i}\">Date</label><input type=\"date\" id=\"td${i}\" data-t=\"${i}\" data-f=\"date\" value=\"${esc(p.date)}\"></div>\n    <div class=\"field\"><label for=\"tst${i}\">Status</label><select id=\"tst${i}\" data-t=\"${i}\" data-f=\"status\">${[\"Not scheduled\",\"Scheduled\",\"Done\"].map(s=>`<option${p.status===s?\" selected\":\"\"}>${s}</option>`).join(\"\")}</select></div>\n    <textarea id=\"tn${i}\" data-t=\"${i}\" data-f=\"notes\" placeholder=\"Gold nuggets: what did you hear that others also said?\">${esc(p.notes)}</textarea>\n   </div>`).join(\"\"):'<div class=\"callout\">Add people in step 3 and they will appear here, energizers first.</div>';\n  $(\"tour\").querySelectorAll(\"[data-t]\").forEach(el=>{const h=()=>{S.people[+el.dataset.t][el.dataset.f]=el.value;markEdited();save();refresh(false);};el.oninput=h;el.onchange=h;});\n}\nfunction tourStats(){const l=tourOrder();return {done:l.filter(x=>x.p.status===\"Done\").length,sched:l.filter(x=>x.p.status!==\"Not scheduled\").length,n:l.length};}\n\n// map\nfunction renderMap(){\n  $(\"poster\").innerHTML=`<div class=\"eyebrow\">${esc(S.firm||\"Your firm\")} · Purpose ${tourStats().done<tourStats().n||!tourStats().n?\"(draft)\":\"\"}</div>\n   <h3>${esc(S.purpose||\"Your purpose headline appears here\")}</h3>\n   <p>${esc(S.meaning||\"Add what it means in practice in step 2.\")}</p>\n   ${S.filterq?`<div class=\"filter\">Filter: ${esc(S.filterq)}</div>`:\"\"}`;\n  const ppl=S.people.filter(filled);\n  $(\"cards\").innerHTML=ppl.length?ppl.map(p=>`<div class=\"pc${p.star?\" star\":\"\"}\"><div class=\"h\">${esc(p.head||\"I ___\")}</div><div class=\"s\">${esc(p.stmt||\"\")}</div>\n    <div class=\"s\"><b>Stretch:</b> ${esc(p.stretch||\"not set\")}</div><div class=\"w\"><span>${p.star?\"★ \":\"\"}${esc(p.name)}</span><span>${esc(p.role||\"\")}</span></div></div>`).join(\"\"):\"\";\n  const b=bringList();\n  $(\"bring\").innerHTML=b.map(x=>`<div><span class=\"dot${x[1]?\" on\":\"\"}\">${x[1]?\"✓\":\"\"}</span>${x[0]}</div>`).join(\"\");\n}\nfunction bringList(){\n  const ppl=S.people.filter(filled), t=tourStats();\n  return [[\"Box 5 sentence\",!!S.box5.trim()],[\"Purpose headline + filter question\",!!S.purpose.trim()&&!!S.filterq.trim()],\n   [\"Every person has a role and headline\",ppl.length>0&&ppl.every(p=>p.role&&p.head.trim())],[\"At least one energizer named\",ppl.some(p=>p.star)],\n   [\"Every person has a stretch challenge\",ppl.length>0&&ppl.every(p=>p.stretch.trim())],[\"Listening tour scheduled for everyone\",t.n>0&&t.sched===t.n]];\n}\nfunction stepDone(){\n  const ppl=S.people.filter(filled), t=tourStats();\n  return [!!S.box5.trim()&&!!S.firm.trim(), !!S.purpose.trim()&&!!S.filterq.trim(),\n    ppl.length>0&&ppl.every(p=>p.role&&p.head.trim()), t.n>0&&t.sched===t.n, bringList().every(x=>x[1])];\n}\n\n// rail\nfunction renderRail(){\n  const ppl=S.people.filter(filled), t=tourStats(), miss=ROLES.filter(r=>!S.people.some(p=>p.role===r));\n  const rows=[[\"Purpose\",S.purpose.trim()?`${words(S.purpose).length} words`:null],\n   [\"Authenticity\",`${S.auth.filter(Boolean).length} of 4`],\n   [\"People mapped\",ppl.length?String(ppl.length):null],\n   [\"Energizers\",ppl.filter(p=>p.star).length?String(ppl.filter(p=>p.star).length):null],\n   [\"Roles covered\",`${4-miss.length} of 4`],\n   [\"Interviews done\",t.n?`${t.done} of ${t.n}`:null]];\n  $(\"rail\").innerHTML=rows.map(r=>`<div class=\"rrow\"><span>${r[0]}</span><b class=\"${r[1]?\"\":\"no\"}\">${r[1]||\"not yet\"}</b></div>`).join(\"\");\n  let tip;\n  if(!S.box5.trim()) tip=\"Paste your Box 5 sentence from the $100K Question. Everything else builds on it.\";\n  else if(!S.purpose.trim()) tip=\"Draft the purpose headline. Start from your Box 5 and swap \\\"I\\\" for \\\"we\\\".\";\n  else if(S.auth.filter(Boolean).length<3) tip=\"Fewer than 3 authenticity checks pass. If your team wouldn't recognize themselves in it yet, that's what the listening tour is for.\";\n  else if(!ppl.length) tip=\"Add everyone on your team, including outsourced help, in step 3.\";\n  else if(!ppl.some(p=>p.star)) tip=\"Name your energizer: the person others already trust and follow. They go first on the tour.\";\n  else if(miss.length) tip=`Nobody holds the ${miss[0]} role. ${S.nexthire&&miss.includes(S.nexthire)?\"That matches your next-hire answer from the 52-card pickup.\":\"Is that your next hire?\"}`;\n  else if(t.sched<t.n) tip=\"Put a date on every listening-tour conversation, energizers first.\";\n  else if(t.done<t.n) tip=\"Hold the interviews, then rewrite the purpose using what you heard.\";\n  else tip=\"Tour complete. Share the revised purpose with your team and ask for one more round of feedback.\";\n  $(\"tipB\").textContent=tip;\n  $(\"tourPct\").textContent=`${t.done} of ${t.n} done`; $(\"tourBar\").style.width=(t.n?t.done/t.n*100:0)+\"%\";\n}\n\nfunction refresh(full=true){purposeChecks();renderCoverage();if(full)renderTour();else{tourLite();}renderRail();renderTabs();if(cur===4)renderMap();}\nfunction tourLite(){ // rerender tour only if not focused inside it\n  if(!$(\"tour\").contains(document.activeElement)) renderTour(); }\n\n// copy\nfunction asText(){\n  const L=[];L.push(`TEAM PURPOSE MAP — ${S.firm||\"My firm\"}${S.owner?\" (\"+S.owner+\")\":\"\"}`);\n  L.push(\"\",`Box 5: ${S.box5}`,`RED %: ${S.red||\"-\"}   Next hire: ${S.nexthire||\"-\"}`,\"\",`PURPOSE (draft): ${S.purpose}`,`What it means: ${S.meaning}`,`Filter question: ${S.filterq}`,`Authenticity checks passed: ${S.auth.filter(Boolean).length} of 4`,\"\",\"PEOPLE\");\n  S.people.filter(filled).forEach(p=>L.push(`- ${p.star?\"★ \":\"\"}${p.name} | ${p.role||\"-\"} | \"${p.head}\" | ${p.stmt||\"\"} | Stretch: ${p.stretch||\"-\"} | Tour: ${p.status}${p.date?\" \"+p.date:\"\"}${p.notes?\" | Notes: \"+p.notes:\"\"}`));\n  return L.join(\"\\n\");\n}\nasync function copy(){\n  const txt=asText();\n  try{await navigator.clipboard.writeText(txt);toast(\"Copied. Paste it into an email or a doc.\");}\n  catch(e){const b=$(\"copybox\");b.value=txt;b.select();try{document.execCommand(\"copy\");toast(\"Copied. Paste it into an email or a doc.\");}catch(_){toast(\"Copy is blocked here. Select the text on the map instead.\");}}\n}\nfunction toast(m){$(\"toast\").textContent=m;setTimeout(()=>{$(\"toast\").textContent=\"\";},3500);}\n$(\"copyBtn\").onclick=copy; $(\"copyBtn2\").onclick=copy;\n\n// sample controls (in-page confirm)\nlet armed=null;\nfunction confirmBtn(btn,label,fn){\n  if(armed===btn){armed=null;fn();return;}\n  armed=btn;const old=btn.textContent;btn.textContent=label;setTimeout(()=>{if(armed===btn){armed=null;btn.textContent=old;}},3500);\n}\n$(\"startOwn\").onclick=function(){const b=this;const o=\"Start my own map\";\n  if(S.sample){S=JSON.parse(JSON.stringify(BLANK));init();return;}\n  confirmBtn(b,\"Clear my map? Click again\",()=>{S=JSON.parse(JSON.stringify(BLANK));b.textContent=o;init();});};\n$(\"loadSample\").onclick=function(){const b=this;const o=\"Load sample\";\n  if(S.sample){init();return;}\n  confirmBtn(b,\"Replace my map? Click again\",()=>{S=JSON.parse(JSON.stringify(SAMPLE));b.textContent=o;init();});};\n\nfunction hwPull(){\n  let k=null,tl=null,pk=null;try{k=JSON.parse(localStorage.getItem(\"bn-100k\")||\"null\");tl=JSON.parse(localStorage.getItem(\"bn-traffic-light\")||\"null\");pk=JSON.parse(localStorage.getItem(\"bn-team-pickup\")||\"null\");}catch(e){}\n  const parts=[];if(k&&k.box5)parts.push(\"your Box 5 sentence (Homework 2)\");if(tl&&tl.items&&tl.items.length)parts.push(`your RED share, ${tl.redPct}% (Homework 1)`);if(pk&&pk.nextHire)parts.push(`your next hire, ${pk.nextHire} (Homework 3)`);\n  if(!parts.length){$(\"hwPull\").hidden=true;return;}\n  $(\"hwPull\").hidden=false;$(\"hwPullTxt\").textContent=\"Found \"+(parts.length>2?parts.slice(0,-1).join(\", \")+\" and \"+parts.at(-1):parts.join(\" and \"))+\" in this browser.\";\n  $(\"hwPullBtn\").onclick=()=>{if(k&&k.box5)S.box5=k.box5;if(tl&&tl.items&&tl.items.length)S.red=String(tl.redPct);if(pk&&pk.nextHire)S.nexthire=pk.nextHire;markEdited();save();bindFields();refresh();$(\"hwPullTxt\").textContent=\"Brought in. Edit them if anything changed.\";};\n}\nfunction init(){save();bindFields();renderAuth();renderPeople();sampleMsg();refresh();go(cur);hwPull();}\nS=load(); init();\n})();\n</script>\n\n</body>\n</html>\n"
  },
