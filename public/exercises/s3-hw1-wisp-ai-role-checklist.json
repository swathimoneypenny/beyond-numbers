  "selfContained": true,
  "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>WISP Role Checklist</title>\n<style>\n/* Layout: brand gradient field, white working panel with four step tabs, sticky progress rail on wide screens */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69; --coral:#C53030; --coralBg:#FDECEC; --green:#2F855A; --greenBg:#E8F6EE;\n  --amber:#B7791F; --amberBg:#FDF3E1;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1280px;margin:0 auto;padding-block:20px 28px;\n  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));\n  display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:64ch;opacity:.92}\n.sample{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);\n  border-radius:12px;padding:10px 14px;color:var(--white);font-size:13.5px}\n.sample b{color:var(--gold)}\nbutton{font-family:inherit;cursor:pointer}\n.btn{border:none;border-radius:999px;padding:8px 16px;font-weight:700;font-size:13.5px}\n.btn:focus-visible,.tab:focus-visible,.seg button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.light{background:var(--white);color:var(--deep)}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.7)}\n.btn.primary{background:var(--purple);color:var(--white)}\n.btn.teal{background:var(--teal);color:#0E4A45}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.danger{background:transparent;color:#FFD6D6;border:1.5px solid rgba(255,214,214,.5)}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;padding:10px;border-bottom:1px solid var(--line)}\n.tab{border:none;background:transparent;border-radius:10px;padding:8px 12px;font-weight:700;color:var(--mute);font-size:14px;display:flex;gap:8px;align-items:center}\n.tab .n{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--card);color:var(--deep);font-size:12px}\n.tab[aria-selected=\"true\"]{background:var(--card);color:var(--deep)}\n.tab[aria-selected=\"true\"] .n{background:var(--purple);color:var(--white)}\n.tab.done .n{background:var(--green);color:var(--white)}\n.step{padding:22px 24px 26px;display:flex;flex-direction:column;gap:18px}\n.step h2{margin:0;font-size:22px;color:var(--purple);text-wrap:balance}\n.lead{margin:-10px 0 0;color:var(--mute);font-style:italic;max-width:72ch}\n.fields{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}\n.field{display:flex;flex-direction:column;gap:5px;min-width:0}\nlabel,.lbl{font-weight:700;font-size:13.5px;color:var(--ink)}\ninput[type=text],input[type=date],textarea,select{width:100%;font:inherit;color:var(--ink);background:var(--white);\n  border:1.5px solid var(--line);border-radius:10px;padding:8px 10px}\ninput:focus,textarea:focus,select:focus{border-color:var(--purple);outline:none}\n.legend{display:flex;flex-wrap:wrap;gap:8px;font-size:12.5px;color:var(--mute);align-items:center}\n.grp{display:flex;flex-direction:column;gap:8px}\n.grp h3{margin:6px 0 0;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--tealInk)}\n.item{border:1.5px solid var(--line);border-radius:14px;padding:12px 14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 14px;align-items:center}\n.item .t{font-weight:700;color:var(--deep);line-height:1.3}\n.item .d{font-size:12.5px;color:var(--mute);margin-top:2px}\n.item input.note{grid-column:1/-1;font-size:13.5px;padding:7px 10px}\n.item.s-have{border-color:#BFE3CD;background:#FAFDFB}\n.item.s-partial{border-color:#F3D9A8}\n.item.s-missing,.item.s-dk,.item.s-help{border-color:#F2C1C1}\n.seg{display:inline-flex;border:1.5px solid var(--line);border-radius:999px;overflow:hidden;flex-wrap:nowrap}\n.seg button{border:none;background:var(--white);color:var(--mute);font-size:12.5px;font-weight:700;padding:6px 10px;white-space:nowrap}\n.seg button+button{border-left:1.5px solid var(--line)}\n.seg button[aria-pressed=\"true\"][data-v=\"have\"],.seg button[aria-pressed=\"true\"][data-v=\"doing\"]{background:var(--green);color:#fff}\n.seg button[aria-pressed=\"true\"][data-v=\"partial\"]{background:var(--amber);color:#fff}\n.seg button[aria-pressed=\"true\"][data-v=\"missing\"],.seg button[aria-pressed=\"true\"][data-v=\"help\"]{background:var(--coral);color:#fff}\n.seg button[aria-pressed=\"true\"][data-v=\"dk\"]{background:#7A5BA8;color:#fff}\n.seg button[aria-pressed=\"true\"][data-v=\"na\"]{background:#A0AEC0;color:#fff}\n.chip{font-size:12px;font-weight:700;border-radius:999px;padding:3px 10px;background:var(--card);color:var(--mute)}\n.chip.ok{background:var(--greenBg);color:var(--green)}\n.chip.warn{background:var(--coralBg);color:var(--coral)}\n.chip.amb{background:var(--amberBg);color:var(--amber)}\n.roles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}\n.rolebtn{border:1.5px solid var(--line);background:var(--white);border-radius:12px;padding:10px 12px;text-align:left;display:flex;flex-direction:column;gap:2px}\n.rolebtn b{color:var(--deep);font-size:14.5px}\n.rolebtn span{font-size:12px;color:var(--mute)}\n.rolebtn[aria-pressed=\"true\"]{border-color:var(--purple);background:var(--purple)}\n.rolebtn[aria-pressed=\"true\"] b{color:#fff}.rolebtn[aria-pressed=\"true\"] span{color:#E3D8F5}\n.rolehead{border-radius:14px;padding:16px 18px;color:#fff;background:linear-gradient(135deg,var(--purple),var(--deep))}\n.rolehead .eyebrow{color:var(--teal)}\n.rolehead h3{margin:4px 0 2px;font-size:22px}\n.rolehead p{margin:0;opacity:.92;font-size:14px}\n.callout{background:var(--card);border-radius:12px;padding:12px 14px;font-size:13.5px}\n.callout b{color:var(--deep)}\n.score{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.sc{border-radius:12px;padding:12px;background:var(--card)}\n.sc .n{font-size:28px;font-weight:800;color:var(--purple);font-variant-numeric:tabular-nums;line-height:1.1}\n.sc .l{font-size:12.5px;color:var(--mute)}\n.sc.bad{background:var(--coralBg)}.sc.bad .n{color:var(--coral)}\n.gaps{display:flex;flex-direction:column;gap:8px}\n.gap{border-left:4px solid var(--coral);background:var(--white);border-radius:10px;padding:8px 12px;box-shadow:0 0 0 1.5px var(--line) inset}\n.gap.partial{border-left-color:var(--amber)}\n.gap.dk{border-left-color:#7A5BA8}\n.gap .gt{font-weight:700;color:var(--deep)}\n.gap .gm{font-size:12.5px;color:var(--mute)}\n.empty{font-size:13.5px;color:var(--mute);font-style:italic}\n.nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;padding-top:4px}\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:18px;display:flex;flex-direction:column;gap:14px;\n  background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.rail h3{margin:0;font-size:16px;letter-spacing:.04em}\n.rail #meters{display:flex;flex-direction:column;gap:12px}\n.mrow{display:flex;flex-direction:column;gap:5px;font-size:13.5px}\n.mrow .top{display:flex;justify-content:space-between;gap:8px}\n.mrow b{color:var(--teal);font-variant-numeric:tabular-nums}\n.meter{height:8px;border-radius:999px;background:rgba(255,255,255,.14);overflow:hidden}\n.meter i{display:block;height:100%;background:linear-gradient(90deg,var(--teal),var(--indigo));width:0;transition:width .3s}\n.tip{background:rgba(230,180,80,.16);border-radius:12px;padding:12px;font-size:13px}\n.tip .t{font-weight:700;color:var(--gold);margin-bottom:4px}\n.rail .btn{width:100%}\n.confirm{background:rgba(255,255,255,.1);border-radius:12px;padding:10px;font-size:13px;display:flex;flex-direction:column;gap:8px}\n.confirm div{display:flex;gap:8px}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\n.printonly{display:none}\n@media (max-width:1000px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:760px){\n  .fields,.roles,.score{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .item{grid-template-columns:minmax(0,1fr)}\n  .seg{width:100%}.seg button{flex:1;padding:7px 4px;font-size:12px}\n  .step{padding:18px 16px 22px}\n  .tab .lbltxt{display:none}\n}\n@media (max-width:420px){.fields{grid-template-columns:minmax(0,1fr)}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  .step[hidden]{display:flex!important}\n  .tabs,.nav,.roles,.sample,header.top .sample{display:none!important}\n  .printonly{display:block}\n  .item{break-inside:avoid}\n  .step{break-before:page}\n  .step:first-of-type{break-before:auto}\n  .rolehead{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n  .seg button[aria-pressed=\"true\"]{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">Session 3 · Cybersecurity &amp; AI · Homework</div>\n      <h1>WISP &amp; AI Governance Role Checklist</h1>\n      <p>Check off what your Written Information Security Plan actually covers, then mark the part you play at your level: Partner, Staff Accountant, Preparer, or Bookkeeper. Everything you can't check lands on one gap list.</p>\n    </div>\n    <div class=\"sample\" id=\"sampleBar\">\n      <span id=\"sampleMsg\"><b>Sample firm loaded.</b> Explore, then start your own.</span>\n      <button class=\"btn light\" type=\"button\" id=\"btnSample\">Load sample firm</button>\n      <button class=\"btn ghost\" type=\"button\" id=\"btnOwn\">Start my own</button>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel\">\n      <div class=\"tabs\" role=\"tablist\" id=\"tabs\"></div>\n\n      <section class=\"step\" data-step=\"0\">\n        <h2>1 · Our WISP</h2>\n        <p class=\"lead\">Open your WISP next to this page. For each item, is it in writing in your plan today?</p>\n        <div class=\"fields\">\n          <div class=\"field\"><label for=\"fFirm\">Firm</label><input type=\"text\" id=\"fFirm\" autocomplete=\"organization\"></div>\n          <div class=\"field\"><label for=\"fName\">Your name</label><input type=\"text\" id=\"fName\" autocomplete=\"name\"></div>\n          <div class=\"field\"><label for=\"fQI\">Qualified Individual</label><input type=\"text\" id=\"fQI\" placeholder=\"Name or role\"></div>\n          <div class=\"field\"><label for=\"fDate\">WISP last reviewed</label><input type=\"date\" id=\"fDate\"></div>\n        </div>\n        <div class=\"legend\"><span class=\"chip ok\">Have it</span><span class=\"chip amb\">Partial</span><span class=\"chip warn\">Missing</span><span class=\"chip\" style=\"background:#EFE9F8;color:#5B3F8C\">Don't know</span> Add a note: where it lives, who owns it, what's left.</div>\n        <div id=\"wispList\"></div>\n        <div class=\"nav\"><span></span><button class=\"btn primary\" type=\"button\" data-go=\"1\">Next: AI governance →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"1\" hidden>\n        <h2>2 · AI Governance</h2>\n        <p class=\"lead\">AI went from a perk to a governance duty. Which of these does your firm have in writing?</p>\n        <div class=\"callout\"><b>The one rule:</b> GREEN (public info, templates) is fine in any approved tool · YELLOW (client financials) only in firm-licensed AI with no-training terms · RED (SSNs, bank and card numbers, passwords, full returns) never goes into a chat box.</div>\n        <div id=\"aiList\"></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"0\">← Our WISP</button><button class=\"btn primary\" type=\"button\" data-go=\"2\">Next: my role →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"2\" hidden>\n        <h2>3 · My Role</h2>\n        <p class=\"lead\">Pick your level. Small firm? Do every role you actually cover.</p>\n        <div class=\"roles\" id=\"roleBtns\"></div>\n        <div id=\"roleBody\"></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"1\">← AI governance</button><button class=\"btn primary\" type=\"button\" data-go=\"3\">See my gap list →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"3\" hidden>\n        <h2>4 · Gap List</h2>\n        <p class=\"lead\">Bring this to your next partner or team meeting. Every gap gets an owner and a date.</p>\n        <div class=\"score\" id=\"score\"></div>\n        <div class=\"grp\"><h3>Firm gaps: WISP &amp; AI governance</h3><div class=\"gaps\" id=\"gapFirm\"></div></div>\n        <div class=\"grp\"><h3>Where I need help</h3><div class=\"gaps\" id=\"gapRole\"></div></div>\n        <div class=\"field\"><label for=\"fNext\">My next three actions</label><textarea id=\"fNext\" rows=\"3\" placeholder=\"1. …&#10;2. …&#10;3. …\"></textarea></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"2\">← My role</button><span></span></div>\n      </section>\n    </main>\n\n    <aside class=\"panel rail\">\n      <h3>Progress</h3>\n      <div id=\"meters\"></div>\n      <div class=\"tip\"><div class=\"t\" id=\"tipT\">Tip</div><div id=\"tipB\"></div></div>\n      <button class=\"btn teal\" type=\"button\" id=\"btnCopy\">Copy summary</button>\n      <button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button>\n      <button class=\"btn danger\" type=\"button\" id=\"btnReset\">Clear my answers</button>\n      <div class=\"confirm\" id=\"confirmBox\" hidden><span>Clear every answer and note on this device?</span><div><button class=\"btn light\" type=\"button\" id=\"cYes\">Yes, clear</button><button class=\"btn ghost\" type=\"button\" id=\"cNo\">Cancel</button></div></div>\n      <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n  <div class=\"foot\">Beyond Numbers · From Scorekeeper to Strategist · Your answers stay in this browser only. Not legal advice; check your state's rules and your insurer's requirements.</div>\n</div>\n\n<script>\n(function(){\nconst KEY='bn-wisp-role-checklist-v1';\nconst FIRM_OPTS=[['have','Have it'],['partial','Partial'],['missing','Missing'],['dk',\"Don't know\"]];\nconst ROLE_OPTS=[['doing','Doing it'],['help','Need help'],['na','Not mine']];\n\nconst WISP=[\n {g:'FTC Safeguards Rule: the nine elements',items:[\n  ['qi','Qualified Individual','Named in writing, with authority to enforce, not just recommend'],\n  ['wisp','Written WISP','Tailored to our systems, dated, reviewed every year'],\n  ['risk','Risk assessment','Updated when the firm changes; every control traces to a risk'],\n  ['access','Access controls','Role-based access, unique logins, same-day offboarding'],\n  ['inv','Data inventory','Every system and device, including AI tools and personal devices'],\n  ['enc','Encryption','Full-disk on every device; secure portal for client files'],\n  ['mfa','MFA for everyone','Partners included; authenticator app, not SMS'],\n  ['disp','Secure disposal','Written retention schedule; certificates of destruction'],\n  ['annual','Annual report','Reviewed in a real partner meeting with named owners']]},\n {g:'IRS & state obligations',items:[\n  ['irs','WISP on file for every PTIN holder','IRS Publication 4557 / 5708 as the standard'],\n  ['notify','Breach notification contacts','IRS Stakeholder Liaison and state agencies listed'],\n  ['states','State patchwork mapped','States where clients AND remote staff live']]},\n {g:'Insurance, vendors & response',items:[\n  ['carrier','Insurer controls in place','EDR, offline tested backups, patches within 14 days'],\n  ['vendors','Vendor due diligence','SOC 2, data location, breach timeline, insurance limits'],\n  ['irp','Incident response plan','Who declares, counsel, forensics, carrier hotline, spokesperson, continuity'],\n  ['train','Security training & phishing tests','Scheduled, tested, with a pass mark'],\n  ['remind','Ongoing reminders','Weekly PII and daily server reminders, acknowledged by staff']]}\n];\nconst AI=[\n {g:'AI governance starter kit',items:[\n  ['aup','Acceptable use policy','Who may use AI, for what, with which data'],\n  ['disc','Client disclosure','Engagement letters tell clients the firm uses AI'],\n  ['review','Human review required','Every AI-assisted output checked before it reaches a client'],\n  ['ainv','AI vendor inventory','Every AI tool and built-in AI feature, approved or not'],\n  ['owner','Designated AI owner','One named person approves tools and skills'],\n  ['aitrain','Staff training on data rules','Green / Yellow / Red: what never gets pasted']]},\n {g:'Vendors, audit & insurance',items:[\n  ['aiq','AI vendor questions answered','Data location, model training, retention, acquisition'],\n  ['audit','Audit trail for AI skills and agents','Agent vs. human, which file, which app, when'],\n  ['aiins','AI discussed with cyber insurer','Coverage for AI-related claims confirmed']]}\n];\nconst ROLES={\n partner:{name:'Partner',sub:'Owner · principal',desc:'You own the plan. Regulators, insurers and clients hold you personally accountable.',\n  wisp:[['p1','Name the Qualified Individual and give them authority in writing'],['p2','Approve and sign the WISP every year'],['p3','Review the annual report in a real partner meeting'],['p4','Fund the controls: MFA, EDR, backups, encryption'],['p5','Personally verify our cyber insurance answers'],['p6','Know our breach counsel and carrier hotline'],['p7','Follow every rule myself, MFA included']],\n  ai:[['pa1','Approve the AI acceptable use policy'],['pa2','Approve every AI tool and vendor before use'],['pa3','Make sure clients are told we use AI'],['pa4','Designate an AI owner'],['pa5','Discuss AI use with our cyber insurer']]},\n staff:{name:'Staff Accountant',sub:'Reviewer · close & reporting',desc:'You are the human review that makes AI safe, and the early warning when something looks wrong.',\n  wisp:[['s1','Know where the WISP lives and what my role covers'],['s2','Complete security training on schedule and pass'],['s3','Use only my own logins, with MFA everywhere'],['s4','Open only the client data my work needs'],['s5','Send PII only through the portal or encrypted'],['s6','Lock my screen, log out of apps and the server'],['s7','Report anything suspicious to the DSC right away'],['s8','Acknowledge the weekly PII and daily server reminders']],\n  ai:[['sa1','Review every AI-assisted output before it reaches a client'],['sa2','Use only firm-approved AI tools'],['sa3','Follow the Green / Yellow / Red data rule'],['sa4','Note AI use in workpapers for the audit trail'],['sa5','Flag unique client situations that need human judgment']]},\n preparer:{name:'Preparer',sub:'Tax · PTIN holder',desc:'You handle the most sensitive data in the firm: SSNs, dates of birth, and refunds.',\n  wisp:[['r1','Verify identity before changing bank or refund details'],['r2','Collect and return documents only through the portal'],['r3','Never email SSNs, DOBs or tax data in plain text'],['r4','Store nothing locally; work on the server or SharePoint'],['r5','Shred paper and dispose of media per the retention schedule'],['r6','Report suspected identity theft or IRS notices to the DSC'],['r7','Acknowledge the weekly PII and daily server reminders']],\n  ai:[['ra1','Keep returns and PII out of public AI'],['ra2','Use approved AI for research and drafting only'],['ra3','Human-check AI-suggested positions and calculations'],['ra4','Disclose AI assistance per firm policy']]},\n bookkeeper:{name:'Bookkeeper',sub:'Transactions · bank & card',desc:'You live inside client systems every day. Unique access and careful review are your controls.',\n  wisp:[['b1','Use a unique login for every client system, never shared'],['b2','Route MFA codes through the firm channel or authenticator'],['b3','Store bank and card statements encrypted, not in email'],['b4','Follow the daily server rules: tabs, log out, Friday cache'],['b5','No USB drives or personal cloud for client files'],['b6','Tell my team lead the same day when access should end'],['b7','Acknowledge the weekly PII and daily server reminders']],\n  ai:[['ba1','Review AI-categorized transactions before closing'],['ba2','Keep bank and card numbers out of chat AI'],['ba3','Use only approved AI close and automation workflows'],['ba4','Check AI-generated reports against source statements'],['ba5','Report AI errors so the skill gets fixed']]}\n};\nconst ROLE_KEYS=['partner','staff','preparer','bookkeeper'];\n\nconst SAMPLE={sample:true,firm:'Prairie Ridge Accounting (sample)',name:'Jordan Lee',qi:'Operations Manager',date:'2025-12-15',role:'bookkeeper',step:0,\n firm_s:{qi:'have',wisp:'have',risk:'partial',access:'have',inv:'partial',enc:'have',mfa:'partial',disp:'missing',annual:'have',irs:'have',notify:'dk',states:'missing',carrier:'partial',vendors:'dk',irp:'missing',train:'have',remind:'partial',\n  aup:'have',disc:'partial',review:'have',ainv:'missing',owner:'have',aitrain:'partial',aiq:'dk',audit:'missing',aiins:'dk'},\n firm_n:{qi:'Ops Manager has full authority; named on p.2',risk:'Last full assessment 2023, before we added AI',inv:'No AI tools listed yet',mfa:'Two client banks still SMS only',disp:'Old copier never wiped',states:'We have CA and MA clients; not mapped',irp:'Hotline number lives in one partner\\'s email',remind:'PII weekly only; no server reminder yet',disc:'New engagement letters only',ainv:'Built-in AI in our practice software not listed',audit:'',aiq:'Ask our close-automation vendor'},\n role_s:{bookkeeper:{b1:'doing',b2:'doing',b3:'help',b4:'doing',b5:'doing',b6:'na',b7:'doing',ba1:'doing',ba2:'doing',ba3:'doing',ba4:'help',ba5:'na'},partner:{},staff:{},preparer:{}},\n role_n:{bookkeeper:{b3:'Two clients still email statements; need portal setup',ba4:'Need a checklist for tying AI reports to statements'}},\n next:'1. Ask partners to put AI tools in the data inventory\\n2. Move the two email-statement clients to the portal\\n3. Get the carrier hotline into the incident response plan'};\n\nfunction blank(){return {sample:false,firm:'',name:'',qi:'',date:'',role:'partner',step:0,firm_s:{},firm_n:{},role_s:{partner:{},staff:{},preparer:{},bookkeeper:{}},role_n:{},next:''};}\nlet S;\nfunction load(){try{const r=localStorage.getItem(KEY);if(r){const o=JSON.parse(r);if(o&&o.firm_s)return Object.assign(blank(),o);}}catch(e){}return JSON.parse(JSON.stringify(SAMPLE));}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}\nS=load();\n\nconst $=id=>document.getElementById(id);\nconst esc=t=>String(t==null?'':t).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst steps=[...document.querySelectorAll('.step')];\nconst TABN=['Our WISP','AI governance','My role','Gap list'];\n\nfunction seg(opts,cur,attrs){return '<div class=\"seg\" role=\"group\" '+attrs+'>'+opts.map(([v,l])=>'<button type=\"button\" data-v=\"'+v+'\" aria-pressed=\"'+(cur===v)+'\">'+l+'</button>').join('')+'</div>';}\nfunction firmList(groups,el){\n  el.innerHTML=groups.map(g=>'<div class=\"grp\"><h3>'+g.g+'</h3>'+g.items.map(([id,t,d])=>{\n    const st=S.firm_s[id]||'';\n    return '<div class=\"item s-'+st+'\" data-id=\"'+id+'\"><div><div class=\"t\">'+t+'</div><div class=\"d\">'+d+'</div></div>'+\n      seg(FIRM_OPTS,st,'aria-label=\"'+esc(t)+' status\" data-kind=\"firm\" data-id=\"'+id+'\"')+\n      '<input type=\"text\" class=\"note\" data-kind=\"firmn\" data-id=\"'+id+'\" aria-label=\"Notes for '+esc(t)+'\" placeholder=\"Notes: where it lives, who owns it, what\\'s left\" value=\"'+esc(S.firm_n[id]||'')+'\"></div>';\n  }).join('')+'</div>').join('');\n}\nfunction roleCounts(k){const r=ROLES[k],s=S.role_s[k]||{},all=[...r.wisp,...r.ai];let d=0,h=0,a=0;all.forEach(([id])=>{if(s[id])a++;if(s[id]==='doing')d++;if(s[id]==='help')h++;});return {n:all.length,d,h,a};}\nfunction renderRoles(){\n  $('roleBtns').innerHTML=ROLE_KEYS.map(k=>{const c=roleCounts(k);return '<button type=\"button\" class=\"rolebtn\" data-role=\"'+k+'\" aria-pressed=\"'+(S.role===k)+'\"><b>'+ROLES[k].name+'</b><span>'+(c.a?c.a+' of '+c.n+' answered':ROLES[k].sub)+'</span></button>';}).join('');\n  const k=S.role,r=ROLES[k],s=S.role_s[k]||{},n=S.role_n[k]||{};\n  const rows=list=>list.map(([id,t])=>{const st=s[id]||'';return '<div class=\"item s-'+st+'\"><div><div class=\"t\">'+t+'</div></div>'+\n    seg(ROLE_OPTS,st,'aria-label=\"'+esc(t)+'\" data-kind=\"role\" data-id=\"'+id+'\"')+\n    '<input type=\"text\" class=\"note\" data-kind=\"rolen\" data-id=\"'+id+'\" aria-label=\"Notes for '+esc(t)+'\" placeholder=\"Notes: how I do it, or what help I need\" value=\"'+esc(n[id]||'')+'\"></div>';}).join('');\n  $('roleBody').innerHTML='<div class=\"rolehead\"><div class=\"eyebrow\">My part</div><h3>'+r.name+'</h3><p>'+r.desc+'</p></div>'+\n    '<div class=\"grp\"><h3>In the WISP</h3>'+rows(r.wisp)+'</div><div class=\"grp\"><h3>In AI governance</h3>'+rows(r.ai)+'</div>';\n}\nfunction allFirm(){return [...WISP,...AI].flatMap(g=>g.items.map(i=>({id:i[0],t:i[1],ai:AI.includes(g)})));}\nfunction stats(){\n  const f=allFirm(),w=f.filter(x=>!x.ai),a=f.filter(x=>x.ai);\n  const cnt=(L,v)=>L.filter(x=>S.firm_s[x.id]===v).length;\n  const ans=L=>L.filter(x=>S.firm_s[x.id]).length;\n  return {w:w.length,wh:cnt(w,'have'),wa:ans(w),a:a.length,ah:cnt(a,'have'),aa:ans(a),\n    gaps:f.filter(x=>['missing','dk','partial'].includes(S.firm_s[x.id])).length,\n    unanswered:f.filter(x=>!S.firm_s[x.id]).length};\n}\nfunction renderGaps(){\n  const st=stats();const rc=ROLE_KEYS.map(roleCounts);const help=rc.reduce((s,c)=>s+c.h,0);\n  $('score').innerHTML=[[st.wh+'/'+st.w,'WISP items in place',st.wh<st.w],[st.ah+'/'+st.a,'AI governance in place',st.ah<st.a],[st.gaps,'Firm gaps to close',st.gaps>0],[help,'Duties needing help',help>0]]\n   .map(([n,l,b])=>'<div class=\"sc'+(b?' bad':'')+'\"><div class=\"n\">'+n+'</div><div class=\"l\">'+l+'</div></div>').join('');\n  const order={missing:0,dk:1,partial:2};const lab={missing:'Missing',dk:\"Don't know\",partial:'Partial'};\n  const g=allFirm().filter(x=>S.firm_s[x.id] in order).sort((a,b)=>order[S.firm_s[a.id]]-order[S.firm_s[b.id]]);\n  $('gapFirm').innerHTML=g.length?g.map(x=>{const v=S.firm_s[x.id];return '<div class=\"gap '+v+'\"><div class=\"gt\">'+x.t+' <span class=\"chip '+(v==='partial'?'amb':v==='dk'?'':'warn')+'\">'+lab[v]+'</span> <span class=\"chip\">'+(x.ai?'AI':'WISP')+'</span></div>'+(S.firm_n[x.id]?'<div class=\"gm\">'+esc(S.firm_n[x.id])+'</div>':'')+'</div>';}).join('')\n   :'<div class=\"empty\">'+(st.unanswered?'No gaps yet. '+st.unanswered+' firm items still unanswered.':'No firm gaps. Have your Qualified Individual confirm it.')+'</div>';\n  const h=[];ROLE_KEYS.forEach(k=>{const r=ROLES[k],s=S.role_s[k]||{},n=S.role_n[k]||{};[...r.wisp,...r.ai].forEach(([id,t])=>{if(s[id]==='help')h.push({k,t,n:n[id]});});});\n  $('gapRole').innerHTML=h.length?h.map(x=>'<div class=\"gap\"><div class=\"gt\">'+x.t+' <span class=\"chip\">'+ROLES[x.k].name+'</span></div>'+(x.n?'<div class=\"gm\">'+esc(x.n)+'</div>':'')+'</div>').join(''):'<div class=\"empty\">Nothing marked \"Need help\" yet.</div>';\n}\nfunction renderRail(){\n  const st=stats();const rc=roleCounts(S.role);\n  const m=(l,a,b)=>'<div class=\"mrow\"><div class=\"top\"><span>'+l+'</span><b>'+a+' / '+b+'</b></div><div class=\"meter\"><i style=\"width:'+(b?Math.round(a/b*100):0)+'%\"></i></div></div>';\n  $('meters').innerHTML=m('WISP answered',st.wa,st.w)+m('AI governance answered',st.aa,st.a)+m(ROLES[S.role].name+' duties answered',rc.a,rc.n);\n  const tips=[['Template check','A WISP that still says \"[vendor name]\" or names someone who left is a dead giveaway. Note it as Partial.'],\n    ['Don\\'t know is honest','\"Don\\'t know\" is a finding, not a failure. It tells your Qualified Individual where training is missing.'],\n    ['Roles, not names','Your WISP should name roles. Names change when people move; roles change only when regulations do.'],\n    ['Make it a meeting','Send this gap list to your Qualified Individual and put it on the next partner agenda with owners and dates.']];\n  $('tipT').textContent=tips[S.step][0];$('tipB').textContent=tips[S.step][1];\n  const tabs=$('tabs').children;const done=[st.wa===st.w,st.aa===st.a,rc.a===rc.n,false];\n  [...tabs].forEach((t,i)=>t.classList.toggle('done',done[i]));\n}\nfunction renderTabs(){\n  $('tabs').innerHTML=TABN.map((n,i)=>'<button class=\"tab\" role=\"tab\" type=\"button\" aria-selected=\"'+(S.step===i)+'\" data-go=\"'+i+'\"><span class=\"n\">'+(i+1)+'</span><span class=\"lbltxt\">'+n+'</span></button>').join('');\n}\nfunction show(i){S.step=i;steps.forEach((s,k)=>s.hidden=k!==i);renderTabs();if(i===3)renderGaps();renderRail();save();}\nfunction renderSample(){\n  $('sampleMsg').innerHTML=S.sample?'<b>Sample firm loaded.</b> Explore, then start your own.':'<b>Your checklist.</b> Saved in this browser as you type.';\n  $('btnSample').hidden=S.sample;$('btnOwn').textContent=S.sample?'Start my own':'Start over';\n}\nfunction renderAll(){\n  ['firm','name','qi','date','next'].forEach(k=>{const el=$('f'+(k==='qi'?'QI':k[0].toUpperCase()+k.slice(1)));el.value=S[k]||'';});\n  firmList(WISP,$('wispList'));firmList(AI,$('aiList'));renderRoles();renderSample();show(S.step||0);\n}\nfunction toast(t){$('toast').textContent=t;clearTimeout(toast.h);toast.h=setTimeout(()=>$('toast').textContent='',2600);}\nfunction unsample(){if(S.sample){S.sample=false;renderSample();}}\n\ndocument.addEventListener('click',e=>{\n  const go=e.target.closest('[data-go]');if(go){show(+go.dataset.go);if(go.classList.contains('btn'))document.querySelector('.panel').scrollIntoView({behavior:'smooth',block:'start'});return;}\n  const b=e.target.closest('.seg button');\n  if(b){const g=b.parentElement,id=g.dataset.id,v=b.dataset.v;\n    if(g.dataset.kind==='firm'){S.firm_s[id]=S.firm_s[id]===v?'':v;}\n    else{const r=S.role_s[S.role]=S.role_s[S.role]||{};r[id]=r[id]===v?'':v;}\n    const cur=g.dataset.kind==='firm'?S.firm_s[id]:S.role_s[S.role][id];\n    [...g.children].forEach(x=>x.setAttribute('aria-pressed',x.dataset.v===cur));\n    g.closest('.item').className='item s-'+(cur||'');\n    if(g.dataset.kind==='role'){const c=roleCounts(S.role);const rb=document.querySelector('.rolebtn[data-role=\"'+S.role+'\"] span');if(rb)rb.textContent=c.a?c.a+' of '+c.n+' answered':ROLES[S.role].sub;}\n    unsample();renderRail();save();return;}\n  const rb=e.target.closest('.rolebtn');if(rb){S.role=rb.dataset.role;renderRoles();renderRail();save();return;}\n});\ndocument.addEventListener('input',e=>{\n  const t=e.target;\n  if(t.dataset.kind==='firmn'){S.firm_n[t.dataset.id]=t.value;}\n  else if(t.dataset.kind==='rolen'){(S.role_n[S.role]=S.role_n[S.role]||{})[t.dataset.id]=t.value;}\n  else{const m={fFirm:'firm',fName:'name',fQI:'qi',fDate:'date',fNext:'next'}[t.id];if(!m)return;S[m]=t.value;}\n  unsample();save();\n});\n$('btnSample').onclick=()=>{S=JSON.parse(JSON.stringify(SAMPLE));renderAll();save();toast('Sample firm loaded');};\n$('btnOwn').onclick=()=>{const keepRole=S.sample?S.role:S.role;S=blank();S.role=keepRole;renderAll();save();toast('Blank checklist ready');};\n$('btnReset').onclick=()=>{$('confirmBox').hidden=false;};\n$('cNo').onclick=()=>{$('confirmBox').hidden=true;};\n$('cYes').onclick=()=>{S=blank();renderAll();save();$('confirmBox').hidden=true;toast('Cleared');};\n\nfunction summary(){\n  const st=stats(),lab={have:'Have it',partial:'Partial',missing:'MISSING',dk:\"DON'T KNOW\"};\n  const L=['WISP & AI GOVERNANCE ROLE CHECKLIST','Firm: '+(S.firm||'—')+'   Completed by: '+(S.name||'—'),'Qualified Individual: '+(S.qi||'—')+'   WISP last reviewed: '+(S.date||'—'),'',\n    'WISP items in place: '+st.wh+'/'+st.w+'   AI governance in place: '+st.ah+'/'+st.a,''];\n  const sec=(title,groups)=>{L.push(title);groups.forEach(g=>g.items.forEach(([id,t])=>{L.push('  ['+(lab[S.firm_s[id]]||'—')+'] '+t+(S.firm_n[id]?' — '+S.firm_n[id]:''));}));L.push('');};\n  sec('OUR WISP',WISP);sec('AI GOVERNANCE',AI);\n  ROLE_KEYS.forEach(k=>{const c=roleCounts(k);if(!c.a)return;const r=ROLES[k],s=S.role_s[k],n=S.role_n[k]||{};\n    L.push('MY ROLE: '+r.name.toUpperCase()+' ('+c.d+' doing, '+c.h+' need help)');\n    [...r.wisp,...r.ai].forEach(([id,t])=>{if(s[id])L.push('  ['+({doing:'Doing',help:'NEED HELP',na:'Not mine'}[s[id]])+'] '+t+(n[id]?' — '+n[id]:''));});L.push('');});\n  if(S.next)L.push('NEXT ACTIONS',S.next);\n  return L.join('\\n');\n}\n$('btnCopy').onclick=()=>{const t=summary();\n  const fb=()=>{const ta=document.createElement('textarea');ta.value=t;ta.style.position='absolute';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();let ok=false;try{ok=document.execCommand('copy');}catch(e){}ta.remove();toast(ok?'Summary copied':'Copy blocked; use Print instead');};\n  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(()=>toast('Summary copied'),fb);}else fb();};\nwindow.addEventListener('beforeprint',()=>{renderGaps();});\nrenderAll();\n})();\n</script>\n\n</body>\n</html>\n"
 }
}