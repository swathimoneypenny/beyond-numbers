    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Back-Office Cost Builder</title>\n<style>\n/* Layout: brand gradient field; work table panel left, sticky pricing-window rail right */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69; --coral:#E05D5D; --coralBg:#FDECEC; --green:#2F855A; --greenBg:#E8F6EE;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1360px;margin:0 auto;padding-block:20px 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:66ch;opacity:.92}\n.presets{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:10px 14px;color:var(--white);display:flex;flex-direction:column;gap:6px;min-width:0}\n.presets label{font-size:12.5px;font-weight:700;letter-spacing:.06em}\n.presets select,.presets input{font:inherit;font-weight:700;color:var(--deep);border:none;border-radius:8px;padding:8px 10px;max-width:100%}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.main{padding:20px 22px 24px;display:flex;flex-direction:column;gap:22px}\n.sec{display:flex;flex-direction:column;gap:10px;min-width:0}\n.sec h2{margin:0;font-size:18px;color:var(--purple);display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}\n.sec h2 small{font-size:12.5px;color:var(--mute);font-weight:400;font-style:italic}\n.scroll{overflow-x:auto;border:1.5px solid var(--line);border-radius:12px}\ntable{border-collapse:collapse;width:100%;font-size:13.5px;font-variant-numeric:tabular-nums}\nth{background:var(--deep);color:var(--white);text-align:left;font-size:12px;letter-spacing:.04em;padding:8px;white-space:nowrap;position:sticky;top:0}\ntd{border-bottom:1px solid var(--line);padding:4px 6px;vertical-align:middle}\ntr.elim td{background:#FAFAFD;color:var(--mute)}\ntr.elim td.cost{text-decoration:line-through}\ntd input,td select{font:inherit;font-size:13.5px;color:var(--ink);border:1.5px solid transparent;border-radius:7px;padding:5px 6px;width:100%;background:transparent;min-width:0}\ntd input:hover,td select:hover{border-color:var(--line)}\ntd input:focus,td select:focus{border-color:var(--purple);outline:none;background:var(--white)}\ntd input.num{text-align:right}\ntd.out{text-align:right;white-space:nowrap;padding-right:10px}\ntd.cost{font-weight:800;color:var(--deep)}\ntd.ctr{text-align:center}\ntd input[type=checkbox]{width:16px;height:16px;accent-color:var(--purple)}\n.w-svc{min-width:300px}.w-n{width:84px}.w-u{width:76px}.w-who{width:150px}.w-r{width:86px}.w-o{width:78px}.w-c{width:96px}.w-x{width:40px}\n.del{border:none;background:transparent;color:var(--coral);font-weight:800;cursor:pointer;font-size:16px;padding:2px 6px;border-radius:6px}\ntfoot td{font-weight:800;color:var(--deep);background:var(--card)}\n.rates{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}\n.rate{border:1.5px solid var(--line);border-radius:10px;padding:8px 10px;display:flex;flex-direction:column;gap:2px}\n.rate b{font-size:12.5px;color:var(--deep)}\n.rate span{font-size:11.5px;color:var(--mute)}\n.rate .in{display:flex;align-items:center;gap:4px;font-weight:700;color:var(--mute)}\n.rate input{font:inherit;font-weight:800;color:var(--deep);border:1.5px solid var(--line);border-radius:7px;padding:4px 6px;width:100%;font-variant-numeric:tabular-nums}\n.btn{border:none;border-radius:999px;padding:8px 16px;font:inherit;font-weight:700;font-size:13.5px;cursor:pointer}\n.btn:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.teal{background:var(--teal);color:#0E4A45;width:100%}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.5);width:100%}\n.inline{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:13.5px}\n.inline input{width:80px;font:inherit;font-weight:800;color:var(--deep);border:1.5px solid var(--line);border-radius:8px;padding:5px 8px;text-align:right}\n.callout{background:var(--card);border-radius:12px;padding:12px 14px;font-size:13.5px}\n.callout b{color:var(--deep)}\n/* rail */\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:20px;display:flex;flex-direction:column;gap:14px;background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.lbl{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:700;text-transform:uppercase}\n.big{font-size:40px;font-weight:800;line-height:1;color:var(--gold);font-variant-numeric:tabular-nums}\n.sub{font-size:13.5px;opacity:.9}\n.kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.kpi{background:rgba(255,255,255,.08);border-radius:10px;padding:8px 10px}\n.kpi b{display:block;font-size:19px;font-variant-numeric:tabular-nums}\n.kpi span{font-size:11.5px;opacity:.85}\n.bars{display:flex;flex-direction:column;gap:6px}\n.bar{display:grid;grid-template-columns:96px minmax(0,1fr) 92px;gap:8px;align-items:center;font-size:12.5px}\n.bar i{display:block;height:9px;border-radius:999px;background:var(--teal)}\n.bar em{font-style:normal;text-align:right;font-variant-numeric:tabular-nums}\n.window{background:rgba(255,255,255,.1);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:10px}\n.track{position:relative;height:70px;margin:4px 6px 0}\n.track .line{position:absolute;left:0;right:0;top:20px;height:8px;border-radius:999px;background:linear-gradient(90deg,var(--coral) 0%,var(--gold) 40%,var(--teal) 100%);opacity:.9}\n.mk{position:absolute;top:10px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:2px}\n.mk i{width:4px;height:28px;border-radius:2px;background:var(--white)}\n.mk span{font-size:10.5px;white-space:nowrap;opacity:.95}\n.mk.fee i{background:var(--gold);width:6px}\n.mk.fee span{color:var(--gold);font-weight:800}\n.prow{display:flex;justify-content:space-between;gap:8px;font-size:13.5px;align-items:center}\n.prow b{font-variant-numeric:tabular-nums}\n.prow input{width:110px;font:inherit;font-weight:800;color:var(--deep);border:none;border-radius:8px;padding:5px 8px;text-align:right}\n.flag{font-size:12.5px;border-radius:8px;padding:8px 10px;background:rgba(230,180,80,.16)}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\ntextarea.copybox{position:absolute;left:-9999px;top:0;width:1px;height:1px}\n@media (max-width:1060px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:720px){.main{padding:16px}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">From Scorekeeper to Strategist · Session 2 · Homework 3</div>\n      <h1>What It Costs Your Firm to Deliver</h1>\n      <p>Cost out the back-office work for one client: every task, how often, how long, and who does it at a fully loaded rate. Then see the pricing window between your cost and what the client pays in-house today.</p>\n    </div>\n    <div class=\"presets\">\n      <label for=\"preset\">START FROM</label>\n      <select id=\"preset\"></select>\n      <label for=\"client\">CLIENT</label>\n      <input type=\"text\" id=\"client\" placeholder=\"Client name\" list=\"idealList\"><datalist id=\"idealList\"></datalist>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel main\">\n      <section class=\"sec\">\n        <h2>1 · Your team's cost per hour <small>fully loaded with payroll tax and benefits; outsourced roles at your contract rate</small></h2>\n        <div class=\"rates\" id=\"rates\"></div>\n      </section>\n\n      <section class=\"sec\">\n        <h2>2 · Monthly back-office work <small>times per month × time per event × who does it</small></h2>\n        <div class=\"scroll\">\n          <table>\n            <thead><tr><th class=\"w-svc\">Service</th><th class=\"w-n\">Times / mo</th><th class=\"w-n\">Time each</th><th class=\"w-u\">Unit</th><th class=\"w-who\">Who does it</th><th class=\"w-r\">$/hr</th><th class=\"w-o\">Hours</th><th class=\"w-c\">Cost / mo</th><th class=\"w-x\" title=\"Eliminated by technology\">Tech<br>kills it</th><th class=\"w-x\"></th></tr></thead>\n            <tbody id=\"rows\"></tbody>\n            <tfoot><tr><td colspan=\"6\">Labor subtotal</td><td class=\"out\" id=\"hrsTot\">0</td><td class=\"out\" id=\"labTot\">$0</td><td colspan=\"2\"></td></tr></tfoot>\n          </table>\n        </div>\n        <div class=\"inline\"><button class=\"btn soft\" type=\"button\" id=\"addRow\">+ Add a task</button>\n          <span>Administration time allowance</span><input type=\"number\" id=\"admin\" min=\"0\" max=\"50\" step=\"1\"><span>% of labor</span></div>\n        <div class=\"callout\"><b>Don't forget administration time.</b> Daily organizing of tasks, notes on unusual items, writing and updating procedures, and the weekly client meeting all take real hours. Either list them as tasks or add an allowance. <b>Tech kills it</b> marks work an app or integration removes; it drops out of the cost and shows as savings.</div>\n      </section>\n\n      <section class=\"sec\">\n        <h2>3 · Technology for this client <small>per-client share of firm software; client-paid tools are listed but not counted</small></h2>\n        <div class=\"scroll\">\n          <table>\n            <thead><tr><th class=\"w-svc\">Tool</th><th class=\"w-r\">Fee / mo</th><th class=\"w-n\">Shared by # clients</th><th class=\"w-who\">Paid by</th><th class=\"w-c\">Cost / mo</th><th class=\"w-x\"></th></tr></thead>\n            <tbody id=\"tech\"></tbody>\n          </table>\n        </div>\n        <div><button class=\"btn soft\" type=\"button\" id=\"addTech\">+ Add a tool</button></div>\n      </section>\n\n      <section class=\"sec\">\n        <h2>4 · Outside the monthly fee <small>quoted separately, at premium pricing</small></h2>\n        <div class=\"scroll\">\n          <table>\n            <thead><tr><th class=\"w-svc\">Service</th><th class=\"w-n\">Hours / yr</th><th class=\"w-who\">Who does it</th><th class=\"w-r\">$/hr</th><th class=\"w-c\">Cost / yr</th><th class=\"w-x\"></th></tr></thead>\n            <tbody id=\"other\"></tbody>\n          </table>\n        </div>\n        <div class=\"inline\"><button class=\"btn soft\" type=\"button\" id=\"addOther\">+ Add a service</button><span class=\"hint\" style=\"color:var(--mute)\">Special projects come out of the monthly owner meeting. Some firms include the corporate return in the fee; some don't.</span></div>\n      </section>\n    </main>\n\n    <aside class=\"panel rail\" aria-label=\"Results\">\n      <div>\n        <div class=\"lbl\">Firm monthly cost</div>\n        <div class=\"big\" id=\"total\">$0</div>\n        <div class=\"sub\" id=\"totalSub\"></div>\n      </div>\n      <div class=\"kpis\">\n        <div class=\"kpi\"><b id=\"weekly\">$0</b><span>per week</span></div>\n        <div class=\"kpi\"><b id=\"hrs\">0</b><span>hours per month</span></div>\n        <div class=\"kpi\"><b id=\"blend\">$0</b><span>blended cost per hour</span></div>\n        <div class=\"kpi\"><b id=\"saved\">$0</b><span>removed by technology</span></div>\n      </div>\n      <div class=\"lbl\" style=\"margin-top:2px\">Who carries the work</div>\n      <div class=\"bars\" id=\"bars\"></div>\n      <div class=\"window\">\n        <div class=\"lbl\">The pricing window</div>\n        <div class=\"prow\"><label for=\"inhouse\">Client's in-house cost / mo</label><input type=\"number\" id=\"inhouse\" min=\"0\"></div>\n        <div class=\"prow\" id=\"pullRow\" hidden><span style=\"font-size:12px;opacity:.9\" id=\"pullTxt\"></span><button class=\"btn ghost\" type=\"button\" id=\"pull\" style=\"width:auto;padding:4px 10px;font-size:12px\">Use it</button></div>\n        <div class=\"prow\"><label for=\"fee\">Your monthly fee</label><input type=\"number\" id=\"fee\" min=\"0\"></div>\n        <div class=\"track\" id=\"track\"><div class=\"line\"></div></div>\n        <div class=\"prow\"><span>Gross margin</span><b id=\"margin\">–</b></div>\n        <div class=\"prow\"><span>Client saves</span><b id=\"csave\">–</b></div>\n        <div class=\"prow\"><span>Your profit per year</span><b id=\"profit\">–</b></div>\n        <div class=\"prow\"><span>Fee per hour of work</span><b id=\"eff\">–</b></div>\n        <div class=\"flag\" id=\"flag\"></div>\n      </div>\n      <button class=\"btn teal\" type=\"button\" id=\"copy\">Copy the cost summary</button>\n      <button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button>\n      <div class=\"toast\" id=\"toast\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n  <div class=\"foot\">From Scorekeeper to Strategist · Session 2: Clients &amp; Pricing · Beyond Numbers · Book examples from Step 6: Pricing. PRP = preparer · ADM = admin · BKM = bookkeeping manager/reviewer · CBO = client's own back-office staff</div>\n</div>\n<textarea class=\"copybox\" id=\"copybox\" aria-hidden=\"true\" tabindex=\"-1\"></textarea>\n\n<script>\n(function(){\nconst ROLES0=[[\"PRP\",\"Preparer\",\"outsourced/offshore\",20],[\"ADM\",\"Admin\",\"scheduling, documents\",20],[\"BKM\",\"Bookkeeping manager\",\"reviews PRP work\",35],[\"TEAM\",\"Full team (blended)\",\"internal meetings\",39],[\"CFO\",\"CFO / BOS\",\"owner meetings, analysis\",100],[\"CPA\",\"CPA\",\"tax returns\",100],[\"CBO\",\"Client's own staff\",\"no cost to firm\",0]];\nconst R=(svc,n,t,u,who,rate)=>({svc,n,t,u,who,rate:rate??null,elim:false});\nconst PRESETS={\n ex1:{name:\"Book Example 1 · Non-profit school\",client:\"Non-profit school\",admin:0,inhouse:7555,fee:5000,rates:ROLES0,\n  rows:[R(\"Payables\",100,3,\"min\",\"PRP\"),R(\"Accounts receivable\",150,2,\"min\",\"PRP\"),R(\"Payroll time reporting\",2,15,\"min\",\"PRP\"),R(\"Payroll entry\",2,5,\"min\",\"PRP\"),R(\"Bank reconciliation (per account)\",3,1,\"hr\",\"PRP\"),R(\"Organize source documents & scheduling\",4,1,\"hr\",\"ADM\"),R(\"Prep deposits\",4,2,\"hr\",\"PRP\"),R(\"Review PRP work\",4,1,\"hr\",\"BKM\"),R(\"Internal weekly team meeting (1 hr/wk × team ÷ # CFO clients)\",0.8,1,\"hr\",\"TEAM\"),R(\"CFO meeting with client owner\",1,1,\"hr\",\"CFO\"),R(\"Sales tax – monthly\",1,1,\"hr\",\"BKM\"),R(\"Sales tax – quarterly (per month)\",0.25,1,\"hr\",\"BKM\"),R(\"Sales tax reconciliation (per month)\",0.08333,1,\"hr\",\"PRP\")],\n  tech:[],other:[{svc:\"Corporate tax return\",h:5,who:\"CPA\",rate:null},{svc:\"Special projects from the owner meeting\",h:0,who:\"CFO\",rate:null}]},\n ex2:{name:\"Book Example 2 · Security alarm company\",client:\"Security alarm company\",admin:0,inhouse:0,fee:0,rates:ROLES0,\n  rows:[R(\"Payables\",250,3,\"min\",\"PRP\"),R(\"Accounts receivable\",300,2,\"min\",\"PRP\"),R(\"Payroll time reporting\",2,15,\"min\",\"PRP\"),R(\"Payroll entry\",2,5,\"min\",\"PRP\"),R(\"Bank reconciliation (per account)\",3,1,\"hr\",\"PRP\"),R(\"Organize source documents & scheduling\",4,1,\"hr\",\"ADM\"),R(\"Prep deposits\",4,2,\"hr\",\"PRP\"),R(\"Review PRP work\",4,1,\"hr\",\"BKM\"),R(\"Internal weekly team meeting (1 hr/wk × team ÷ # CFO clients)\",0.8,1,\"hr\",\"TEAM\"),R(\"CFO meeting with client owner\",1,1,\"hr\",\"CFO\"),R(\"Sales tax – monthly\",1,1,\"hr\",\"BKM\"),R(\"Sales tax – quarterly (per month)\",0.25,1,\"hr\",\"BKM\"),R(\"Sales tax reconciliation (per month)\",0.08333,1,\"hr\",\"PRP\"),R(\"Expense tracking\",4,1,\"hr\",\"PRP\"),R(\"Monthly financial analysis reporting\",4,1,\"hr\",\"CFO\")],\n  tech:[],other:[{svc:\"Corporate tax return\",h:5,who:\"CPA\",rate:null},{svc:\"Special projects from the owner meeting\",h:0,who:\"CFO\",rate:null}]},\n ex3:{name:\"Book Example 3 · Restaurant (per location)\",client:\"Restaurant\",admin:0,inhouse:6171,fee:4000,rates:ROLES0,\n  rows:[R(\"Payables (entered by restaurant manager)\",250,3,\"min\",\"CBO\"),R(\"Bill.com sync\",2,30,\"min\",\"PRP\"),R(\"Daily sales summary (Z-out)\",2,10,\"min\",\"CBO\"),R(\"Payroll time reporting\",2,15,\"min\",\"CBO\"),R(\"Payroll entry\",2,5,\"min\",\"PRP\"),R(\"Bank reconciliation (per account)\",3,1,\"hr\",\"PRP\"),R(\"Organize source documents & scheduling\",4,1,\"hr\",\"ADM\"),R(\"Online banking matching, all accounts\",4,2,\"hr\",\"PRP\"),R(\"Review PRP work\",4,30,\"min\",\"BKM\"),R(\"Internal weekly team meeting (1 hr/wk × team ÷ # CFO clients)\",0.8,1,\"hr\",\"TEAM\",31),R(\"CFO meeting with client owner\",1,1,\"hr\",\"CFO\",90),R(\"Sales tax – monthly\",1,1,\"hr\",\"BKM\",27),R(\"Sales tax reconciliation (per month)\",0.08333,1,\"hr\",\"PRP\",18),R(\"Expense tracking\",4,1,\"hr\",\"PRP\"),R(\"Cost analysis reports\",6,20,\"min\",\"BKM\"),R(\"Monthly financial analysis reporting\",4,1,\"hr\",\"CFO\")],\n  tech:[{tool:\"Karbon (practice management)\",fee:250,share:4,by:\"Firm\"},{tool:\"ASP hosting\",fee:47,share:1,by:\"Client\"},{tool:\"Bill.com\",fee:49,share:1,by:\"Client\"}],\n  other:[{svc:\"Corporate tax return\",h:5,who:\"CPA\",rate:null},{svc:\"Special projects from the owner meeting\",h:0,who:\"CFO\",rate:null}]},\n blank:{name:\"Blank template · your client\",client:\"\",admin:10,inhouse:0,fee:0,rates:ROLES0,\n  rows:[R(\"Payables\",0,3,\"min\",\"PRP\"),R(\"Accounts receivable\",0,2,\"min\",\"PRP\"),R(\"Payroll time reporting\",0,15,\"min\",\"PRP\"),R(\"Payroll entry\",0,5,\"min\",\"PRP\"),R(\"Bank reconciliation (per account)\",0,1,\"hr\",\"PRP\"),R(\"Organize source documents & scheduling\",4,1,\"hr\",\"ADM\"),R(\"Review PRP work\",4,1,\"hr\",\"BKM\"),R(\"Internal weekly team meeting (1 hr/wk × team ÷ # CFO clients)\",0.8,1,\"hr\",\"TEAM\"),R(\"CFO meeting with client owner\",1,1,\"hr\",\"CFO\"),R(\"Sales tax\",0,1,\"hr\",\"BKM\"),R(\"Monthly financial analysis reporting\",0,1,\"hr\",\"CFO\"),\n   Object.assign(R(\"Pick up paper / daily drop-offs (old school)\",8,1,\"hr\",\"PRP\"),{elim:true}),Object.assign(R(\"Trips to the bank (old school)\",8,30,\"min\",\"PRP\"),{elim:true})],\n  tech:[{tool:\"Practice management (Karbon, Financial Cents…)\",fee:0,share:1,by:\"Firm\"}],other:[{svc:\"Corporate tax return\",h:0,who:\"CPA\",rate:null},{svc:\"Special projects from the owner meeting\",h:0,who:\"CFO\",rate:null}]}\n};\nconst KEY=\"bn-firm-cost-v1\";\nconst $=id=>document.getElementById(id);\nconst money=n=>\"$\"+Math.round(n).toLocaleString(\"en-US\");\nconst money2=n=>\"$\"+(+n).toLocaleString(\"en-US\",{minimumFractionDigits:2,maximumFractionDigits:2});\nconst esc=s=>String(s??\"\").replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst clone=o=>JSON.parse(JSON.stringify(o));\nlet S;\n$(\"preset\").innerHTML=Object.entries(PRESETS).map(([k,p])=>`<option value=\"${k}\">${p.name}</option>`).join(\"\")+'<option value=\"mine\" hidden>My client</option>';\n\nfunction load(){try{const r=localStorage.getItem(KEY);if(r)return JSON.parse(r);}catch(e){}return Object.assign({preset:\"ex1\"},clone(PRESETS.ex1));}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}\nfunction mine(){if(S.preset!==\"mine\"&&S.preset!==\"blank\"){S.preset=\"mine\";$(\"preset\").value=\"mine\";}}\nconst roleRate=code=>{const r=S.rates.find(x=>x[0]===code);return r?+r[3]:0;};\nconst rateOf=row=>row.rate!=null&&row.rate!==\"\"?+row.rate:roleRate(row.who);\nconst hoursOf=row=>(+row.n||0)*(+row.t||0)/(row.u===\"min\"?60:1);\nconst whoOpts=sel=>S.rates.map(r=>`<option value=\"${r[0]}\"${r[0]===sel?\" selected\":\"\"}>${r[0]} · ${r[1]}</option>`).join(\"\");\n\nfunction renderRates(){\n  $(\"rates\").innerHTML=S.rates.map((r,i)=>`<div class=\"rate\"><b>${r[0]} · ${esc(r[1])}</b><span>${esc(r[2])}</span><label class=\"in\" for=\"rt${i}\">$<input type=\"number\" id=\"rt${i}\" data-rt=\"${i}\" value=\"${r[3]}\" min=\"0\" step=\"0.5\">/hr</label></div>`).join(\"\");\n  $(\"rates\").querySelectorAll(\"[data-rt]\").forEach(el=>el.oninput=()=>{S.rates[+el.dataset.rt][3]=+el.value||0;mine();renderRows(true);calc();});\n}\nfunction renderRows(keepFocus){\n  if(keepFocus&&$(\"rows\").contains(document.activeElement)) return;\n  $(\"rows\").innerHTML=S.rows.map((r,i)=>`<tr class=\"${r.elim?\"elim\":\"\"}\">\n   <td><input id=\"sv${i}\" data-r=\"${i}\" data-f=\"svc\" value=\"${esc(r.svc)}\" aria-label=\"Service\"></td>\n   <td><input class=\"num\" type=\"number\" id=\"sn${i}\" data-r=\"${i}\" data-f=\"n\" value=\"${r.n}\" min=\"0\" step=\"any\" aria-label=\"Times per month\"></td>\n   <td><input class=\"num\" type=\"number\" id=\"st${i}\" data-r=\"${i}\" data-f=\"t\" value=\"${r.t}\" min=\"0\" step=\"any\" aria-label=\"Time each\"></td>\n   <td><select id=\"su${i}\" data-r=\"${i}\" data-f=\"u\" aria-label=\"Unit\"><option value=\"min\"${r.u===\"min\"?\" selected\":\"\"}>min</option><option value=\"hr\"${r.u===\"hr\"?\" selected\":\"\"}>hr</option></select></td>\n   <td><select id=\"sw${i}\" data-r=\"${i}\" data-f=\"who\" aria-label=\"Who does it\">${whoOpts(r.who)}</select></td>\n   <td><input class=\"num\" type=\"number\" id=\"sr${i}\" data-r=\"${i}\" data-f=\"rate\" value=\"${rateOf(r)}\" min=\"0\" step=\"0.5\" aria-label=\"Rate per hour\"></td>\n   <td class=\"out\" id=\"oh${i}\"></td><td class=\"out cost\" id=\"oc${i}\"></td>\n   <td class=\"ctr\"><input type=\"checkbox\" id=\"se${i}\" data-r=\"${i}\" data-f=\"elim\"${r.elim?\" checked\":\"\"} aria-label=\"Eliminated by technology\"></td>\n   <td class=\"ctr\"><button class=\"del\" type=\"button\" data-del=\"${i}\" aria-label=\"Remove task\">×</button></td></tr>`).join(\"\");\n  $(\"rows\").querySelectorAll(\"[data-r]\").forEach(el=>{\n    const h=()=>{const row=S.rows[+el.dataset.r],f=el.dataset.f;\n      if(f===\"elim\") row.elim=el.checked; else if(f===\"who\"){row.who=el.value;row.rate=null;$(\"sr\"+el.dataset.r).value=roleRate(el.value);}\n      else if(f===\"rate\") row.rate=el.value===\"\"?null:+el.value; else row[f]=el.value;\n      if(f===\"elim\") el.closest(\"tr\").classList.toggle(\"elim\",row.elim);\n      mine();calc();};\n    el.addEventListener(el.type===\"checkbox\"||el.tagName===\"SELECT\"?\"change\":\"input\",h);});\n  $(\"rows\").querySelectorAll(\"[data-del]\").forEach(b=>b.onclick=()=>{S.rows.splice(+b.dataset.del,1);mine();renderRows();calc();});\n}\nfunction renderTech(){\n  $(\"tech\").innerHTML=S.tech.map((t,i)=>`<tr><td><input id=\"tt${i}\" data-t=\"${i}\" data-f=\"tool\" value=\"${esc(t.tool)}\" aria-label=\"Tool\"></td>\n   <td><input class=\"num\" type=\"number\" id=\"tf${i}\" data-t=\"${i}\" data-f=\"fee\" value=\"${t.fee}\" min=\"0\" step=\"any\" aria-label=\"Monthly fee\"></td>\n   <td><input class=\"num\" type=\"number\" id=\"ts${i}\" data-t=\"${i}\" data-f=\"share\" value=\"${t.share}\" min=\"1\" step=\"1\" aria-label=\"Shared by clients\"></td>\n   <td><select id=\"tb${i}\" data-t=\"${i}\" data-f=\"by\" aria-label=\"Paid by\"><option${t.by===\"Firm\"?\" selected\":\"\"}>Firm</option><option${t.by===\"Client\"?\" selected\":\"\"}>Client</option></select></td>\n   <td class=\"out cost\" id=\"tc${i}\"></td><td class=\"ctr\"><button class=\"del\" type=\"button\" data-tdel=\"${i}\" aria-label=\"Remove tool\">×</button></td></tr>`).join(\"\")||'<tr><td colspan=\"6\" style=\"color:var(--mute);padding:10px\">No tools added.</td></tr>';\n  $(\"tech\").querySelectorAll(\"[data-t]\").forEach(el=>el.addEventListener(el.tagName===\"SELECT\"?\"change\":\"input\",()=>{S.tech[+el.dataset.t][el.dataset.f]=el.value;mine();calc();}));\n  $(\"tech\").querySelectorAll(\"[data-tdel]\").forEach(b=>b.onclick=()=>{S.tech.splice(+b.dataset.tdel,1);mine();renderTech();calc();});\n}\nfunction renderOther(){\n  $(\"other\").innerHTML=S.other.map((o,i)=>`<tr><td><input id=\"ov${i}\" data-o=\"${i}\" data-f=\"svc\" value=\"${esc(o.svc)}\" aria-label=\"Service\"></td>\n   <td><input class=\"num\" type=\"number\" id=\"oh2${i}\" data-o=\"${i}\" data-f=\"h\" value=\"${o.h}\" min=\"0\" step=\"any\" aria-label=\"Hours per year\"></td>\n   <td><select id=\"ow${i}\" data-o=\"${i}\" data-f=\"who\" aria-label=\"Who does it\">${whoOpts(o.who)}</select></td>\n   <td class=\"out\" id=\"or${i}\"></td><td class=\"out cost\" id=\"oc2${i}\"></td><td class=\"ctr\"><button class=\"del\" type=\"button\" data-odel=\"${i}\" aria-label=\"Remove service\">×</button></td></tr>`).join(\"\");\n  $(\"other\").querySelectorAll(\"[data-o]\").forEach(el=>el.addEventListener(el.tagName===\"SELECT\"?\"change\":\"input\",()=>{S.other[+el.dataset.o][el.dataset.f]=el.value;mine();calc();}));\n  $(\"other\").querySelectorAll(\"[data-odel]\").forEach(b=>b.onclick=()=>{S.other.splice(+b.dataset.odel,1);mine();renderOther();calc();});\n}\n$(\"addRow\").onclick=()=>{S.rows.push(R(\"New task\",0,0,\"min\",\"PRP\"));mine();renderRows();calc();const el=$(\"sv\"+(S.rows.length-1));el.focus();el.select();};\n$(\"addTech\").onclick=()=>{S.tech.push({tool:\"New tool\",fee:0,share:1,by:\"Firm\"});mine();renderTech();calc();};\n$(\"addOther\").onclick=()=>{S.other.push({svc:\"New service\",h:0,who:\"CFO\",rate:null});mine();renderOther();calc();};\n\nfunction compute(){\n  let lab=0,hrs=0,saved=0;const byWho={};\n  S.rows.forEach(r=>{const h=hoursOf(r),c=h*rateOf(r);if(r.elim){saved+=c;return;}lab+=c;hrs+=h;byWho[r.who]=byWho[r.who]||{h:0,c:0};byWho[r.who].h+=h;byWho[r.who].c+=c;});\n  const admin=lab*(+S.admin||0)/100;\n  const tech=S.tech.filter(t=>t.by===\"Firm\").reduce((a,t)=>a+(+t.fee||0)/Math.max(1,+t.share||1),0);\n  const total=lab+admin+tech;\n  const other=S.other.reduce((a,o)=>a+(+o.h||0)*roleRate(o.who),0);\n  return {lab,hrs,saved,byWho,admin,tech,total,other};\n}\nfunction calc(){\n  const c=compute();\n  S.rows.forEach((r,i)=>{const h=hoursOf(r);if($(\"oh\"+i)){$(\"oh\"+i).textContent=h.toFixed(2);$(\"oc\"+i).textContent=money2(h*rateOf(r));}});\n  S.tech.forEach((t,i)=>{if($(\"tc\"+i))$(\"tc\"+i).textContent=t.by===\"Firm\"?money2((+t.fee||0)/Math.max(1,+t.share||1)):\"client pays\";});\n  S.other.forEach((o,i)=>{if($(\"or\"+i)){$(\"or\"+i).textContent=money2(roleRate(o.who));$(\"oc2\"+i).textContent=money2((+o.h||0)*roleRate(o.who));}});\n  $(\"hrsTot\").textContent=c.hrs.toFixed(2); $(\"labTot\").textContent=money2(c.lab);\n  $(\"total\").textContent=money2(c.total);\n  $(\"totalSub\").textContent=`labor ${money(c.lab)}${c.admin?` + admin ${money(c.admin)}`:\"\"}${c.tech?` + tech ${money(c.tech)}`:\"\"}`;\n  $(\"weekly\").textContent=money2(c.total*12/52);\n  $(\"hrs\").textContent=c.hrs.toFixed(1);\n  $(\"blend\").textContent=c.hrs?money2(c.lab/c.hrs):\"$0\";\n  $(\"saved\").textContent=money(c.saved)+\"/mo\";\n  const ent=Object.entries(c.byWho).filter(([k,v])=>v.h>0).sort((a,b)=>b[1].h-a[1].h);\n  const mx=Math.max(1,...ent.map(e=>e[1].h));\n  $(\"bars\").innerHTML=ent.map(([k,v])=>`<div class=\"bar\"><span>${k}</span><i style=\"width:${Math.max(3,v.h/mx*100)}%\"></i><em>${v.h.toFixed(1)} h · ${money(v.c)}</em></div>`).join(\"\")||'<div class=\"sub\">Add tasks to see who carries the work.</div>';\n  // window\n  const inh=+S.inhouse||0, fee=+S.fee||0;\n  $(\"inhouse\").value=S.inhouse||\"\"; $(\"fee\").value=S.fee||\"\";\n  const pts=[[\"Your cost\",c.total,\"c\"],[\"Your fee\",fee,\"fee\"],[\"Client in-house\",inh,\"i\"]].filter(p=>p[1]>0);\n  const hi=Math.max(1,...pts.map(p=>p[1]))*1.05;\n  $(\"track\").innerHTML='<div class=\"line\"></div>'+pts.map(p=>`<div class=\"mk ${p[2]}\" style=\"left:${Math.min(96,Math.max(4,p[1]/hi*100))}%\"><i></i><span>${p[0]}<br>${money(p[1])}</span></div>`).join(\"\");\n  $(\"margin\").textContent=fee?Math.round((fee-c.total)/fee*100)+\"%\":\"–\";\n  $(\"csave\").textContent=fee&&inh?`${money(inh-fee)}/mo (${Math.round((inh-fee)/inh*100)}%)`:\"–\";\n  $(\"profit\").textContent=fee?money((fee-c.total)*12):\"–\";\n  $(\"eff\").textContent=fee&&c.hrs?money2(fee/c.hrs):\"–\";\n  let f;\n  if(!c.total) f=\"Enter volumes and times to cost the work.\";\n  else if(!inh) f=\"Run Homework 2 for this client, or enter what the function costs them today.\";\n  else if(!fee) f=`Try a fee that saves the client 25–35%: around ${money(Math.round(inh*0.7/50)*50)} a month.`;\n  else if(fee<=c.total) f=\"This fee is below your cost. Raise it, or move work to lower-cost roles or the client's own staff.\";\n  else if(fee>=inh) f=\"This fee is above what the client pays in-house today. Expect the objection, or show the other issues from Homework 2.\";\n  else if((fee-c.total)/fee<0.5) f=\"Margin is under 50%. Check whether any hours can move to PRP or be removed by an app.\";\n  else f=\"Inside the window: you profit and the client saves. Add a separate setup fee for any clean-up.\";\n  $(\"flag\").textContent=f;\n  save();\n}\n$(\"admin\").oninput=()=>{S.admin=$(\"admin\").value;mine();calc();};\n$(\"inhouse\").oninput=()=>{S.inhouse=$(\"inhouse\").value;calc();};\n$(\"fee\").oninput=()=>{S.fee=$(\"fee\").value;calc();};\n$(\"client\").oninput=()=>{S.client=$(\"client\").value;save();checkPull();};\n$(\"preset\").onchange=()=>{const p=PRESETS[$(\"preset\").value];if(!p)return;S=Object.assign({preset:$(\"preset\").value},clone(p));init();};\nfunction checkPull(){\n  let r=null;\n  try{\n    const ideal=JSON.parse(localStorage.getItem(\"bn-ideal-clients\")||\"[]\");\n    $(\"idealList\").innerHTML=ideal.map(c=>`<option value=\"${esc(c.name)}\">IDEAL${c.industry?\" · \"+esc(c.industry):\"\"}</option>`).join(\"\");\n    const res=JSON.parse(localStorage.getItem(\"bn-true-cost-results\")||\"{}\");\n    if(S.client&&res[S.client]) r={total:res[S.client].total,client:S.client};\n    else{const last=JSON.parse(localStorage.getItem(\"bn-true-cost-result\")||\"null\");if(last&&last.total>0&&(!S.client||!last.client)) r=last;}\n  }catch(e){}\n  if(r&&r.total>0){$(\"pullRow\").hidden=false;$(\"pullTxt\").textContent=`From Homework 2${r.client?\" (\"+r.client+\")\":\"\"}: ${money(r.total)}/mo`;\n    $(\"pull\").onclick=()=>{S.inhouse=Math.round(r.total);if(r.client&&!S.client){S.client=r.client;$(\"client\").value=r.client;}mine();calc();};}\n  else $(\"pullRow\").hidden=true;\n}\nasync function copy(){\n  const c=compute(),L=[`FIRM COST TO DELIVER — ${S.client||\"Client\"}`,\"\"];\n  S.rows.filter(r=>!r.elim).forEach(r=>{const h=hoursOf(r);L.push(`${r.svc}: ${(+r.n)} × ${r.t} ${r.u} = ${h.toFixed(2)} h × ${r.who} ${money2(rateOf(r))} = ${money2(h*rateOf(r))}`);});\n  if(c.admin)L.push(`Administration allowance ${S.admin}%: ${money2(c.admin)}`);\n  if(c.tech)L.push(`Technology: ${money2(c.tech)}`);\n  L.push(\"\",`Firm monthly cost: ${money2(c.total)}  (weekly ${money2(c.total*12/52)})`);\n  if(+S.inhouse)L.push(`Client in-house cost: ${money2(+S.inhouse)}`);\n  if(+S.fee)L.push(`Proposed monthly fee: ${money2(+S.fee)}  · margin ${$(\"margin\").textContent} · client saves ${$(\"csave\").textContent}`);\n  if(c.saved)L.push(`Removed by technology: ${money2(c.saved)}/mo`);\n  if(c.other)L.push(`Outside the fee (annual cost): ${money2(c.other)}`);\n  const txt=L.join(\"\\n\");\n  try{await navigator.clipboard.writeText(txt);toast(\"Copied.\");}\n  catch(e){const b=$(\"copybox\");b.value=txt;b.select();try{document.execCommand(\"copy\");toast(\"Copied.\");}catch(_){toast(\"Copy is blocked here.\");}}\n}\nfunction toast(m){$(\"toast\").textContent=m;setTimeout(()=>$(\"toast\").textContent=\"\",3000);}\n$(\"copy\").onclick=copy;\nfunction init(){ $(\"preset\").value=S.preset; $(\"client\").value=S.client||\"\"; $(\"admin\").value=S.admin; renderRates();renderRows();renderTech();renderOther();checkPull();calc(); }\nS=load(); init();\n})();\n</script>\n\n</body>\n</html>\n"
  },
  "source": "Step 6: Pricing (BOS method); BOLCALC and BOS Time Budget Proposal Worksheet"
}