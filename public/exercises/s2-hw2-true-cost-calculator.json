{
  "schemaVersion": "1.0",
  "id": "s2-hw2-true-cost-calculator",
  "session": 2,
  "exercise": 2,
  "title": "The True Cost of an In-House Bookkeeper or CFO",
  "type": "calculator",
  "summary": "Homework 2 for Session 2 (Clients & Pricing). Calculates a client's true monthly cost of an in-house bookkeeper, full-charge bookkeeper/staff accountant, or controller/CFO: salary, health, benefits, payroll tax and workers' comp, vacation coverage, overhead, office space by square footage, owner management time, hiring and training, and error-fix fees. A 'Pricing for' list shows the three IDEAL clients chosen in Homework 1 and keeps separate figures for each. Presets reproduce Step 6: Pricing Examples 1 ($7,555) and 3 ($6,171) plus 2026 national-median scenarios (BLS May 2025 wages; KFF 2025 health). Shows annual cost, cost per hour worked, true-cost multiple, hidden costs, and a suggested fee; shares each client's result with Homework 3.",
  "interactive": true,
  "homework": true,
  "sharedStorageKeys": [
    "bn-ideal-clients",
    "bn-true-cost-results",
    "bn-true-cost-result"
  ],
  "brand": {
    "indigo": "#667EEA",
    "purple": "#764BA2",
    "deep": "#44337A",
    "gold": "#E6B450",
    "teal": "#4ECDC4",
    "gradient": [
      "#667EEA",
      "#764BA2"
    ],
    "font": "Calibri"
  },
  "embed": {
    "format": "html",
    "selfContained": true,
    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>True Cost Calculator</title>\n<style>\n/* Layout: brand gradient field; inputs panel left, sticky result rail right */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69; --coral:#E05D5D; --coralBg:#FDECEC; --green:#2F855A; --greenBg:#E8F6EE;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1280px;margin:0 auto;padding-block:20px 28px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:64ch;opacity:.92}\n.presets{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);border-radius:12px;padding:10px 14px;color:var(--white);display:flex;flex-direction:column;gap:6px;min-width:0}\n.presets label{color:var(--white);font-size:12.5px;font-weight:700;letter-spacing:.06em}\n.presets select{font:inherit;font-weight:700;color:var(--deep);border:none;border-radius:8px;padding:8px 10px;max-width:100%}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.inputs{padding:20px 22px 24px;display:flex;flex-direction:column;gap:18px}\n.sec h2{margin:0 0 10px;font-size:18px;color:var(--purple);display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}\n.sec h2 small{font-size:12.5px;color:var(--mute);font-weight:400;font-style:italic}\n.rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 16px}\n.f{display:flex;flex-direction:column;gap:4px;min-width:0}\n.f label{font-weight:700;font-size:13.5px}\n.f .hint{font-size:12px;color:var(--mute)}\n.in{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:10px;background:var(--white);overflow:hidden}\n.in:focus-within{border-color:var(--purple)}\n.in span{white-space:nowrap;padding:0 10px;color:var(--mute);font-weight:700;font-size:13.5px;background:var(--card);align-self:stretch;display:flex;align-items:center}\n.in input{border:none;outline:none;font:inherit;font-size:16px;font-weight:700;color:var(--deep);padding:8px 10px;width:100%;min-width:0;font-variant-numeric:tabular-nums;background:transparent}\n.calcline{grid-column:1/-1;font-size:13px;color:var(--tealInk);background:#E9FBF9;border-radius:8px;padding:6px 10px}\n.src{font-size:12px;color:var(--mute)}\n.src a{color:var(--purple)}\n/* rail */\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:20px;display:flex;flex-direction:column;gap:14px;background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.rail .lbl{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:700;text-transform:uppercase}\n.big{font-size:40px;font-weight:800;line-height:1;color:var(--gold);font-variant-numeric:tabular-nums}\n.sub{font-size:13.5px;opacity:.9}\n.kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.kpi{background:rgba(255,255,255,.08);border-radius:10px;padding:8px 10px}\n.kpi b{display:block;font-size:19px;color:var(--white);font-variant-numeric:tabular-nums}\n.kpi span{font-size:11.5px;opacity:.85}\n.bars{display:flex;flex-direction:column;gap:6px}\n.bar{display:grid;grid-template-columns:118px minmax(0,1fr) 62px;gap:8px;align-items:center;font-size:12.5px}\n.bar i{display:block;height:9px;border-radius:999px;background:var(--teal)}\n.bar i.hid{background:var(--gold)}\n.bar em{font-style:normal;text-align:right;font-variant-numeric:tabular-nums}\n.legend{display:flex;gap:12px;font-size:11.5px;opacity:.9}\n.legend span::before{content:\"\";display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;background:var(--teal);vertical-align:-1px}\n.legend span.h::before{background:var(--gold)}\n.prop{background:rgba(255,255,255,.1);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:8px}\n.prop .row{display:flex;justify-content:space-between;gap:8px;font-size:13.5px}\n.prop .row b{font-variant-numeric:tabular-nums}\n.prop input[type=range]{width:100%;accent-color:var(--gold)}\n.btn{border:none;border-radius:999px;padding:9px 16px;font:inherit;font-weight:700;font-size:13.5px;cursor:pointer}\n.btn:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.teal{background:var(--teal);color:#0E4A45;width:100%}\n.btn.soft{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.5);width:100%}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n/* below */\n.lower{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.card{padding:18px 20px;display:flex;flex-direction:column;gap:10px}\n.card h3{margin:0;font-size:16px;color:var(--purple)}\n.issues{display:flex;flex-direction:column;gap:6px}\n.issues label{display:flex;gap:10px;align-items:flex-start;font-size:13.5px;cursor:pointer}\n.issues input{width:17px;height:17px;margin-top:2px;accent-color:var(--purple);flex:none}\n.quote{font-size:13.5px;background:var(--card);border-radius:10px;padding:12px 14px}\n.quote b{color:var(--deep)}\ntable.cmp{width:100%;border-collapse:collapse;font-size:13.5px;font-variant-numeric:tabular-nums}\ntable.cmp td{padding:6px 4px;border-bottom:1px solid var(--line)}\ntable.cmp td:last-child{text-align:right;font-weight:700}\ntable.cmp tr.tot td{border-top:2px solid var(--deep);border-bottom:none;font-weight:800;color:var(--deep)}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\ntextarea.copybox{position:absolute;left:-9999px;top:0;width:1px;height:1px}\n@media (max-width:1000px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:720px){.rows,.lower{grid-template-columns:minmax(0,1fr)}.inputs{padding:16px}.bar{grid-template-columns:100px minmax(0,1fr) 58px}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">From Scorekeeper to Strategist · Session 2 · Homework 2</div>\n      <h1>The True Cost of an In-House Bookkeeper or CFO</h1>\n      <p>Your prospect says the bookkeeper costs \"$25 an hour.\" That's never the cost of the function. Use their own numbers to find what it really costs them each month, then decide what you could charge and still save them money.</p>\n    </div>\n    <div class=\"presets\">\n      <label for=\"preset\">START FROM</label>\n      <select id=\"preset\"></select>\n      <label for=\"clientSel\">PRICING FOR</label>\n      <select id=\"clientSel\"></select>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel inputs\">\n      <div class=\"sec\">\n        <h2>Direct costs of the person on staff <small>ask the client, or check their payroll reports</small></h2>\n        <div class=\"rows\">\n          <div class=\"f\"><label for=\"wage\">Wage per hour</label><div class=\"in\"><span>$</span><input type=\"number\" id=\"wage\" step=\"0.01\" min=\"0\"></div></div>\n          <div class=\"f\"><label for=\"hours\">Hours worked per week</label><div class=\"in\"><input type=\"number\" id=\"hours\" step=\"0.5\" min=\"0\"><span>hrs</span></div></div>\n          <div class=\"f\"><label for=\"health\">Health plan, employer share</label><div class=\"in\"><span>$</span><input type=\"number\" id=\"health\" min=\"0\"><span>/mo</span></div></div>\n          <div class=\"f\"><label for=\"vac\">Vacation coverage</label><div class=\"in\"><input type=\"number\" id=\"vac\" step=\"0.5\" min=\"0\"><span>wks/yr</span></div><div class=\"hint\">Weeks someone else must cover the work. Use 0 if nobody does.</div></div>\n          <div class=\"f\"><label for=\"ptax\">Payroll taxes + workers' comp</label><div class=\"in\"><input type=\"number\" id=\"ptax\" step=\"0.5\" min=\"0\"><span>% of wages</span></div><div class=\"hint\">FICA alone is 7.65%; add unemployment and workers' comp.</div></div>\n          <div class=\"f\"><label for=\"ben\">Other benefits (retirement, 401k)</label><div class=\"in\"><input type=\"number\" id=\"ben\" step=\"0.5\" min=\"0\"><span>% of wages</span></div></div>\n          <div class=\"f\"><label for=\"ovh\">Overhead (supplies, computer, software)</label><div class=\"in\"><input type=\"number\" id=\"ovh\" step=\"0.5\" min=\"0\"><span>% of wages</span></div></div>\n        </div>\n      </div>\n      <div class=\"sec\">\n        <h2>Office space <small>the share of rent the function occupies, file cabinets included</small></h2>\n        <div class=\"rows\">\n          <div class=\"f\"><label for=\"lease\">Lease or mortgage payment</label><div class=\"in\"><span>$</span><input type=\"number\" id=\"lease\" min=\"0\"><span>/mo</span></div></div>\n          <div class=\"f\"><label for=\"sqft\">Total space of the facility</label><div class=\"in\"><input type=\"number\" id=\"sqft\" min=\"0\"><span>sq ft</span></div></div>\n          <div class=\"f\"><label for=\"sqbk\">Space used by this function</label><div class=\"in\"><input type=\"number\" id=\"sqbk\" min=\"0\"><span>sq ft</span></div></div>\n          <div class=\"calcline\" id=\"spaceLine\"></div>\n        </div>\n      </div>\n      <div class=\"sec\">\n        <h2>Management costs <small>the owner's time is never free</small></h2>\n        <div class=\"rows\">\n          <div class=\"f\"><label for=\"mgmt\">Owner/manager time with this person</label><div class=\"in\"><input type=\"number\" id=\"mgmt\" step=\"0.5\" min=\"0\"><span>hrs/wk</span></div></div>\n          <div class=\"f\"><label for=\"mrate\">Value of that time</label><div class=\"in\"><span>$</span><input type=\"number\" id=\"mrate\" min=\"0\"><span>/hr</span></div><div class=\"hint\">Use at least $100 an hour.</div></div>\n          <div class=\"f\"><label for=\"hire\">Hiring and training</label><div class=\"in\"><input type=\"number\" id=\"hire\" min=\"0\"><span>hrs/yr</span></div><div class=\"hint\">Recruiting, interviewing, onboarding, re-training after turnover.</div></div>\n          <div class=\"f\"><label for=\"fix\">Accountant fees to review and fix errors</label><div class=\"in\"><span>$</span><input type=\"number\" id=\"fix\" min=\"0\"><span>/yr</span></div></div>\n        </div>\n      </div>\n      <div class=\"src\" id=\"src\"></div>\n    </main>\n\n    <aside class=\"panel rail\" aria-label=\"Results\">\n      <div>\n        <div class=\"lbl\">True monthly cost</div>\n        <div class=\"big\" id=\"total\">$0</div>\n        <div class=\"sub\" id=\"totalSub\"></div>\n      </div>\n      <div class=\"kpis\">\n        <div class=\"kpi\"><b id=\"annual\">$0</b><span>per year</span></div>\n        <div class=\"kpi\"><b id=\"perHr\">$0</b><span>per hour actually worked</span></div>\n        <div class=\"kpi\"><b id=\"mult\">0×</b><span>true cost vs. stated wage</span></div>\n        <div class=\"kpi\"><b id=\"hidden\">$0</b><span>hidden cost per month</span></div>\n      </div>\n      <div class=\"bars\" id=\"bars\"></div>\n      <div class=\"legend\"><span>On the paycheck</span><span class=\"h\">Hidden costs</span></div>\n      <div class=\"prop\">\n        <div class=\"lbl\">Your proposal starting point</div>\n        <label for=\"save\" class=\"row\"><span>Client saves</span><b id=\"saveLbl\">30%</b></label>\n        <input type=\"range\" id=\"save\" min=\"10\" max=\"60\" step=\"1\" value=\"30\">\n        <div class=\"row\"><span>Suggested monthly fee</span><b id=\"fee\" style=\"color:var(--gold);font-size:18px\">$0</b></div>\n        <div class=\"row\"><span>Client keeps</span><b id=\"keeps\">$0 /yr</b></div>\n      </div>\n      <button class=\"btn teal\" type=\"button\" id=\"copy\">Copy the breakdown</button>\n      <button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button>\n      <div class=\"toast\" id=\"toast\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n\n  <div class=\"lower\">\n    <section class=\"panel card\">\n      <h3 id=\"bdTitle\">Monthly breakdown to show the client</h3>\n      <table class=\"cmp\" id=\"cmp\"></table>\n    </section>\n    <section class=\"panel card\">\n      <h3>Other issues to raise when they weigh outsourcing</h3>\n      <div class=\"issues\" id=\"issues\"></div>\n      <div class=\"quote\"><b>From the book:</b> the college's owner balked at a $5,000 proposal. Then the firm showed him his real cost from his own numbers, $7,555 a month. He signed immediately. The firm's own cost to deliver was $829.95 a month. Price that gap in Homework 3.</div>\n    </section>\n  </div>\n  <div class=\"foot\">From Scorekeeper to Strategist · Session 2: Clients &amp; Pricing · Beyond Numbers · 2026 presets use BLS May 2025 median wages and the KFF 2025 employer health survey. Replace them with your client's actual figures.</div>\n</div>\n<textarea class=\"copybox\" id=\"copybox\" aria-hidden=\"true\" tabindex=\"-1\"></textarea>\n\n<script>\n(function(){\nconst PRESETS={\n ex1:{name:\"Book Example 1 · Non-profit college, Los Angeles\",wage:25,hours:35,health:300,vac:0,ptax:15,ben:5,ovh:12,lease:12500,sqft:10000,sqbk:1000,mgmt:2,mrate:100,hire:10,fix:600,save:34,\n   src:\"Example 1 from Step 6: Pricing. The book's total is $7,555; the firm proposed $5,000.\"},\n ex3:{name:\"Book Example 3 · Restaurant, area average from Indeed\",wage:23,hours:35,health:300,vac:0,ptax:15,ben:5,ovh:12,lease:5000,sqft:4000,sqbk:200,mgmt:2,mrate:100,hire:10,fix:800,save:30,\n   src:\"Example 3 from Step 6: Pricing (book total $6,171). Space is set to reproduce the book's $250 a month.\"},\n bk26:{name:\"2026 · Bookkeeper (US median)\",wage:24.36,hours:40,health:650,vac:2,ptax:10,ben:4,ovh:12,lease:4000,sqft:2500,sqbk:120,mgmt:2,mrate:100,hire:20,fix:1200,save:30,\n   src:'Wage: BLS median for bookkeeping, accounting and auditing clerks, $24.36/hr (May 2025). Health: KFF 2025, employer share of single coverage ≈ $7,885/yr. Other figures are planning estimates.'},\n fc26:{name:\"2026 · Full-charge bookkeeper / staff accountant (US median)\",wage:40.23,hours:40,health:650,vac:2,ptax:10,ben:4,ovh:12,lease:4000,sqft:2500,sqbk:120,mgmt:1.5,mrate:100,hire:30,fix:800,save:30,\n   src:'Wage: BLS median for accountants and auditors, $40.23/hr (May 2025). Health: KFF 2025 employer share of single coverage. Other figures are planning estimates.'},\n cfo26:{name:\"2026 · Controller / in-house CFO (US median)\",wage:80.08,hours:40,health:650,vac:3,ptax:9,ben:6,ovh:10,lease:4000,sqft:2500,sqbk:150,mgmt:1,mrate:150,hire:60,fix:0,save:40,\n   src:'Wage: BLS median for financial managers, $80.08/hr (May 2025). Payroll tax is lower because Social Security stops at the wage base. Other figures are planning estimates.'},\n blank:{name:\"Blank · enter your client's numbers\",wage:0,hours:40,health:0,vac:2,ptax:10,ben:0,ovh:12,lease:0,sqft:0,sqbk:0,mgmt:2,mrate:100,hire:10,fix:0,save:30,src:\"Enter your prospect's actual figures. Pull wages and benefits from their payroll reports.\"}\n};\nconst IDS=[\"wage\",\"hours\",\"health\",\"vac\",\"ptax\",\"ben\",\"ovh\",\"lease\",\"sqft\",\"sqbk\",\"mgmt\",\"mrate\",\"hire\",\"fix\"];\nconst KEY=\"bn-true-cost-v1\";\nconst $=id=>document.getElementById(id);\nconst money=n=>\"$\"+Math.round(n).toLocaleString(\"en-US\");\nconst money2=n=>\"$\"+n.toLocaleString(\"en-US\",{minimumFractionDigits:2,maximumFractionDigits:2});\nlet state;\nconst IDEALKEY=\"bn-ideal-clients\", BYCLIENT=\"bn-true-cost-by-client\", RESULTS=\"bn-true-cost-results\";\nconst csel=$(\"clientSel\");\nfunction getJ(k,d){try{const r=localStorage.getItem(k);return r?JSON.parse(r):d;}catch(e){return d;}}\nfunction setJ(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}\nfunction renderClients(){\n  const list=getJ(IDEALKEY,[]);\n  const names=list.map(c=>c.name);\n  if(state.client&&!names.includes(state.client)) list.push({name:state.client,industry:\"\",fee:0,old:true});\n  csel.innerHTML='<option value=\"\">A book example or a prospect</option>'+list.map(c=>`<option value=\"${c.name.replace(/\"/g,\"&quot;\")}\">${c.old?\"\":\"IDEAL · \"}${c.name.replace(/</g,\"&lt;\")}${c.industry?\" · \"+c.industry.replace(/</g,\"&lt;\"):\"\"}</option>`).join(\"\")+(list.length?\"\":'<option value=\"\" disabled>Choose IDEAL clients in Homework 1</option>');\n  csel.value=state.client||\"\";\n}\ncsel.addEventListener(\"change\",()=>{\n  const by=getJ(BYCLIENT,{});\n  if(state.client) by[state.client]=state;\n  const name=csel.value;\n  if(name&&by[name]) state=by[name];\n  else if(name) state=Object.assign({preset:\"bk26\",client:name},PRESETS.bk26);\n  else state=Object.assign({preset:\"ex1\",client:\"\"},PRESETS.ex1);\n  state.client=name; setJ(BYCLIENT,by); apply();\n});\n\nconst sel=$(\"preset\");\nsel.innerHTML=Object.entries(PRESETS).map(([k,p])=>`<option value=\"${k}\">${p.name}</option>`).join(\"\")+'<option value=\"mine\" hidden>My numbers</option>';\n\nfunction load(){try{const r=localStorage.getItem(KEY);if(r)return JSON.parse(r);}catch(e){}return Object.assign({preset:\"ex1\"},PRESETS.ex1);}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}}\nfunction apply(){\n  IDS.forEach(id=>$(id).value=state[id]);\n  $(\"save\").value=state.save||30;\n  sel.value=state.preset||\"mine\";\n  $(\"src\").textContent=(state.client?`Pricing for ${state.client}. `:\"\")+(PRESETS[state.preset]?PRESETS[state.preset].src:\"Your own figures.\");\n  renderClients();\n  calc();\n}\nfunction v(id){const x=parseFloat(state[id]);return isFinite(x)?x:0;}\n\nfunction compute(){\n  const salary=v(\"wage\")*v(\"hours\")*52/12;\n  const space=v(\"sqft\")>0?v(\"lease\")*v(\"sqbk\")/v(\"sqft\"):0;\n  const items=[\n   [\"Monthly salary\",salary,false],\n   [\"Health insurance\",v(\"health\"),false],\n   [\"Benefits\",salary*v(\"ben\")/100,false],\n   [\"Payroll taxes & workers' comp\",salary*v(\"ptax\")/100,true],\n   [\"Vacation coverage\",v(\"wage\")*v(\"hours\")*v(\"vac\")/12,true],\n   [\"Overhead\",salary*v(\"ovh\")/100,true],\n   [\"Office space\",space,true],\n   [\"Owner's time to manage\",v(\"mgmt\")*52*v(\"mrate\")/12,true],\n   [\"Hiring & training\",v(\"hire\")*v(\"mrate\")/12,true],\n   [\"Fees to fix errors\",v(\"fix\")/12,true]\n  ];\n  const total=items.reduce((a,b)=>a+b[1],0);\n  return {items,total,salary,space};\n}\nfunction calc(){\n  const r=compute(), t=r.total;\n  $(\"spaceLine\").textContent=v(\"sqft\")>0?`${v(\"sqbk\").toLocaleString()} of ${v(\"sqft\").toLocaleString()} sq ft = ${(v(\"sqbk\")/v(\"sqft\")*100).toFixed(1)}% of ${money(v(\"lease\"))} = ${money2(r.space)} a month`:\"Enter total space to calculate the share.\";\n  $(\"total\").textContent=money(t);\n  $(\"totalSub\").textContent=`${state.client?state.client+\" · \":\"\"}vs. ${money(r.salary)} the client thinks it costs`;\n  $(\"bdTitle\").textContent=state.client?`Monthly breakdown to show ${state.client}`:\"Monthly breakdown to show the client\";\n  $(\"annual\").textContent=money(t*12);\n  const worked=v(\"hours\")*(52-v(\"vac\"));\n  $(\"perHr\").textContent=worked>0?money2(t*12/worked):\"$0\";\n  $(\"mult\").textContent=v(\"wage\")>0&&worked>0?(t*12/worked/v(\"wage\")).toFixed(2)+\"×\":\"–\";\n  const hid=r.items.filter(x=>x[2]).reduce((a,b)=>a+b[1],0);\n  $(\"hidden\").textContent=money(hid);\n  const max=Math.max(...r.items.map(x=>x[1]),1);\n  $(\"bars\").innerHTML=r.items.filter(x=>x[1]>0).map(x=>`<div class=\"bar\"><span>${x[0]}</span><i class=\"${x[2]?\"hid\":\"\"}\" style=\"width:${Math.max(2,x[1]/max*100)}%\"></i><em>${money(x[1])}</em></div>`).join(\"\");\n  const s=+$(\"save\").value; state.save=s;\n  const fee=Math.round(t*(1-s/100)/50)*50;\n  $(\"saveLbl\").textContent=s+\"%\"; $(\"fee\").textContent=money(fee); $(\"keeps\").textContent=money((t-fee)*12)+\" /yr\";\n  $(\"cmp\").innerHTML=r.items.map(x=>`<tr><td>${x[0]}</td><td>${money2(x[1])}</td></tr>`).join(\"\")+`<tr class=\"tot\"><td>Client's total monthly cost</td><td>${money2(t)}</td></tr>`;\n  setJ(\"bn-true-cost-result\",{total:t,fee,client:state.client||\"\",label:state.client||(PRESETS[state.preset]?PRESETS[state.preset].name:\"My numbers\"),at:Date.now()});\n  if(state.client){const res=getJ(RESULTS,{});res[state.client]={total:t,fee,at:Date.now()};setJ(RESULTS,res);const by=getJ(BYCLIENT,{});by[state.client]=state;setJ(BYCLIENT,by);}\n  save();\n}\nIDS.forEach(id=>$(id).addEventListener(\"input\",()=>{state[id]=$(id).value;state.preset=\"mine\";sel.value=\"mine\";$(\"src\").textContent=\"Your own figures.\";calc();}));\n$(\"save\").addEventListener(\"input\",calc);\nsel.addEventListener(\"change\",()=>{const p=PRESETS[sel.value];if(!p)return;state=Object.assign({preset:sel.value,client:state.client||\"\"},p);apply();});\n\nconst ISSUES=[\"One person holds all the knowledge. What happens when they quit or get sick?\",\"No segregation of duties: the same person enters, pays and reconciles.\",\"Books run weeks or months behind, so decisions are made on old numbers.\",\"No backup during vacations, busy season or turnover.\",\"Software and app skills fall behind; nobody is paid to keep up.\",\"The owner spends evenings reviewing work instead of growing the business.\"];\n$(\"issues\").innerHTML=ISSUES.map((t,i)=>`<label for=\"is${i}\"><input type=\"checkbox\" id=\"is${i}\">${t}</label>`).join(\"\");\n\nasync function copy(){\n  const r=compute(),L=[`TRUE COST OF IN-HOUSE ${/CFO|Controller/.test(sel.options[sel.selectedIndex].text)?\"FINANCE ROLE\":\"BOOKKEEPER\"}${state.client?\" — \"+state.client:\"\"}`,\"\"];\n  r.items.forEach(x=>L.push(`${x[0]}: ${money2(x[1])}`));\n  L.push(\"\",`Total monthly cost: ${money2(r.total)}`,`Annual: ${money(r.total*12)}`,`Suggested monthly fee (client saves ${$(\"save\").value}%): ${$(\"fee\").textContent}`);\n  const checked=[...document.querySelectorAll(\"#issues input:checked\")].map(c=>\"- \"+c.parentElement.textContent);\n  if(checked.length)L.push(\"\",\"Other issues:\",...checked);\n  const txt=L.join(\"\\n\");\n  try{await navigator.clipboard.writeText(txt);toast(\"Copied. Paste it into your proposal.\");}\n  catch(e){const b=$(\"copybox\");b.value=txt;b.select();try{document.execCommand(\"copy\");toast(\"Copied. Paste it into your proposal.\");}catch(_){toast(\"Copy is blocked here. Use the breakdown table instead.\");}}\n}\nfunction toast(m){$(\"toast\").textContent=m;setTimeout(()=>$(\"toast\").textContent=\"\",3500);}\n$(\"copy\").onclick=copy;\n\nstate=load(); apply();\n})();\n</script>\n\n</body>\n</html>\n"
  },
  "source": "Step 6: Pricing (BOS method); BOLCALC and BOS Time Budget Proposal Worksheet"
}