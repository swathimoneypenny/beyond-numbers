{
  "schemaVersion": "1.0",
  "id": "s1-hw3-52-card-team-pickup",
  "session": 1,
  "exercise": 3,
  "title": "52-Card Team Pickup",
  "type": "worksheet-tool",
  "summary": "Homework 3 for Session 1 (Your Vision, Your Team). Three steps: deal your hand from a 52-card deck of common CAS tasks (13 per role, shuffled so the roles aren't given away), plus your own cards and the YELLOW and RED services pulled from the Traffic Light assessment (Homework 1); sort each card with hours per week, who holds it today (me, team, nobody) and the role that should own it (BOS, Admin orchestrator, Business analyst, Technical team); then find the bottleneck: hours on your plate that belong to another role, roles nobody holds, a suggested next-hire role and the first three cards to hand off, plus a comparison with a typical firm's sort. Opens on a sample firm; autosaves in the browser; passes the next-hire role to the Team Purpose Map (Homework 4); copy-as-text and print.",
  "interactive": true,
  "homework": true,
  "source": "Beyond Numbers four-role team model (BOS, Admin orchestrator, Business analyst, Technical team); original 52-Card Team Pickup exercise",
  "sharedStorageKeys": {
    "reads": [
      "bn-traffic-light"
    ],
    "writes": [
      "bn-team-pickup"
    ]
  },
  "brand": {
    "indigo": "#667EEA",
    "purple": "#764BA2",
    "deep": "#44337A",
    "gold": "#E6B450",
    "teal": "#4ECDC4",
    "gradient": [
      "#667EEA",
      "#764BA2"
    ],
    "font": "Calibri"
  },
  "embed": {
    "format": "html",
    "selfContained": true,
    "markup": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>52-Card Team Pickup</title>\n<style>\n/* Layout: brand gradient field, white working panel with three step tabs, sticky \"hand\" rail on wide screens.\n   Each of the four roles is a card suit: BOS ♠, Admin ♥, Analyst ♦, Technical ♣. 52 starter cards, 13 per suit. */\n:root{\n  --indigo:#667EEA; --purple:#764BA2; --deep:#44337A; --gold:#E6B450; --goldInk:#7B5A12;\n  --teal:#4ECDC4; --tealInk:#1F6F69; --coral:#C53030; --coralBg:#FDECEC; --green:#2F855A; --greenBg:#E8F6EE;\n  --ink:#2D3748; --mute:#6B7280; --line:#E4E1F2; --card:#F7F6FC; --white:#FFFFFF;\n  --bos:#44337A; --admin:#C2416B; --analyst:#2B6CB0; --tech:#1F6F69;\n  --f-body:\"Calibri\",\"Carlito\",\"Segoe UI\",system-ui,sans-serif;\n  color-scheme: light;\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nbody{margin:0;font-family:var(--f-body);font-size:15px;line-height:1.5;color:var(--ink);\n  background:linear-gradient(135deg,var(--indigo) 0%,var(--purple) 100%);background-color:var(--purple);min-height:100vh}\n.wrap{max-width:1280px;margin:0 auto;padding-block:20px 28px;\n  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));\n  display:flex;flex-direction:column;gap:16px}\nheader.top{color:var(--white);display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}\n.eyebrow{font-size:12px;font-weight:700;letter-spacing:.22em;color:var(--gold);text-transform:uppercase}\nh1{font-size:clamp(26px,4vw,36px);line-height:1.1;margin:6px 0;text-wrap:balance}\nheader.top p{margin:0;max-width:64ch;opacity:.92}\n.sample{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);\n  border-radius:12px;padding:10px 14px;color:var(--white);font-size:13.5px}\n.sample b{color:var(--gold)}\nbutton{font-family:inherit;cursor:pointer}\n.btn{border:none;border-radius:999px;padding:8px 16px;font-weight:700;font-size:13.5px}\n.btn:focus-visible,.tab:focus-visible,.seg button:focus-visible,.pc:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--gold);outline-offset:2px}\n.btn.light{background:var(--white);color:var(--deep)}\n.btn.ghost{background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,.7)}\n.btn.primary{background:var(--purple);color:var(--white)}\n.btn.teal{background:var(--teal);color:#0E4A45}\n.btn.soft{background:var(--card);color:var(--deep);border:1.5px solid var(--line)}\n.btn.danger{background:transparent;color:#FFD6D6;border:1.5px solid rgba(255,214,214,.5)}\n.btn.sm{padding:5px 12px;font-size:12.5px}\n.grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px;align-items:start}\n.panel{background:var(--white);border-radius:16px;box-shadow:0 12px 32px rgba(40,25,90,.22);min-width:0}\n.tabs{display:flex;flex-wrap:wrap;gap:4px;padding:10px;border-bottom:1px solid var(--line)}\n.tab{border:none;background:transparent;border-radius:10px;padding:8px 12px;font-weight:700;color:var(--mute);font-size:14px;display:flex;gap:8px;align-items:center}\n.tab .n{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;background:var(--card);color:var(--deep);font-size:12px}\n.tab[aria-selected=\"true\"]{background:var(--card);color:var(--deep)}\n.tab[aria-selected=\"true\"] .n{background:var(--purple);color:var(--white)}\n.tab.done .n{background:var(--green);color:var(--white)}\n.step{padding:22px 24px 26px;display:flex;flex-direction:column;gap:16px}\n.step h2{margin:0;font-size:22px;color:var(--purple);text-wrap:balance}\n.lead{margin:-8px 0 0;color:var(--mute);font-style:italic;max-width:72ch}\n.callout{background:var(--card);border-radius:12px;padding:12px 14px;font-size:13.5px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n.callout b{color:var(--deep)}\nlabel,.lbl{font-weight:700;font-size:13.5px;color:var(--ink)}\n.hint{font-size:12.5px;color:var(--mute);font-weight:400}\ninput[type=text],input[type=number],textarea,select{width:100%;font:inherit;color:var(--ink);background:var(--white);\n  border:1.5px solid var(--line);border-radius:10px;padding:8px 10px}\ninput:focus,textarea:focus,select:focus{border-color:var(--purple);outline:none}\n.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between}\n.addrow{display:flex;gap:8px;flex:1;min-width:240px}\n.addrow input{flex:1}\n/* playing cards */\n.deck{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}\n.pc{position:relative;border:1.5px solid var(--line);border-radius:12px;background:var(--white);padding:10px 12px 12px;min-height:86px;text-align:left;\n  font-size:13.5px;font-weight:700;color:var(--ink);display:flex;flex-direction:column;justify-content:space-between;gap:6px;transition:transform .12s,box-shadow .12s}\n.pc:hover{transform:translateY(-2px);box-shadow:0 6px 14px rgba(40,25,90,.12)}\n.pc .corner{font-size:11.5px;color:var(--mute);font-weight:700;letter-spacing:.06em}\n.pc[aria-pressed=\"true\"]{border-color:var(--purple);background:#F4EEFB;box-shadow:inset 0 0 0 1.5px var(--purple)}\n.pc[aria-pressed=\"true\"] .corner{color:var(--purple)}\n.pc .src{font-size:11px;font-weight:700;color:var(--goldInk);background:#FBF1DC;border-radius:999px;padding:1px 8px;align-self:flex-start}\n/* sort rows */\n.buckets{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;position:sticky;top:0;z-index:2;background:var(--white);padding:4px 0 8px}\n.bk{border-radius:12px;padding:8px 10px;color:#fff}\n.bk .s{font-size:18px;line-height:1}\n.bk b{display:block;font-size:13.5px}\n.bk span{font-size:12px;opacity:.92;font-variant-numeric:tabular-nums}\n.r-bos{background:var(--bos)}.r-admin{background:var(--admin)}.r-analyst{background:var(--analyst)}.r-tech{background:var(--tech)}\n.rows{display:flex;flex-direction:column;gap:8px}\n.row{border:1.5px solid var(--line);border-radius:12px;padding:10px 12px;display:grid;grid-template-columns:minmax(0,1fr) 74px auto auto;gap:8px 12px;align-items:center}\n.row .nm{font-weight:700;color:var(--deep);line-height:1.25}\n.row .nm small{display:block;font-weight:400;color:var(--mute);font-size:12px}\n.row input.hrs{padding:6px 8px;text-align:right;font-variant-numeric:tabular-nums}\n.row.sorted{border-left:5px solid var(--line)}\n.row.sb-bos{border-left-color:var(--bos)}.row.sb-admin{border-left-color:var(--admin)}.row.sb-analyst{border-left-color:var(--analyst)}.row.sb-tech{border-left-color:var(--tech)}\n.seg{display:inline-flex;border:1.5px solid var(--line);border-radius:999px;overflow:hidden}\n.seg button{border:none;background:var(--white);color:var(--mute);font-size:12.5px;font-weight:700;padding:6px 10px;white-space:nowrap}\n.seg button+button{border-left:1.5px solid var(--line)}\n.seg.today button[aria-pressed=\"true\"]{background:var(--purple);color:#fff}\n.seg.role button[aria-pressed=\"true\"][data-v=\"bos\"]{background:var(--bos);color:#fff}\n.seg.role button[aria-pressed=\"true\"][data-v=\"admin\"]{background:var(--admin);color:#fff}\n.seg.role button[aria-pressed=\"true\"][data-v=\"analyst\"]{background:var(--analyst);color:#fff}\n.seg.role button[aria-pressed=\"true\"][data-v=\"tech\"]{background:var(--tech);color:#fff}\n.colh{display:grid;grid-template-columns:minmax(0,1fr) 74px auto auto;gap:12px;font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);padding:0 12px}\n.empty{font-size:13.5px;color:var(--mute);font-style:italic}\n/* bottleneck */\n.fields{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}\n.field{display:flex;flex-direction:column;gap:5px;min-width:0}\n.bars{display:flex;flex-direction:column;gap:12px}\n.bar .top{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;flex-wrap:wrap}\n.bar .top b{color:var(--deep)}\n.bar .top span{color:var(--mute);font-variant-numeric:tabular-nums}\n.track{height:16px;border-radius:999px;background:var(--card);overflow:hidden;display:flex}\n.track i{display:block;height:100%}\n.track i.me{opacity:1}.track i.none{opacity:.45}\n.flag{font-size:11.5px;font-weight:700;border-radius:999px;padding:1px 8px;background:var(--coralBg);color:var(--coral);margin-left:6px}\n.key{display:flex;gap:14px;font-size:12.5px;color:var(--mute);flex-wrap:wrap}\n.key i{display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--purple);vertical-align:-1px;margin-right:4px}\n.key i.none{opacity:.45}\n.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n.st{border-radius:12px;padding:12px;background:var(--card)}\n.st .n{font-size:28px;font-weight:800;color:var(--purple);font-variant-numeric:tabular-nums;line-height:1.1}\n.st .l{font-size:12.5px;color:var(--mute)}\n.st.bad{background:var(--coralBg)}.st.bad .n{color:var(--coral)}\n.poster{border-radius:16px;padding:20px 22px;color:var(--white);background:linear-gradient(135deg,var(--purple),var(--deep));display:flex;flex-direction:column;gap:10px}\n.poster .eyebrow{color:var(--teal)}\n.poster h3{font-size:clamp(22px,3.2vw,30px);line-height:1.15;margin:0;text-wrap:balance}\n.poster p{margin:0;opacity:.92}\n.poster select{max-width:320px}\n.diff{display:flex;flex-direction:column;gap:6px}\n.diff div{font-size:13.5px;padding:7px 10px;border-radius:10px;background:var(--card)}\n.diff b{color:var(--deep)}\n.nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;padding-top:4px}\n/* rail */\n.rail{position:sticky;top:calc(env(safe-area-inset-top,0px) + 16px);padding:18px;display:flex;flex-direction:column;gap:14px;\n  background:linear-gradient(165deg,var(--deep),#2E2457);color:var(--white)}\n.rail h3{margin:0;font-size:16px;letter-spacing:.04em}\n.rrow{display:flex;justify-content:space-between;gap:10px;font-size:13.5px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.14)}\n.rrow b{color:var(--teal);font-variant-numeric:tabular-nums;text-align:right}\n.rrow b.no{color:#C9BEF2;font-weight:400;font-style:italic}\n.tip{background:rgba(230,180,80,.16);border-radius:12px;padding:12px;font-size:13px}\n.tip .t{font-weight:700;color:var(--gold);margin-bottom:4px}\n.rail .btn{width:100%}\n.confirm{background:rgba(255,255,255,.1);border-radius:12px;padding:10px;font-size:13px;display:flex;flex-direction:column;gap:8px}\n.confirm div{display:flex;gap:8px}\n.toast{font-size:12.5px;color:var(--teal);min-height:18px;text-align:center}\n.foot{color:rgba(255,255,255,.85);font-size:12px;text-align:center}\n@media (max-width:1000px){.grid{grid-template-columns:minmax(0,1fr)}.rail{position:static}}\n@media (max-width:760px){\n  .buckets{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .row{grid-template-columns:minmax(0,1fr) 74px}\n  .row .seg{grid-column:1/-1;width:100%}.row .seg button{flex:1;padding:7px 4px}\n  .colh{display:none}\n  .fields{grid-template-columns:repeat(2,minmax(0,1fr))}\n  .stats{grid-template-columns:minmax(0,1fr)}\n  .step{padding:18px 16px 22px}\n  .tab .lbltxt{display:none}\n  .deck{grid-template-columns:repeat(2,minmax(0,1fr))}\n}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n@media print{\n  .step[hidden]{display:flex!important}\n  .tabs,.nav,.toolbar,.sample{display:none!important}\n  .buckets{position:static}\n  .step{break-before:page}.step:first-of-type{break-before:auto}\n  .row,.pc{break-inside:avoid}\n  .bk,.track i,.poster,.seg button[aria-pressed=\"true\"],.pc[aria-pressed=\"true\"]{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n@media print{\n  body{background:#fff!important}\n  .presets,.sample,.btn,.toast,.foot,.del{display:none!important}\n  .grid,.lower{grid-template-columns:1fr 1fr}\n  .panel{box-shadow:none;border:1px solid #ddd}\n  header.top{color:#44337A}\n  .rail{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n}\n</style>\n\n<style id=\"bn-restyle\">\n/* ============================================================\n   bn-restyle v2 · BOLD visual refresh. Appearance only. Appended\n   last in <head>. No transform/filter/backdrop-filter/will-change\n   on body or any tall/large container; big surfaces animate via\n   opacity / background-position / box-shadow only. Small transient\n   transforms live only on button/chip hover+press. Dark text on\n   light surfaces preserved. Motion gated by prefers-reduced-motion.\n   ============================================================ */\n@media screen {\n  :root {\n    --ink:#1b2130;                      /* deeper body text: max contrast */\n    --bnE:cubic-bezier(.22,.9,.3,1);\n    --bnCard:0 2px 4px rgba(26,14,54,.10), 0 20px 44px -18px rgba(52,22,92,.50), 0 44px 90px -46px rgba(34,14,70,.60);\n    --bnLift:0 18px 38px -14px rgba(44,18,86,.58), 0 4px 12px -6px rgba(44,18,86,.30);\n    --bnGradPrimary:linear-gradient(135deg,#8E6BE6 0%,#6C45C0 54%,#4A2C94 100%);\n    --bnGradTeal:linear-gradient(135deg,#6BE8DF 0%,#2FBBB0 100%);\n    --bnGradGold:linear-gradient(135deg,#FFDE8A 0%,#E6B450 100%);\n    --bnGradHead:linear-gradient(100deg,#FFE3A8 0%,#FFFFFF 46%,#8FE9E1 100%);\n  }\n  /* ---- Dramatic multi-stop field + big soft glow accents ---- */\n  body {\n    background-color:#20143E !important;\n    background-image:\n      radial-gradient(1000px 560px at 4% -10%, rgba(126,140,255,.42), transparent 60%),\n      radial-gradient(880px 560px at 118% 2%, rgba(188,120,236,.40), transparent 58%),\n      radial-gradient(820px 680px at 50% 120%, rgba(78,205,196,.22), transparent 60%),\n      linear-gradient(165deg,#3B2F86 0%,#4B2A7C 30%,#3A1C68 62%,#20143E 100%) !important;\n    background-attachment:scroll !important;\n  }\n  /* ---- Bigger, bolder headings; gradient title on the dark header ---- */\n  h1 { font-weight:800 !important; letter-spacing:-.015em !important;\n       font-size:clamp(29px,4.4vw,42px) !important; }\n  h2 { font-weight:800 !important; }\n  .eyebrow { letter-spacing:.26em !important; font-weight:800 !important; }\n  /* Gradient-text only for the header title (always on the dark field), with a\n     light gradient so contrast stays high; guarded so unsupported browsers keep\n     the solid white title. */\n  @supports ((-webkit-background-clip:text) or (background-clip:text)) {\n    header.top h1, .top h1 {\n      background:var(--bnGradHead);\n      -webkit-background-clip:text; background-clip:text;\n      -webkit-text-fill-color:transparent; color:transparent;\n    }\n  }\n  /* ---- PROMINENT cards: big radius, strong layered shadow, hairline edge ---- */\n  .panel, .card, .rail, .poster, .callout, .scenario, .box5, .tip, .copybox, .sample {\n    border-radius:22px !important;\n  }\n  .panel, .poster {\n    box-shadow:var(--bnCard) !important;\n    border:1px solid rgba(255,255,255,.16) !important;\n  }\n  .card, .qbox, .box, .role, .person, .callout, .tip {\n    box-shadow:0 12px 30px -16px rgba(40,18,80,.5) !important;\n  }\n  /* ---- Compositing-safe transitions (exercise disables these under reduced motion) ---- */\n  .btn, .tab, .lt, .chip, .pill, .svc, .card, .qbox, .box, .role, .person, .rrow,\n  .trow, .star, .starbtn, button, input, select, textarea, a {\n    transition:transform .15s var(--bnE), box-shadow .26s var(--bnE),\n      background-color .22s var(--bnE), border-color .2s var(--bnE), color .16s var(--bnE) !important;\n  }\n  /* ---- BOLD pill buttons: gradient fills, hover lift+scale, press (small elems) ---- */\n  .btn { border-radius:999px !important; font-weight:800 !important; letter-spacing:.01em;\n         box-shadow:0 8px 18px -9px rgba(26,12,58,.55); }\n  .btn:hover  { transform:translateY(-2px) scale(1.03); box-shadow:0 18px 34px -12px rgba(44,18,86,.6); }\n  .btn:active { transform:translateY(0) scale(.955); }\n  .btn:disabled { opacity:.5 !important; transform:none !important; box-shadow:none !important; }\n  .btn.primary { background:var(--bnGradPrimary) !important; color:#fff !important; border:none !important; }\n  .btn.teal    { background:var(--bnGradTeal) !important; color:#06312D !important; border:none !important; }\n  .btn.gold    { background:var(--bnGradGold) !important; color:#3D2C05 !important; border:none !important; }\n  /* ---- Medium cards: shadow-only hover pop (never transform big surfaces) ---- */\n  .card:hover, .qbox:hover, .svc:hover, .role:hover, .person:hover, .rrow:hover, .trow:hover, .pi:hover {\n    box-shadow:var(--bnLift) !important;\n  }\n  /* ---- Inputs: rounded with a strong brand focus ring ---- */\n  input, select, textarea { border-radius:12px !important; }\n  input:focus, select:focus, textarea:focus {\n    border-color:var(--purple) !important;\n    box-shadow:0 0 0 3px rgba(118,75,162,.30) !important; outline:none !important;\n  }\n  /* ---- Modern chips/badges: pill, gradient-ready, glow+scale on hover ---- */\n  .chip, .pill { border-radius:999px !important; font-weight:800 !important;\n                 box-shadow:0 2px 9px -3px rgba(40,18,80,.42); }\n  .chip:hover, .pill:hover { transform:translateY(-1px) scale(1.06);\n                 box-shadow:0 10px 18px -6px rgba(40,18,80,.5); }\n  /* ---- Tabs: bold, gold underline + glow on the active tab ---- */\n  .tab { font-weight:800 !important; }\n  .tab:hover { color:var(--deep) !important; }\n  .tab[aria-selected=\"true\"], .tab.active {\n    color:var(--deep) !important;\n    box-shadow:inset 0 -3px 0 0 var(--gold), 0 8px 20px -8px rgba(230,180,80,.55);\n  }\n  /* ---- Animated meter / progress-bar fills (width only) ---- */\n  .track i, .bar i, .meter i, .bars i, .stack i, .meter > span {\n    transition:width .75s var(--bnE), background-color .3s var(--bnE) !important;\n  }\n}\n/* ============ lively motion — all disabled under reduced motion ============ */\n@media screen and (prefers-reduced-motion: no-preference) {\n  @keyframes bnFade { from { opacity:0; } to { opacity:1; } }\n  @keyframes bnGlow {\n    0%,100% { box-shadow:inset 0 -3px 0 0 var(--gold), 0 8px 18px -10px rgba(230,180,80,.40); }\n    50%     { box-shadow:inset 0 -3px 0 0 var(--gold), 0 12px 28px -8px rgba(230,180,80,.80); }\n  }\n  @keyframes bnSheen {\n    0%   { background-position:0% 50%, 100% 50%, 50% 100%, 0 0; }\n    100% { background-position:26% 42%, 74% 58%, 50% 88%, 0 0; }\n  }\n  /* Entrance = OPACITY fade on CONTAINERS (not re-rendered items → no flicker),\n     lightly staggered. Big surfaces, opacity only — compositing-safe. */\n  .top, header.top, .panel, .rail, .scenario, .poster, .callout, .step {\n    animation:bnFade .6s var(--bnE) both;\n  }\n  .grid > *:nth-child(2)  { animation-delay:.08s; }\n  .grid > *:nth-child(3)  { animation-delay:.16s; }\n  .rail { animation-delay:.14s; }\n  /* Ambient: slow glow drift (background-position only — never transform). */\n  body { animation:bnSheen 30s ease-in-out infinite alternate; }\n  /* Active tab: gentle pulsing glow (box-shadow only). */\n  .tab[aria-selected=\"true\"], .tab.active { animation:bnGlow 2.8s ease-in-out infinite; }\n}\n</style>\n</head>\n<body>\n\n\n<div class=\"wrap\">\n  <header class=\"top\">\n    <div>\n      <div class=\"eyebrow\">Session 1 · Your Vision, Your Team · Homework 3</div>\n      <h1>The 52-Card Team Pickup</h1>\n      <p>Every task in your week is a card. Deal your hand, sort each card to the role that should own it (BOS, Admin, Analyst or Technical), then see which role is buried and which one is missing. That's your next hire.</p>\n    </div>\n    <div class=\"sample\">\n      <span id=\"sampleMsg\"></span>\n      <button class=\"btn light\" type=\"button\" id=\"btnSample\">Load sample</button>\n      <button class=\"btn ghost\" type=\"button\" id=\"btnOwn\">Start my own</button>\n    </div>\n  </header>\n\n  <div class=\"grid\">\n    <main class=\"panel\">\n      <div class=\"tabs\" role=\"tablist\" id=\"tabs\"></div>\n\n      <section class=\"step\" data-step=\"0\">\n        <h2>1 · Deal your hand</h2>\n        <p class=\"lead\">Tap every card that's part of a typical week at your firm. Add anything missing. Don't sort yet; just get it all on the table.</p>\n        <div class=\"callout\" id=\"hwPull\" hidden><span id=\"hwPullTxt\"></span><button class=\"btn primary sm\" type=\"button\" id=\"hwPullBtn\">Add them to my hand</button></div>\n        <div class=\"toolbar\">\n          <form class=\"addrow\" id=\"addForm\"><input type=\"text\" id=\"addName\" placeholder=\"Add your own task, e.g. Chasing W-9s\" aria-label=\"Add your own task\"><button class=\"btn primary\" type=\"submit\">Add card</button></form>\n          <div class=\"seg today\" role=\"group\" aria-label=\"Show\"><button type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All cards</button><button type=\"button\" data-filter=\"on\" aria-pressed=\"false\">My hand</button></div>\n        </div>\n        <div class=\"deck\" id=\"deck\"></div>\n        <div class=\"nav\"><span></span><button class=\"btn primary\" type=\"button\" data-go=\"1\">Next: sort to roles →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"1\" hidden>\n        <h2>2 · Sort to roles</h2>\n        <p class=\"lead\">For each card: about how many hours a week, who holds it today, and which role <i>should</i> own it. Sort by the work, not by who's on payroll.</p>\n        <div class=\"buckets\" id=\"buckets\"></div>\n        <div class=\"colh\"><span>Card</span><span>Hrs/wk</span><span>Who holds it today</span><span>Should own it</span></div>\n        <div class=\"rows\" id=\"rows\"></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"0\">← Deal</button><button class=\"btn primary\" type=\"button\" data-go=\"2\">Next: find the bottleneck →</button></div>\n      </section>\n\n      <section class=\"step\" data-step=\"2\" hidden>\n        <h2>3 · Find the bottleneck</h2>\n        <p class=\"lead\">Tell us your role and who's on the team. The bars show hours on your plate that belong to someone else, and hours nobody holds.</p>\n        <div class=\"fields\">\n          <div class=\"field\"><label for=\"myRole\">My role</label><select id=\"myRole\"></select></div>\n          <div class=\"field\"><label for=\"t_bos\">♠ BOS <span class=\"hint\">people</span></label><input type=\"number\" min=\"0\" step=\"1\" id=\"t_bos\" data-team=\"bos\"></div>\n          <div class=\"field\"><label for=\"t_admin\">♥ Admin <span class=\"hint\">people</span></label><input type=\"number\" min=\"0\" step=\"1\" id=\"t_admin\" data-team=\"admin\"></div>\n          <div class=\"field\"><label for=\"t_analyst\">♦ Analyst <span class=\"hint\">people</span></label><input type=\"number\" min=\"0\" step=\"1\" id=\"t_analyst\" data-team=\"analyst\"></div>\n          <div class=\"field\"><label for=\"t_tech\">♣ Technical <span class=\"hint\">people</span></label><input type=\"number\" min=\"0\" step=\"1\" id=\"t_tech\" data-team=\"tech\"></div>\n        </div>\n        <div class=\"stats\" id=\"stats\"></div>\n        <div class=\"key\"><span><i></i>On your plate</span><span><i class=\"none\"></i>Nobody holds it</span></div>\n        <div class=\"bars\" id=\"bars\"></div>\n        <div class=\"poster\">\n          <div class=\"eyebrow\">Bring this to Session 2</div>\n          <h3 id=\"verdict\"></h3>\n          <p id=\"verdictSub\"></p>\n          <div class=\"field\"><label for=\"nextHire\" style=\"color:#fff\">My next-hire role</label><select id=\"nextHire\"></select></div>\n          <div class=\"field\"><label for=\"why\" style=\"color:#fff\">The first three cards they take off my plate</label><textarea id=\"why\" rows=\"2\"></textarea></div>\n        </div>\n        <div><div class=\"lbl\" style=\"margin-bottom:6px\">Where you sorted differently from a typical firm <span class=\"hint\">· not wrong, just worth a second look</span></div><div class=\"diff\" id=\"diff\"></div></div>\n        <div class=\"nav\"><button class=\"btn soft\" type=\"button\" data-go=\"1\">← Sort</button><span></span></div>\n      </section>\n    </main>\n\n    <aside class=\"panel rail\">\n      <h3>Your hand</h3>\n      <div id=\"railRows\"></div>\n      <div class=\"tip\"><div class=\"t\" id=\"tipT\"></div><div id=\"tipB\"></div></div>\n      <button class=\"btn teal\" type=\"button\" id=\"btnCopy\">Copy summary</button>\n      <button class=\"btn soft\" type=\"button\" onclick=\"window.print()\">Print / Save PDF</button>\n      <button class=\"btn danger\" type=\"button\" id=\"btnReset\">Clear my answers</button>\n      <div class=\"confirm\" id=\"confirmBox\" hidden><span>Clear your whole hand on this device?</span><div><button class=\"btn light\" type=\"button\" id=\"cYes\">Yes, clear</button><button class=\"btn ghost\" type=\"button\" id=\"cNo\">Cancel</button></div></div>\n      <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n    </aside>\n  </div>\n  <div class=\"foot\">Beyond Numbers · From Scorekeeper to Strategist · Your answers stay in this browser. Your next-hire role carries into Homework 4, the Team Purpose Map.</div>\n</div>\n\n<script>\n(function(){\nconst KEY='bn-team-pickup-v1', OUT='bn-team-pickup';\nconst ROLES={bos:{n:'BOS',s:'♠',full:'BOS',tpm:'BOS'},admin:{n:'Admin',s:'♥',full:'Admin orchestrator',tpm:'Admin orchestrator'},\n  analyst:{n:'Analyst',s:'♦',full:'Business analyst',tpm:'Business analyst'},tech:{n:'Technical',s:'♣',full:'Technical team',tpm:'Technical team'}};\nconst RK=['bos','admin','analyst','tech'];\nconst TODAY=[['me','Me'],['team','Team'],['none','Nobody']];\n// 52 cards: 13 per suit. [id, name, typical role]\nconst DECK=[\n ['b1','Client strategy calls','bos'],['b2','Monthly financial review meetings','bos'],['b3','Cash flow forecast conversations','bos'],['b4','Budget vs. actual reviews','bos'],\n ['b5','Pricing & proposals','bos'],['b6','New-client discovery calls','bos'],['b7','Scoping advisory projects','bos'],['b8','KPI reviews with owners','bos'],\n ['b9','Business planning sessions','bos'],['b10','Client escalations','bos'],['b11','Annual engagement renewals','bos'],['b12','Referral partner relationships','bos'],['b13','Scope-change conversations','bos'],\n ['a1','Chasing client documents','admin'],['a2','Scheduling meetings','admin'],['a3','Onboarding paperwork','admin'],['a4','Engagement letters & e-signatures','admin'],\n ['a5','Invoicing & collections','admin'],['a6','Inbox triage','admin'],['a7','Portal invites & access requests','admin'],['a8','Assigning tasks in practice software','admin'],\n ['a9','Meeting notes & follow-ups','admin'],['a10','Due-date tracking','admin'],['a11','New-hire paperwork','admin'],['a12','Collecting W-9s','admin'],['a13','Client reminder emails','admin'],\n ['n1','Evaluating new apps','analyst'],['n2','Software implementations','analyst'],['n3','Fixing bank feeds & integrations','analyst'],['n4','Workflow redesign','analyst'],\n ['n5','Building KPI dashboards','analyst'],['n6','Automation & AI skill building','analyst'],['n7','Tech support for staff','analyst'],['n8','Tech stack cost reviews','analyst'],\n ['n9','Report templates','analyst'],['n10','Data migrations','analyst'],['n11','User access & security reviews','analyst'],['n12','Writing SOPs','analyst'],['n13','Training staff on tools','analyst'],\n ['t1','Bank & card reconciliations','tech'],['t2','Transaction categorization','tech'],['t3','AP processing','tech'],['t4','AR posting & aging cleanup','tech'],\n ['t5','Payroll processing','tech'],['t6','Sales tax filings','tech'],['t7','1099 preparation','tech'],['t8','Month-end close','tech'],\n ['t9','Journal entries & accruals','tech'],['t10','Tax return preparation','tech'],['t11','Fixed asset schedules','tech'],['t12','Financial statement prep','tech'],['t13','Quality review of the close','tech']];\n// fixed shuffle so suits aren't grouped (the point is to sort them yourself)\nconst ORDER=(function(){const a=DECK.map((_,i)=>i);let x=52;for(let i=a.length-1;i>0;i--){x=(x*9301+49297)%233280;const j=Math.floor(x/233280*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;})();\nconst BYID=Object.fromEntries(DECK.map(d=>[d[0],d]));\n\nconst C=(on,hrs,today,should)=>({on,hrs:String(hrs),today,should});\nconst SAMPLE={sample:true,step:0,filter:'all',myRole:'bos',team:{bos:1,admin:0,analyst:0,tech:2},nextHire:'',why:'Chasing documents, scheduling, and portal invites',custom:[{id:'c1',name:'Answering client \"quick questions\" by phone',src:''}],\n cards:{b1:C(1,4,'me','bos'),b2:C(1,3,'me','bos'),b5:C(1,2,'me','bos'),b6:C(1,1.5,'me','bos'),b10:C(1,2,'me','bos'),\n  a1:C(1,5,'me','admin'),a2:C(1,2,'me','admin'),a3:C(1,2,'me','admin'),a5:C(1,3,'me','admin'),a6:C(1,4,'me','admin'),a7:C(1,1,'me','admin'),a10:C(1,1,'none','admin'),a12:C(1,1,'team','admin'),\n  n1:C(1,1.5,'me','analyst'),n3:C(1,2,'me','analyst'),n7:C(1,2,'me','analyst'),n12:C(1,1,'none','analyst'),n6:C(1,1,'none','analyst'),\n  t1:C(1,8,'team','tech'),t2:C(1,6,'team','tech'),t5:C(1,3,'me','tech'),t8:C(1,4,'team','tech'),t10:C(1,3,'me','tech'),t13:C(1,2,'me','tech'),\n  c1:C(1,3,'me','admin')}};\nfunction blank(){return {sample:false,step:0,filter:'all',myRole:'bos',team:{bos:1,admin:0,analyst:0,tech:0},nextHire:'',why:'',custom:[],cards:{}};}\nconst clone=o=>JSON.parse(JSON.stringify(o));\nlet S;\nfunction load(){try{const r=localStorage.getItem(KEY);if(r){const o=JSON.parse(r);if(o&&o.cards)return Object.assign(blank(),o);}}catch(e){}return clone(SAMPLE);}\nfunction save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}publish();}\nS=load();\n\nconst $=id=>document.getElementById(id);\nconst esc=t=>String(t==null?'':t).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst steps=[...document.querySelectorAll('.step')];\nconst TABN=['Deal your hand','Sort to roles','Find the bottleneck'];\nconst nameOf=id=>BYID[id]?BYID[id][1]:((S.custom.find(c=>c.id===id)||{}).name||'');\nconst allIds=()=>[...ORDER.map(i=>DECK[i][0]),...S.custom.map(c=>c.id)];\nconst hand=()=>allIds().filter(id=>S.cards[id]&&S.cards[id].on);\nconst card=id=>S.cards[id]||(S.cards[id]={on:0,hrs:'',today:'me',should:''});\nconst h=id=>Math.max(0,parseFloat(S.cards[id]&&S.cards[id].hrs)||0);\nconst fmt=n=>(Math.round(n*10)/10).toLocaleString();\n\nfunction unsample(){if(S.sample){S.sample=false;renderSample();}}\nfunction renderSample(){$('sampleMsg').innerHTML=S.sample?'<b>Sample firm loaded.</b> Explore it, then start your own.':'<b>Your hand</b> saves in this browser as you go.';$('btnSample').hidden=S.sample;$('btnOwn').textContent=S.sample?'Start my own':'Start over';}\n\nfunction renderDeck(){\n  const ids=allIds().filter(id=>S.filter==='all'||(S.cards[id]&&S.cards[id].on));\n  $('deck').innerHTML=ids.length?ids.map(id=>{const c=S.cards[id],on=!!(c&&c.on),cu=S.custom.find(x=>x.id===id);\n    return '<button type=\"button\" class=\"pc\" data-card=\"'+id+'\" aria-pressed=\"'+on+'\"><span class=\"corner\">'+(on?'✓ IN MY HAND':'TAP TO ADD')+'</span><span>'+esc(nameOf(id))+'</span>'+(cu?'<span class=\"src\">'+(cu.src||'Your card')+'</span>':'')+'</button>';}).join('')\n    :'<div class=\"empty\">No cards in your hand yet. Switch to \"All cards\" and tap the ones in your week.</div>';\n}\nfunction stats(){\n  const ids=hand();const by={};RK.forEach(k=>by[k]={hrs:0,me:0,none:0,team:0,n:0});\n  let my=0,wrong=0,unsorted=0,total=0;\n  ids.forEach(id=>{const c=S.cards[id],hr=h(id);total+=hr;if(c.today==='me')my+=hr;\n    if(!c.should){unsorted++;return;}const b=by[c.should];b.n++;b.hrs+=hr;b[c.today]+=hr;\n    if(c.today==='me'&&c.should!==S.myRole)wrong+=hr;});\n  const team=S.team||{};\n  // next hire: role (not mine) with most hours on my plate + nobody, preferring roles with no people\n  const cand=RK.filter(k=>k!==S.myRole).map(k=>({k,load:by[k].me+by[k].none,empty:(+team[k]||0)===0}))\n    .filter(x=>x.load>0).sort((a,b)=>(b.empty-a.empty)||(b.load-a.load));\n  return {ids,by,my,wrong,unsorted,total,sorted:ids.length-unsorted,suggest:cand[0]||null,cand};\n}\nfunction renderBuckets(st){\n  $('buckets').innerHTML=RK.map(k=>'<div class=\"bk r-'+k+'\"><div class=\"s\">'+ROLES[k].s+'</div><b>'+ROLES[k].n+'</b><span>'+st.by[k].n+' cards · '+fmt(st.by[k].hrs)+' hrs</span></div>').join('');\n}\nfunction renderRows(){\n  const ids=hand().sort((x,y)=>(!!card(x).should)-(!!card(y).should));\n  $('rows').innerHTML=ids.length?ids.map(id=>{const c=card(id);\n    return '<div class=\"row'+(c.should?' sorted sb-'+c.should:'')+'\" data-row=\"'+id+'\"><div class=\"nm\">'+esc(nameOf(id))+'</div>'+\n      '<input type=\"number\" class=\"hrs\" min=\"0\" step=\"0.5\" inputmode=\"decimal\" data-hrs=\"'+id+'\" value=\"'+esc(c.hrs)+'\" aria-label=\"Hours per week for '+esc(nameOf(id))+'\" placeholder=\"hrs\">'+\n      '<div class=\"seg today\" role=\"group\" aria-label=\"Who holds it today\" data-today=\"'+id+'\">'+TODAY.map(([v,l])=>'<button type=\"button\" data-v=\"'+v+'\" aria-pressed=\"'+(c.today===v)+'\">'+l+'</button>').join('')+'</div>'+\n      '<div class=\"seg role\" role=\"group\" aria-label=\"Role that should own it\" data-should=\"'+id+'\">'+RK.map(k=>'<button type=\"button\" data-v=\"'+k+'\" aria-pressed=\"'+(c.should===k)+'\" title=\"'+ROLES[k].full+'\">'+ROLES[k].s+' '+ROLES[k].n+'</button>').join('')+'</div></div>';}).join('')\n    :'<div class=\"empty\">Your hand is empty. Go back to step 1 and deal some cards.</div>';\n}\nfunction renderBottleneck(st){\n  $('myRole').innerHTML=RK.map(k=>'<option value=\"'+k+'\"'+(S.myRole===k?' selected':'')+'>'+ROLES[k].s+' '+ROLES[k].full+'</option>').join('');\n  RK.forEach(k=>{const el=$('t_'+k);if(document.activeElement!==el)el.value=(S.team||{})[k]??'';});\n  const wp=st.my?Math.round(st.wrong/st.my*100):0;\n  $('stats').innerHTML=[[fmt(st.my)+' hrs','On your plate each week',false],[wp+'%','Of your hours belong to another role',wp>=40],[fmt(st.wrong)+' hrs','You could hand off',st.wrong>0]]\n    .map(([n,l,b])=>'<div class=\"st'+(b?' bad':'')+'\"><div class=\"n\">'+n+'</div><div class=\"l\">'+l+'</div></div>').join('');\n  const max=Math.max(1,...RK.map(k=>st.by[k].me+st.by[k].none));\n  const col={bos:'var(--bos)',admin:'var(--admin)',analyst:'var(--analyst)',tech:'var(--tech)'};\n  $('bars').innerHTML=RK.map(k=>{const b=st.by[k],empty=(+(S.team||{})[k]||0)===0,mine=k===S.myRole;\n    return '<div class=\"bar\"><div class=\"top\"><b>'+ROLES[k].s+' '+ROLES[k].full+(mine?' <span class=\"hint\">(your role)</span>':'')+(empty&&!mine&&b.hrs>0?'<span class=\"flag\">No one in this role</span>':'')+'</b><span>'+fmt(b.me)+' hrs on you · '+fmt(b.none)+' hrs unowned</span></div>'+\n      '<div class=\"track\"><i class=\"me\" style=\"width:'+(b.me/max*100)+'%;background:'+col[k]+'\"></i><i class=\"none\" style=\"width:'+(b.none/max*100)+'%;background:'+col[k]+'\"></i></div></div>';}).join('');\n  const sg=st.suggest;\n  if(!st.ids.length){$('verdict').textContent='Deal your hand first.';$('verdictSub').textContent='Pick the cards in your week in step 1, then sort them in step 2.';}\n  else if(st.unsorted){$('verdict').textContent=st.unsorted+' card'+(st.unsorted>1?'s':'')+' still unsorted.';$('verdictSub').textContent='Sort every card in step 2 to see your bottleneck.';}\n  else if(!sg){$('verdict').textContent='No bottleneck showing.';$('verdictSub').textContent='Nothing outside your role is sitting on you. Double-check the \"Who holds it today\" column.';}\n  else{$('verdict').textContent='Your next hire is probably '+(/^[AEIOU]/i.test(ROLES[sg.k].full)?'an ':'a ')+ROLES[sg.k].full+'.';\n    $('verdictSub').textContent=fmt(sg.load)+' hours a week of '+ROLES[sg.k].n+' work sit on you or on nobody'+(sg.empty?', and no one holds that role today.':'.')+(sg.k!=='tech'?' It\\'s usually not another accountant.':'');}\n  $('nextHire').innerHTML='<option value=\"\">Choose a role</option>'+RK.map(k=>'<option value=\"'+k+'\"'+((S.nextHire||(sg?sg.k:''))===k?' selected':'')+'>'+ROLES[k].full+(sg&&sg.k===k?' (suggested)':'')+'</option>').join('');\n  if(document.activeElement!==$('why'))$('why').value=S.why||'';\n  const d=st.ids.filter(id=>BYID[id]&&S.cards[id].should&&S.cards[id].should!==BYID[id][2]);\n  $('diff').innerHTML=d.length?d.map(id=>'<div><b>'+esc(nameOf(id))+'</b>: you chose '+ROLES[S.cards[id].should].n+'; most firms give it to '+ROLES[BYID[id][2]].full+'.</div>').join(''):'<div class=\"empty\" style=\"background:none;padding:0\">'+(st.sorted?'Your sort matches a typical firm.':'Sort some cards first.')+'</div>';\n}\nfunction renderRail(st){\n  const nh=S.nextHire||(st.suggest&&!st.unsorted?st.suggest.k:'');\n  const rows=[['Cards in hand',st.ids.length],['Sorted',st.sorted+' / '+st.ids.length],['Hours on your plate',fmt(st.my)],['Wrong-bucket hours',fmt(st.wrong)],['Next hire',nh?ROLES[nh].full:'']];\n  $('railRows').innerHTML=rows.map(([l,v])=>'<div class=\"rrow\"><span>'+l+'</span><b'+(v===''||v===0?' class=\"no\"':'')+'>'+(v===''?'not yet':v)+'</b></div>').join('');\n  const tips=[['Deal honestly','Include the work you do at 9 PM and on Saturdays. Those cards are usually the first ones to hand off.'],\n    ['Sort by the work','Put each card where it belongs in a firm of 50–75 clients, even if nobody holds that role yet. Empty roles are the point.'],\n    ['The secret weapon','A strong admin can absorb about 40% of professional workload. If the ♥ bar is long, start there.']];\n  $('tipT').textContent=tips[S.step][0];$('tipB').textContent=tips[S.step][1];\n  const done=[st.ids.length>0,st.ids.length>0&&!st.unsorted,!!S.nextHire];\n  [...$('tabs').children].forEach((t,i)=>t.classList.toggle('done',done[i]));\n}\nfunction refresh(){const st=stats();if(S.step===1)renderBuckets(st);if(S.step===2)renderBottleneck(st);renderRail(st);}\nfunction renderTabs(){$('tabs').innerHTML=TABN.map((n,i)=>'<button class=\"tab\" role=\"tab\" type=\"button\" aria-selected=\"'+(S.step===i)+'\" data-go=\"'+i+'\"><span class=\"n\">'+(i+1)+'</span><span class=\"lbltxt\">'+n+'</span></button>').join('');}\nfunction show(i){S.step=i;steps.forEach((s,k)=>s.hidden=k!==i);renderTabs();if(i===0)renderDeck();if(i===1)renderRows();refresh();try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}\nfunction renderAll(){renderSample();document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.filter===S.filter));show(S.step||0);hwPull();}\nfunction toast(t){$('toast').textContent=t;clearTimeout(toast.h);toast.h=setTimeout(()=>$('toast').textContent='',2600);}\n\nfunction publish(){try{const st=stats();const nh=S.nextHire||(st.suggest&&!st.unsorted?st.suggest.k:'');\n  localStorage.setItem(OUT,JSON.stringify({nextHire:nh?ROLES[nh].tpm:'',myHrs:st.my,wrongHrs:st.wrong,wrongPct:st.my?Math.round(st.wrong/st.my*100):0,\n    byRole:Object.fromEntries(RK.map(k=>[ROLES[k].tpm,{cards:st.by[k].n,hrs:st.by[k].hrs}])),at:Date.now()}));}catch(e){}}\n\nfunction hwPull(){\n  let tl=null;try{tl=JSON.parse(localStorage.getItem('bn-traffic-light')||'null');}catch(e){}\n  const items=tl&&tl.items?tl.items.filter(x=>x.light==='yellow'||x.light==='red'):[];\n  const fresh=items.filter(x=>!S.custom.some(c=>c.name.toLowerCase()===String(x.name).toLowerCase()));\n  if(!fresh.length){$('hwPull').hidden=true;return;}\n  $('hwPull').hidden=false;$('hwPullTxt').innerHTML='Found <b>'+fresh.length+' YELLOW and RED services</b> from your Traffic Light assessment (Homework 1).';\n  $('hwPullBtn').onclick=()=>{fresh.forEach(x=>{const id='c'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);\n      S.custom.push({id,name:String(x.name),src:'From Homework 1 · '+x.light.toUpperCase()});\n      S.cards[id]={on:1,hrs:x.pct&&tl.weekHrs?String(Math.round(x.pct*tl.weekHrs/10)/10):'',today:'me',should:''};});\n    unsample();save();renderDeck();refresh();$('hwPull').hidden=true;toast(fresh.length+' cards added to your hand');};\n}\n\ndocument.addEventListener('click',e=>{\n  const go=e.target.closest('[data-go]');if(go){show(+go.dataset.go);if(go.classList.contains('btn'))document.querySelector('main.panel').scrollIntoView({behavior:'smooth',block:'start'});return;}\n  const f=e.target.closest('[data-filter]');if(f){S.filter=f.dataset.filter;document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',b===f));renderDeck();save();return;}\n  const pc=e.target.closest('.pc');if(pc){const c=card(pc.dataset.card);c.on=c.on?0:1;\n    pc.setAttribute('aria-pressed',!!c.on);pc.querySelector('.corner').textContent=c.on?'✓ IN MY HAND':'TAP TO ADD';\n    if(S.filter==='on'&&!c.on)pc.remove();unsample();refresh();save();return;}\n  const b=e.target.closest('.seg button');if(!b)return;const g=b.parentElement;\n  if(g.dataset.today){const c=card(g.dataset.today);c.today=b.dataset.v;}\n  else if(g.dataset.should){const c=card(g.dataset.should);c.should=c.should===b.dataset.v?'':b.dataset.v;const row=g.closest('.row');row.className='row'+(c.should?' sorted sb-'+c.should:'');}\n  else return;\n  const cur=g.dataset.today?card(g.dataset.today).today:card(g.dataset.should).should;\n  [...g.children].forEach(x=>x.setAttribute('aria-pressed',x.dataset.v===cur));\n  unsample();refresh();save();\n});\ndocument.addEventListener('input',e=>{const t=e.target;\n  if(t.dataset.hrs){card(t.dataset.hrs).hrs=t.value;}\n  else if(t.dataset.team){S.team[t.dataset.team]=t.value;}\n  else if(t.id==='why'){S.why=t.value;}\n  else return;\n  unsample();refresh();save();});\ndocument.addEventListener('change',e=>{const t=e.target;\n  if(t.id==='myRole'){S.myRole=t.value;}else if(t.id==='nextHire'){S.nextHire=t.value;}else return;\n  unsample();refresh();save();});\n$('addForm').onsubmit=e=>{e.preventDefault();const v=$('addName').value.trim();if(!v)return;const id='c'+Date.now().toString(36);\n  S.custom.push({id,name:v,src:''});S.cards[id]={on:1,hrs:'',today:'me',should:''};$('addName').value='';unsample();save();renderDeck();refresh();toast('Card added to your hand');};\n$('btnSample').onclick=()=>{S=clone(SAMPLE);save();renderAll();toast('Sample firm loaded');};\n$('btnOwn').onclick=()=>{S=blank();save();renderAll();toast('Fresh deck ready');};\n$('btnReset').onclick=()=>{$('confirmBox').hidden=false;};\n$('cNo').onclick=()=>{$('confirmBox').hidden=true;};\n$('cYes').onclick=()=>{S=blank();save();renderAll();$('confirmBox').hidden=true;toast('Cleared');};\n\nfunction summary(){const st=stats();const nh=S.nextHire||(st.suggest&&!st.unsorted?st.suggest.k:'');\n  const L=['52-CARD TEAM PICKUP','My role: '+ROLES[S.myRole].full+'   Team: '+RK.map(k=>ROLES[k].n+' '+((S.team||{})[k]||0)).join(', '),\n    'Hours on my plate: '+fmt(st.my)+'   Belong to another role: '+fmt(st.wrong)+' ('+(st.my?Math.round(st.wrong/st.my*100):0)+'%)','NEXT HIRE: '+(nh?ROLES[nh].full:'not chosen'),(S.why?'First cards to hand off: '+S.why:''),''];\n  RK.forEach(k=>{const ids=st.ids.filter(id=>S.cards[id].should===k);if(!ids.length)return;\n    L.push(ROLES[k].s+' '+ROLES[k].full.toUpperCase()+' ('+fmt(st.by[k].hrs)+' hrs)');\n    ids.forEach(id=>{const c=S.cards[id];L.push('  - '+nameOf(id)+(h(id)?' · '+fmt(h(id))+' hrs':'')+' · today: '+({me:'me',team:'team',none:'nobody'}[c.today]));});L.push('');});\n  return L.filter((x,i)=>x!==''||i>4).join('\\n');}\n$('btnCopy').onclick=()=>{const t=summary();\n  const fb=()=>{const ta=document.createElement('textarea');ta.value=t;ta.style.position='absolute';ta.style.left='-9999px';document.body.appendChild(ta);ta.select();let ok=false;try{ok=document.execCommand('copy');}catch(e){}ta.remove();toast(ok?'Summary copied':'Copy blocked; use Print instead');};\n  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(()=>toast('Summary copied'),fb);else fb();};\nwindow.addEventListener('beforeprint',()=>{renderDeck();renderRows();const st=stats();renderBuckets(st);renderBottleneck(st);});\nrenderAll();save();\n})();\n</script>\n\n</body>\n</html>\n"
  }
}
